index 0000000000000000000000000000000000000000..5809c3977bba06cdc9a85c7fd8dd308bde9c3ce7
--- /dev/null
+++ b/tools/crates/design-read/src/main.rs
@@ -0,0 +1,121 @@
+//! Checks a design read's shape and that it carries forward what the previous read left open.
+//!
+//! ```text
+//! design-read check <file>
+//! ```
+//!
+//! A design read is one Markdown file in the shape of `templates/DESIGN-READ.md`. The tool reads only its header
+//! fields, the presence of its "After the last phase" section and its disagreements table ([`read`]); every other
+//! section is prose for people. When the header names a previous read, the tool reads that read's table too and
+//! compares the two ([`carry`]): an ID is `new` exactly when the previous read lacks it, and every ID the previous read
+//! left unresolved appears again. It does not check the previous read's own shape or follow its `Previous` link, so
+//! each read is checked once, when it is written.
+//!
+//! Whether the sites are right, whether the read looked at enough, and whether a disagreement matters stay with the
+//! people who write and review it; nothing here reads the code a read names.
+//!
+//! Exits 0 and prints one line when the read passes. Exits 1 and prints one line per refusal, each naming the file,
+//! line and field, when it does not. A malformed command line, or a read that cannot be read as UTF-8 text, exits 2.
+
+mod carry;
+mod markdown;
+mod read;
+
+use std::fs;
+use std::io::{self, Write as _};
+use std::process::ExitCode;
+
+use camino::{Utf8Path, Utf8PathBuf};
+use clap::{Parser, Subcommand};
+
+use crate::read::{Previous, Read, Refusal, Row};
+
+/// The exit status for a read that is refused.
+const REFUSED: u8 = 1;
+/// The exit status for a read that cannot be read at all.
+const UNUSABLE: u8 = 2;
+
+#[derive(Debug, Parser)]
+#[command(name = "design-read", about = "Check design reads.")]
+struct Arguments {
+    #[command(subcommand)]
+    command: Command,
+}
+
+#[derive(Debug, Subcommand)]
+enum Command {
+    /// Check one read's shape and what it carries forward from its previous read.
+    Check {
+        /// The read, a Markdown file.
+        file: Utf8PathBuf,
+    },
+}
+
+fn main() -> ExitCode {
+    let Command::Check { file } = Arguments::parse().command;
+    let mut out = io::stdout().lock();
+    let mut errors = io::stderr().lock();
+    // Standard error is where a failure to write is reported, so a failure to write there has nowhere to go.
+    let written = match check(&file) {
+        Ok(passed) => writeln!(out, "{file}: passes: {passed}").map(|()| ExitCode::SUCCESS),
+        Err(Failure::Refused(refusals)) => refusals
+            .iter()
+            .try_for_each(|refusal| writeln!(errors, "{file}:{refusal}"))
+            .map(|()| ExitCode::from(REFUSED)),
+        Err(Failure::Unusable(reason)) => {
+            writeln!(errors, "{file}: {reason}").map(|()| ExitCode::from(UNUSABLE))
+        }
+    };
+    written.unwrap_or(ExitCode::FAILURE)
+}
+
+/// Why a read does not pass.
+#[derive(Debug)]
+enum Failure {
+    /// The read's refusals, in line order.
+    Refused(Vec<Refusal>),
+    /// The file could not be read as text, so it has no lines to refuse.
+    Unusable(String),
+}
+
+impl Failure {
+    fn refused(mut refusals: Vec<Refusal>) -> Self {
+        refusals.sort_by_key(Refusal::line);
+        Self::Refused(refusals)
+    }
+}
+
+/// The summary of the read at `file` when it passes, read with its previous read.
+fn check(file: &Utf8Path) -> Result<String, Failure> {
+    let text = fs::read_to_string(file)
+        .map_err(|error| Failure::Unusable(format!("cannot be read: {error}")))?;
+    let read = Read::parse(&text).map_err(Failure::refused)?;
+    let refusals = match read.previous() {
+        None => carry::refusals(&read, &[]),
+        Some(previous) => match previous_rows(file, previous) {
+            Ok(rows) => carry::refusals(&read, &rows),
+            Err(refusal) => vec![refusal],
+        },
+    };
+    if refusals.is_empty() {
+        Ok(read.summary())
+    } else {
+        Err(Failure::refused(refusals))
+    }
+}
+
+/// The rows of the previous read, found relative to `file`; refused when it cannot be read or has no table.
+fn previous_rows(file: &Utf8Path, previous: &Previous) -> Result<Vec<Row>, Refusal> {
+    let path = file
+        .parent()
+        .unwrap_or(Utf8Path::new(""))
+        .join(previous.path());
+    let text = fs::read_to_string(&path)
+        .map_err(|error| previous.refuse(format!("{} cannot be read: {error}", previous.path())))?;
+    read::rows_of(&text).map_err(|reason| {
+        previous.refuse(format!(
+            "{} has no table to compare with: {reason}",
+            previous.path()
+        ))
+    })
+}
diff --git a/tools/crates/design-read/src/markdown.rs b/tools/crates/design-read/src/markdown.rs
new file mode 100644
index 0000000000000000000000000000000000000000..35879406c34ee78b388b507bd64d4cc82d578242
--- /dev/null
+++ b/tools/crates/design-read/src/markdown.rs
@@ -0,0 +1,155 @@
+//! The little of Markdown a read's checks need: level-two sections, fenced code, and table rows split into cells.
+//! Everything else is prose and stays text.
+
+/// One line of a file, numbered from 1.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct Line<'a> {
+    pub(crate) number: usize,
+    pub(crate) text: &'a str,
+}
+
+/// A file split at its level-two headings: the lines before the first, then each section in order. A heading inside
+/// fenced code is code, not a heading.
+#[derive(Debug)]
+pub(crate) struct Sections<'a> {
+    pub(crate) lead: Vec<Line<'a>>,
+    pub(crate) sections: Vec<Section<'a>>,
+}
+
+/// One level-two section: its heading's title and line, and the lines under it. Lines inside fenced code are left out,
+/// so a table or field shown as an example is never read as the read's own.
+#[derive(Debug)]
+pub(crate) struct Section<'a> {
+    pub(crate) title: &'a str,
+    pub(crate) line: usize,
+    pub(crate) body: Vec<Line<'a>>,
+}
+
+impl<'a> Sections<'a> {
+    pub(crate) fn of(text: &'a str) -> Self {
+        let mut lead = Vec::new();
+        let mut sections: Vec<Section<'a>> = Vec::new();
+        let mut fenced = false;
+        for (index, text) in text.lines().enumerate() {
+            let line = Line {
+                number: index + 1,
+                text,
+            };
+            let trimmed = text.trim_start();
+            if trimmed.starts_with("```") || trimmed.starts_with("~~~") {
+                fenced = !fenced;
+                continue;
+            }
+            if fenced {
+                continue;
+            }
+            if let Some(title) = text.strip_prefix("## ") {
+                sections.push(Section {
+                    title: title.trim(),
+                    line: line.number,
+                    body: Vec::new(),
+                });
+            } else if let Some(section) = sections.last_mut() {
+                section.body.push(line);
+            } else {
+                lead.push(line);
+            }
+        }
+        Self { lead, sections }
+    }
+
+    /// Every section titled `title`, in order.
+    pub(crate) fn titled(&self, title: &str) -> impl Iterator<Item = &Section<'a>> {
+        self.sections
+            .iter()
+            .filter(move |section| section.title == title)
+    }
+}
+
+/// Whether `text` is a table row: its first character past indentation is a pipe.
+pub(crate) fn is_row(text: &str) -> bool {
+    text.trim_start().starts_with('|')
+}
+
+/// A table row's cells, each trimmed. A backslash-escaped pipe stays in its cell as a pipe.
+pub(crate) fn cells(row: &str) -> Vec<String> {
+    let row = row.trim();
+    let row = row.strip_prefix('|').unwrap_or(row);
+    let row = match row.strip_suffix('|') {
+        Some(inner) if !inner.ends_with('\\') => inner,
+        _ => row,
+    };
+    let mut cells = Vec::new();
+    let mut cell = String::new();
+    let mut characters = row.chars().peekable();
+    while let Some(character) = characters.next() {
+        match character {
+            '\\' if characters.peek() == Some(&'|') => {
+                characters.next();
+                cell.push('|');
+            }
+            '|' => cells.push(std::mem::take(&mut cell)),
+            other => cell.push(other),
+        }
+    }
+    cells.push(cell);
+    cells
+        .into_iter()
+        .map(|cell| cell.trim().to_owned())
+        .collect()
+}
+
+/// Whether `cells` are a table's delimiter row, each cell dashes with an optional colon at either end.
+pub(crate) fn is_delimiter(cells: &[String]) -> bool {
+    cells.iter().all(|cell| {
+        let dashes = cell.strip_prefix(':').unwrap_or(cell);
+        let dashes = dashes.strip_suffix(':').unwrap_or(dashes);
+        !dashes.is_empty() && dashes.chars().all(|character| character == '-')
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_heading_in_fenced_code_starts_no_section_and_its_lines_are_left_out() {
+        let sections = Sections::of("# t\n- a\n## One\nx\n```\n## Not\n| a |\n```\ny\n## Two\n");
+        assert_eq!(
+            sections
+                .lead
+                .iter()
+                .map(|line| line.text)
+                .collect::<Vec<_>>(),
+            ["# t", "- a"]
+        );
+        let titles: Vec<_> = sections
+            .sections
+            .iter()
+            .map(|section| (section.title, section.line))
+            .collect();
+        assert_eq!(titles, [("One", 3), ("Two", 10)]);
+        let body: Vec<_> = sections.sections[0]
+            .body
+            .iter()
+            .map(|line| (line.number, line.text))
+            .collect();
+        assert_eq!(body, [(4, "x"), (9, "y")]);
+    }
+
+    #[test]
+    fn a_row_splits_at_unescaped_pipes_and_keeps_an_escaped_one() {
+        assert_eq!(cells("| a | `b\\|c` |  | d |"), ["a", "`b|c`", "", "d"]);
+        assert_eq!(cells("a | b"), ["a", "b"]);
+        assert_eq!(cells("| `C:\\x` | a\\ |"), ["`C:\\x`", "a\\"]);
+        assert_eq!(cells("| a \\|"), ["a |"]);
+    }
+
+    #[test]
+    fn a_delimiter_row_is_dashes_with_optional_colons() {
+        let row = |text: &str| is_delimiter(&cells(text));
+        assert!(row("|---|:--|--:|:-:|"));
+        assert!(!row("|---|x|"));
+        assert!(!row("|---||"));
+    }
+}
