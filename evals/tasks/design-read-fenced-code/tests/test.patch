+//! Fenced code in a read, through the command: everything inside a fenced code block is content, and the block ends
+//! only at a valid closing fence, so the read's real sections, outside every block, decide whether it passes.
+
+mod evaluation {
+    use std::path::Path;
+    use std::process::{Command, Output};
+
+    fn check(read: &str) -> Output {
+        Command::new(env!("CARGO_BIN_EXE_design-read"))
+            .args(["check", read])
+            .current_dir(Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/evaluation"))
+            .output()
+            .expect("design-read runs")
+    }
+
+    fn text(bytes: &[u8]) -> &str {
+        std::str::from_utf8(bytes).expect("UTF-8")
+    }
+
+    fn passes(read: &str) {
+        let output = check(read);
+        assert_eq!(text(&output.stderr), "", "{read}");
+        assert_eq!(
+            text(&output.stdout),
+            format!("{read}: passes: disagreements: 1 new, 0 open, 0 resolved, 0 parked\n")
+        );
+        assert_eq!(output.status.code(), Some(0), "{read}");
+    }
+
+    fn refused(read: &str, refusal: &str) {
+        let output = check(read);
+        assert_eq!(text(&output.stderr), format!("{read}:{refusal}\n"), "{read}");
+        assert_eq!(text(&output.stdout), "", "{read}");
+        assert_eq!(output.status.code(), Some(1), "{read}");
+    }
+
+    #[test]
+    fn shorter_fences_and_fences_with_text_after_them_inside_a_longer_block_are_content() {
+        passes("shorter.md");
+    }
+
+    #[test]
+    fn a_fence_of_the_other_marker_inside_a_block_is_content() {
+        passes("marker.md");
+    }
+
+    #[test]
+    fn a_fence_indented_four_spaces_is_content_and_one_indented_up_to_three_closes_the_block() {
+        passes("indented.md");
+    }
+
+    #[test]
+    fn a_longer_closing_fence_ends_the_block_and_the_sections_after_it_are_checked() {
+        refused("repeated.md", "20: Disagreements: given again; first on line 14");
+    }
+
+    #[test]
+    fn a_section_heading_inside_a_block_is_not_a_section() {
+        refused("quoted.md", "1: Disagreements: missing; a read has a `## Disagreements` section");
+    }
+}
