+//! Living area files through the command: the header holds exactly three fields, the disagreements are a five-column
+//! table or `None found.` alone, and `check` takes any number of files or, given none, every area file in
+//! `docs/design-reads/`.
+
+mod evaluation {
+    use std::fs;
+    use std::path::{Path, PathBuf};
+    use std::process::{Command, Output};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    const COMMIT: &str = "0123456789abcdef0123456789abcdef01234567";
+    const HEADER: &str =
+        "| Concept | Owner | Sites | Consequence | Done when |\n|---|---|---|---|---|\n";
+    const ROW: &str = "| a concept | the owner | `site` | what goes wrong | when it is done |\n";
+
+    /// A folder of its own in the system's temporary folder, removed when the test ends.
+    struct Scratch(PathBuf);
+
+    impl Scratch {
+        fn new(name: &str) -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let path = std::env::temp_dir().join(format!(
+                "design-read-evaluation-{}-{}-{name}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            let _ = fs::remove_dir_all(&path);
+            fs::create_dir_all(&path).expect("a scratch folder");
+            Self(path)
+        }
+
+        fn write(&self, file: &str, text: &str) {
+            let path = self.0.join(file);
+            fs::create_dir_all(path.parent().expect("a parent")).expect("a folder");
+            fs::write(path, text).expect("written");
+        }
+
+        fn check(&self, folder: &str, files: &[&str]) -> Output {
+            check_in(&self.0.join(folder), files)
+        }
+    }
+
+    impl Drop for Scratch {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    fn check_in(folder: &Path, files: &[&str]) -> Output {
+        Command::new(env!("CARGO_BIN_EXE_design-read"))
+            .arg("check")
+            .args(files)
+            .current_dir(folder)
+            .output()
+            .expect("design-read runs")
+    }
+
+    fn text(bytes: &[u8]) -> &str {
+        std::str::from_utf8(bytes).expect("UTF-8")
+    }
+
+    /// An area file: the header lines, prose sections, and the Disagreements section's body.
+    fn area(header: &str, disagreements: &str) -> String {
+        format!(
+            "# Test design read\n\n{header}\n## Models in play\n\n- A model.\n\n## Overlaps\n\n- None.\n\n\
+             ## Half-done transitions\n\n- None.\n\n## What later work needs\n\n- Nothing.\n\n\
+             ## Disagreements\n\n{disagreements}"
+        )
+    }
+
+    fn header() -> String {
+        format!("- Area: a test area\n- Last full read: {COMMIT}\n- Inspected: `site`\n")
+    }
+
+    /// The line number of the first line of `text` equal to `line`.
+    fn line_of(text: &str, line: &str) -> usize {
+        text.lines()
+            .position(|candidate| candidate == line)
+            .expect("the line")
+            + 1
+    }
+
+    fn passes(text_: &str) {
+        let scratch = Scratch::new("passes");
+        scratch.write("area.md", text_);
+        let output = scratch.check("", &["area.md"]);
+        assert_eq!(text(&output.stderr), "", "{text_}");
+        assert_eq!(text(&output.stdout), "area.md: passes\n", "{text_}");
+        assert_eq!(output.status.code(), Some(0), "{text_}");
+    }
+
+    fn refused(text_: &str, line: usize, field: &str) {
+        let scratch = Scratch::new("refused");
+        scratch.write("area.md", text_);
+        let output = scratch.check("", &["area.md"]);
+        let errors = text(&output.stderr);
+        let prefix = format!("area.md:{line}: {field}: ");
+        assert!(
+            errors.starts_with(&prefix) && errors.lines().count() == 1,
+            "expected one refusal starting {prefix:?}, got {errors:?} for\n{text_}"
+        );
+        assert_eq!(text(&output.stdout), "", "{text_}");
+        assert_eq!(output.status.code(), Some(1), "{text_}");
+    }
+
+    #[test]
+    fn a_valid_area_file_passes_with_rows_or_with_none_found() {
+        passes(&area(
+            &header(),
+            &format!("{HEADER}{ROW}| Another \\| one | o | `s` | c | d |\n"),
+        ));
+        passes(&area(&header(), "None found.\n"));
+        let prose = header().replace("- Inspected", "Read on a quiet day.\n- Inspected");
+        passes(&area(&prose, "None found.\n"));
+        let fenced = format!(
+            "None found.\n\nAn example, which is not the file's own:\n\n```markdown\n- Previous: old.md\n{HEADER}{ROW}{ROW}```\n"
+        );
+        passes(&area(&header(), &fenced));
+    }
+
+    #[test]
+    fn a_header_field_beyond_the_three_is_refused_at_its_line_by_its_name() {
+        for field in ["Previous", "Revision"] {
+            let text_ = area(&format!("{}- {field}: old.md\n", header()), "None found.\n");
+            refused(
+                &text_,
+                line_of(&text_, &format!("- {field}: old.md")),
+                field,
+            );
+        }
+        let text_ = area(&header(), "None found.\n")
+            .replace("- Inspected", "- Previous: none\n- Inspected");
+        refused(&text_, line_of(&text_, "- Previous: none"), "Previous");
+    }
+
+    #[test]
+    fn each_header_rule_is_refused_alone_at_its_line_and_field() {
+        let missing = area(
+            &header().replace("- Inspected: `site`\n", ""),
+            "None found.\n",
+        );
+        refused(&missing, 1, "Inspected");
+        let again = area(&format!("{}- Area: again\n", header()), "None found.\n");
+        refused(&again, line_of(&again, "- Area: again"), "Area");
+        let empty = area(
+            &header().replace("- Area: a test area", "- Area:"),
+            "None found.\n",
+        );
+        refused(&empty, line_of(&empty, "- Area:"), "Area");
+        for commit in ["3ddf4c52", &COMMIT.to_uppercase()] {
+            let short = area(&header().replace(COMMIT, commit), "None found.\n");
+            refused(
+                &short,
+                line_of(&short, &format!("- Last full read: {commit}")),
+                "Last full read",
+            );
+        }
+    }
+
+    #[test]
+    fn none_found_beside_a_table_is_refused_even_beside_one_without_rows() {
+        let beside_rows = area(&header(), &format!("{HEADER}{ROW}\nNone found.\n"));
+        refused(
+            &beside_rows,
+            line_of(&beside_rows, "None found."),
+            "Disagreements",
+        );
+        let beside_empty = area(&header(), &format!("{HEADER}\nNone found.\n"));
+        refused(
+            &beside_empty,
+            line_of(&beside_empty, "None found."),
+            "Disagreements",
+        );
+        let neither = area(&header(), "Nothing to say.\n");
+        refused(
+            &neither,
+            line_of(&neither, "## Disagreements"),
+            "Disagreements",
+        );
+    }
+
+    #[test]
+    fn each_table_rule_is_refused_alone_at_its_line_and_field() {
+        let old = "| ID | Concept | Owner | Sites | Consequence | Done when | Status |\n|---|---|---|---|---|---|---|\n\
+                   | r-D1 | a | o | `s` | c | d | new |\n";
+        let columns = area(&header(), old);
+        refused(
+            &columns,
+            line_of(&columns, old.lines().next().expect("a header row")),
+            "Disagreements",
+        );
+        let delimiter = area(
+            &header(),
+            &format!("{}\n{ROW}", HEADER.lines().next().expect("a header row")),
+        );
+        refused(
+            &delimiter,
+            line_of(&delimiter, ROW.trim_end()),
+            "Disagreements",
+        );
+        // A table that ends at its header row has no delimiter row; the header row is where that is refused.
+        let header_only = area(
+            &header(),
+            &format!("{}\n", HEADER.lines().next().expect("a header row")),
+        );
+        refused(
+            &header_only,
+            line_of(&header_only, HEADER.lines().next().expect("a header row")),
+            "Disagreements",
+        );
+        let short_delimiter = area(
+            &header(),
+            &format!(
+                "{}\n|---|---|---|---|\n{ROW}",
+                HEADER.lines().next().expect("a header row")
+            ),
+        );
+        refused(
+            &short_delimiter,
+            line_of(&short_delimiter, "|---|---|---|---|"),
+            "Disagreements",
+        );
+        let cells = area(&header(), &format!("{HEADER}| a | o | `s` | c |\n"));
+        refused(
+            &cells,
+            line_of(&cells, "| a | o | `s` | c |"),
+            "Disagreements",
+        );
+        let empty = area(&header(), &format!("{HEADER}| a |  | `s` | c | d |\n"));
+        refused(&empty, line_of(&empty, "| a |  | `s` | c | d |"), "Owner");
+        let repeated = area(
+            &header(),
+            &format!(
+                "{HEADER}| A Concept | o | `s` | c | d |\n|  a concept  | o | `t` | c | d |\n"
+            ),
+        );
+        refused(
+            &repeated,
+            line_of(&repeated, "|  a concept  | o | `t` | c | d |"),
+            "Concept",
+        );
+        let second = area(
+            &header(),
+            &format!("{HEADER}{ROW}\n{HEADER}| other | o | `s` | c | d |\n"),
+        );
+        refused(
+            &second,
+            line_of(&second, "| other | o | `s` | c | d |") - 2,
+            "Disagreements",
+        );
+        let missing = area(&header(), "").replace("## Disagreements\n\n", "");
+        refused(&missing, 1, "Disagreements");
+    }
+
+    #[test]
+    fn with_no_file_every_area_file_directly_in_the_folder_is_checked_in_name_order_but_the_readme()
+    {
+        let scratch = Scratch::new("folder");
+        scratch.write(
+            "docs/design-reads/README.md",
+            "# Design reads\n\nNot an area file.\n",
+        );
+        scratch.write(
+            "docs/design-reads/quiet.md",
+            &area(&header(), "None found.\n"),
+        );
+        scratch.write(
+            "docs/design-reads/motion.md",
+            &area(&header(), &format!("{HEADER}{ROW}")),
+        );
+        scratch.write("docs/design-reads/notes.txt", "not Markdown\n");
+        scratch.write("docs/design-reads/old/stale.md", "not an area file\n");
+        let output = scratch.check("", &[]);
+        assert_eq!(text(&output.stderr), "");
+        assert_eq!(
+            text(&output.stdout),
+            "docs/design-reads/motion.md: passes\ndocs/design-reads/quiet.md: passes\n"
+        );
+        assert_eq!(output.status.code(), Some(0));
+
+        scratch.write(
+            "docs/design-reads/broken.md",
+            &area(&header(), "Nothing to say.\n"),
+        );
+        let output = scratch.check("", &[]);
+        let errors = text(&output.stderr);
+        assert!(
+            errors.starts_with("docs/design-reads/broken.md:") && errors.lines().count() == 1,
+            "{errors}"
+        );
+        assert_eq!(
+            text(&output.stdout),
+            "docs/design-reads/motion.md: passes\ndocs/design-reads/quiet.md: passes\n"
+        );
+        assert_eq!(output.status.code(), Some(1));
+    }
+
+    #[test]
+    fn named_files_are_each_checked_in_the_order_named_and_any_refusal_fails_the_run() {
+        let scratch = Scratch::new("named");
+        scratch.write("a/quiet.md", &area(&header(), "None found.\n"));
+        scratch.write("b/motion.md", &area(&header(), &format!("{HEADER}{ROW}")));
+        scratch.write("c/broken.md", &area(&header(), "Nothing to say.\n"));
+        let output = scratch.check("", &["b/motion.md", "a/quiet.md"]);
+        assert_eq!(text(&output.stderr), "");
+        assert_eq!(
+            text(&output.stdout),
+            "b/motion.md: passes\na/quiet.md: passes\n"
+        );
+        assert_eq!(output.status.code(), Some(0));
+
+        let output = scratch.check("", &["c/broken.md", "a/quiet.md"]);
+        let errors = text(&output.stderr);
+        assert!(
+            errors.starts_with("c/broken.md:") && errors.lines().count() == 1,
+            "{errors}"
+        );
+        assert_eq!(text(&output.stdout), "a/quiet.md: passes\n");
+        assert_eq!(output.status.code(), Some(1));
+    }
+
+    #[test]
+    fn a_missing_folder_an_unreadable_file_or_a_malformed_command_line_exits_2() {
+        let scratch = Scratch::new("usage");
+        let output = scratch.check("", &[]);
+        assert_eq!(text(&output.stdout), "");
+        assert_ne!(text(&output.stderr), "");
+        assert_eq!(output.status.code(), Some(2));
+
+        scratch.write("broken.md", &area(&header(), "Nothing to say.\n"));
+        scratch.write("quiet.md", &area(&header(), "None found.\n"));
+        let output = scratch.check("", &["nowhere.md", "broken.md", "quiet.md"]);
+        let errors = text(&output.stderr);
+        assert!(
+            errors.starts_with("nowhere.md: cannot be read: "),
+            "{errors}"
+        );
+        assert!(
+            errors
+                .lines()
+                .nth(1)
+                .is_some_and(|line| line.starts_with("broken.md:")),
+            "{errors}"
+        );
+        assert_eq!(text(&output.stdout), "quiet.md: passes\n");
+        assert_eq!(output.status.code(), Some(2));
+
+        for arguments in [&[][..], &["verify", "a.md"][..], &["check", "--all"][..]] {
+            let output = Command::new(env!("CARGO_BIN_EXE_design-read"))
+                .args(arguments)
+                .current_dir(&scratch.0)
+                .output()
+                .expect("design-read runs");
+            assert_eq!(output.status.code(), Some(2), "{arguments:?}");
+        }
+    }
+}
