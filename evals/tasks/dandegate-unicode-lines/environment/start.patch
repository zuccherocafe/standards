diff --git a/tools/rust/crates/dandegate/src/compare/image.rs b/tools/rust/crates/dandegate/src/compare/image.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e0ef5873132ebb335590bc25e1782e8d74e9a028
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/compare/image.rs
@@ -0,0 +1,274 @@
+//! Compares the images that a per-revision step writes on each side, by file name.
+//!
+//! For each name that either side expected or wrote, the page shows whether each side expected the image and whether
+//! the image exists and can be read. A missing, unexpected or unreadable image appears before the differences and makes
+//! the page incomplete. A readable pair gets the mean absolute difference of its RGBA samples, from 0 to 255. Two
+//! images of different sizes differ by 255. dandegate decodes every PNG colour type and depth as 8-bit RGBA, and drops
+//! an image's samples once it has compared them, so it holds one pair in memory at a time.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+use std::fs;
+use std::io::Cursor;
+
+use camino::Utf8PathBuf;
+
+use crate::compare::measure::Finite;
+use crate::revision::{PerSide, Side};
+
+/// A decoded picture's size and its RGBA samples, row by row.
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Pixels {
+    width: u32,
+    height: u32,
+    rgba: Vec<u8>,
+}
+
+/// Decode a PNG of any colour type and depth into 8-bit RGBA.
+///
+/// # Errors
+/// The decoder's reason, as text, for anything that is not a whole PNG.
+fn decode(bytes: &[u8]) -> Result<Pixels, String> {
+    let mut decoder = png::Decoder::new(Cursor::new(bytes));
+    decoder.set_transformations(png::Transformations::normalize_to_color8());
+    let mut reader = decoder.read_info().map_err(|error| error.to_string())?;
+    let size = reader
+        .output_buffer_size()
+        .ok_or_else(|| "the image is too large to decode".to_owned())?;
+    let mut buffer = vec![0; size];
+    let frame = reader
+        .next_frame(&mut buffer)
+        .map_err(|error| error.to_string())?;
+    let samples = &buffer[..frame.buffer_size()];
+    let rgba = match frame.color_type {
+        png::ColorType::Rgba => samples.to_vec(),
+        png::ColorType::Rgb => samples
+            .as_chunks::<3>()
+            .0
+            .iter()
+            .flat_map(|rgb| [rgb[0], rgb[1], rgb[2], 255])
+            .collect(),
+        png::ColorType::GrayscaleAlpha => samples
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .flat_map(|ga| [ga[0], ga[0], ga[0], ga[1]])
+            .collect(),
+        png::ColorType::Grayscale => samples
+            .iter()
+            .flat_map(|&grey| [grey, grey, grey, 255])
+            .collect(),
+        png::ColorType::Indexed => {
+            return Err("a paletted image the decoder did not expand".to_owned());
+        }
+    };
+    Ok(Pixels {
+        width: frame.width,
+        height: frame.height,
+        rgba,
+    })
+}
+
+/// The mean absolute difference of two pictures' RGBA samples, from 0 to 255, or 255 when their sizes differ.
+fn mean_difference(a: &Pixels, b: &Pixels) -> Finite {
+    const MOST: Finite = Finite::constant(255.0);
+    if (a.width, a.height) != (b.width, b.height) {
+        return MOST;
+    }
+    let total: u64 = a
+        .rgba
+        .iter()
+        .zip(&b.rgba)
+        .map(|(x, y)| u64::from(x.abs_diff(*y)))
+        .sum();
+    #[expect(
+        clippy::cast_precision_loss,
+        reason = "a sum of bytes and a sample count are far below 2^52"
+    )]
+    let mean = total as f64 / a.rgba.len().max(1) as f64;
+    Finite::new(mean).expect("a mean of byte differences is between 0 and 255")
+}
+
+/// What one side holds under a name.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum ImageState {
+    Absent,
+    /// There, but not a picture: the decoder's reason.
+    Unreadable(String),
+    /// There and decoded, with its size.
+    Readable {
+        width: u32,
+        height: u32,
+    },
+}
+
+/// A problem with a cell's evidence.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Problem {
+    /// Expected on this side and not there.
+    Missing(Side),
+    /// There on this side, which did not expect it.
+    Unexpected(Side),
+    /// There on this side and not a picture.
+    Unreadable(Side, String),
+}
+
+impl fmt::Display for Problem {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Missing(side) => write!(formatter, "missing on the {} side", side.as_str()),
+            Self::Unexpected(side) => {
+                write!(formatter, "not expected on the {} side", side.as_str())
+            }
+            Self::Unreadable(side, why) => {
+                write!(formatter, "unreadable on the {} side: {why}", side.as_str())
+            }
+        }
+    }
+}
+
+/// One name's images on both sides.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Cell {
+    name: String,
+    expected: PerSide<bool>,
+    image: PerSide<ImageState>,
+    difference: Option<Finite>,
+}
+
+impl Cell {
+    pub(crate) fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub(crate) fn image(&self) -> &PerSide<ImageState> {
+        &self.image
+    }
+
+    /// The mean RGBA difference, when both sides are readable.
+    pub(crate) fn difference(&self) -> Option<Finite> {
+        self.difference
+    }
+
+    /// Every problem with the cell's evidence, before side first.
+    pub(crate) fn problems(&self) -> Vec<Problem> {
+        let mut problems = Vec::new();
+        for side in Side::BOTH {
+            match (&self.image[side], self.expected[side]) {
+                (ImageState::Absent, true) => problems.push(Problem::Missing(side)),
+                (ImageState::Absent, false) => {}
+                (present, expected) => {
+                    if !expected {
+                        problems.push(Problem::Unexpected(side));
+                    }
+                    if let ImageState::Unreadable(why) = present {
+                        problems.push(Problem::Unreadable(side, why.clone()));
+                    }
+                }
+            }
+        }
+        problems
+    }
+}
+
+/// Every name either side expected or produced, compared: those with a problem first, then the largest differences.
+/// `found` is each side's images by name.
+pub(crate) fn cells(
+    expected: &PerSide<BTreeSet<String>>,
+    found: &PerSide<BTreeMap<String, Utf8PathBuf>>,
+) -> Vec<Cell> {
+    let names: BTreeSet<&String> = expected
+        .before
+        .iter()
+        .chain(&expected.after)
+        .chain(found.before.keys())
+        .chain(found.after.keys())
+        .collect();
+    let mut cells: Vec<Cell> = names
+        .into_iter()
+        .map(|name| {
+            let decoded = PerSide::from_fn(|side| {
+                found[side].get(name).map(|path| {
+                    fs::read(path)
+                        .map_err(|error| error.to_string())
+                        .and_then(|bytes| decode(&bytes))
+                })
+            });
+            let difference = match (&decoded.before, &decoded.after) {
+                (Some(Ok(before)), Some(Ok(after))) => Some(mean_difference(before, after)),
+                _ => None,
+            };
+            let image = decoded.map(|_, state| match state {
+                None => ImageState::Absent,
+                Some(Err(why)) => ImageState::Unreadable(why),
+                Some(Ok(pixels)) => ImageState::Readable {
+                    width: pixels.width,
+                    height: pixels.height,
+                },
+            });
+            Cell {
+                name: name.clone(),
+                expected: PerSide::from_fn(|side| expected[side].contains(name)),
+                image,
+                difference,
+            }
+        })
+        .collect();
+    cells.sort_by(|left, right| {
+        let order = left.problems().is_empty().cmp(&right.problems().is_empty());
+        let size = |cell: &Cell| cell.difference.map_or(0.0, Finite::get);
+        order.then_with(|| size(right).total_cmp(&size(left)))
+    });
+    cells
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn png(width: u32, height: u32, colour: png::ColorType, samples: &[u8]) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        let mut encoder = png::Encoder::new(&mut bytes, width, height);
+        encoder.set_color(colour);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header().expect("a header");
+        writer.write_image_data(samples).expect("the samples");
+        writer.finish().expect("a whole image");
+        bytes
+    }
+
+    #[test]
+    fn the_mean_difference_is_per_rgba_sample() {
+        let a = decode(&png(1, 1, png::ColorType::Rgba, &[10, 20, 30, 255])).expect("a picture");
+        let b = decode(&png(1, 1, png::ColorType::Rgba, &[13, 20, 27, 255])).expect("a picture");
+        // |10-13| + |20-20| + |30-27| + |255-255| = 6, over four samples.
+        assert_eq!(mean_difference(&a, &b).get(), 1.5);
+        assert_eq!(mean_difference(&a, &a).get(), 0.0);
+    }
+
+    #[test]
+    fn pictures_of_different_sizes_differ_by_the_most() {
+        let a = decode(&png(1, 1, png::ColorType::Rgba, &[0, 0, 0, 0])).expect("a picture");
+        let b = decode(&png(2, 1, png::ColorType::Rgba, &[0; 8])).expect("a picture");
+        assert_eq!(mean_difference(&a, &b).get(), 255.0);
+    }
+
+    #[test]
+    fn grey_and_rgb_pictures_read_as_rgba() {
+        let grey = decode(&png(1, 1, png::ColorType::Grayscale, &[7])).expect("a picture");
+        let grey_alpha =
+            decode(&png(1, 1, png::ColorType::GrayscaleAlpha, &[7, 9])).expect("a picture");
+        let rgb = decode(&png(1, 1, png::ColorType::Rgb, &[1, 2, 3])).expect("a picture");
+        assert_eq!(grey.rgba, [7, 7, 7, 255]);
+        assert_eq!(grey_alpha.rgba, [7, 7, 7, 9]);
+        assert_eq!(rgb.rgba, [1, 2, 3, 255]);
+    }
+
+    #[test]
+    fn bytes_that_are_not_a_png_are_unreadable() {
+        assert!(decode(b"not a picture").is_err());
+        let mut cut = png(1, 1, png::ColorType::Rgba, &[1, 2, 3, 4]);
+        cut.truncate(cut.len() - 20);
+        assert!(decode(&cut).is_err());
+    }
+}
diff --git a/tools/rust/crates/dandegate/src/compare/measure.rs b/tools/rust/crates/dandegate/src/compare/measure.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c06d8f89cb7aa4743793aa60bd884f5b87bf06af
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/compare/measure.rs
@@ -0,0 +1,570 @@
+//! Reads `MEASURE:` lines and saved measures records, and compares the two sides' observations by name.
+//!
+//! A line has the form `MEASURE: <name> <value> <unit> [higher-is-worse|lower-is-worse]`. The unit is every word
+//! between the value and an optional direction word at the end, so a unit such as `mm before closure` stays whole.
+//! dandegate calls a measure worse only when a line gives its direction, because only the code that takes a measure
+//! knows which way is worse.
+//!
+//! A side keeps every distinct observation of a name. More than one observation is a conflict, and the page shows every
+//! value. A side with no direction for a name borrows the other side's direction. When the two sides give different
+//! directions, dandegate calls neither worse. The difference and the relative change use checked arithmetic. When one
+//! of them cannot be represented, because the before value is zero or the difference overflows, the comparison holds
+//! none and the page says so. The 5% marker says that a measure moved, not that the movement is significant.
+
+use std::cmp::Ordering;
+use std::collections::BTreeMap;
+use std::fmt;
+
+use indexmap::IndexMap;
+use serde::{Deserialize, Serialize};
+
+use crate::revision::PerSide;
+
+/// The relative change past which a measure is marked as moved.
+const MOVED: f64 = 0.05;
+/// What a measure line starts with, after any indentation.
+const PREFIX: &str = "MEASURE: ";
+/// The saved record's format tag.
+const FORMAT: &str = "dandegate-measures-v1";
+
+/// A finite number.
+#[derive(Clone, Copy, Debug, PartialEq, PartialOrd)]
+pub(crate) struct Finite(f64);
+
+impl Finite {
+    /// A finite constant. A value that is not finite fails to compile where the constant is built.
+    pub(crate) const fn constant(value: f64) -> Self {
+        assert!(value.is_finite(), "a finite constant");
+        Self(value)
+    }
+
+    pub(crate) fn new(value: f64) -> Option<Self> {
+        value.is_finite().then_some(Self(value))
+    }
+
+    pub(crate) fn get(self) -> f64 {
+        self.0
+    }
+}
+
+/// The shortest text that reads back as the same number, in exponent form when very large or small.
+impl fmt::Display for Finite {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let size = self.0.abs();
+        if size != 0.0 && !(1e-5..1e15).contains(&size) {
+            write!(formatter, "{:e}", self.0)
+        } else {
+            write!(formatter, "{}", self.0)
+        }
+    }
+}
+
+/// A measure's name: no whitespace, never empty.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) struct MeasureName(Box<str>);
+
+impl MeasureName {
+    fn new(text: &str) -> Option<Self> {
+        (!text.is_empty() && !text.contains(char::is_whitespace)).then(|| Self(text.into()))
+    }
+
+    pub(crate) fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Display for MeasureName {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.0)
+    }
+}
+
+/// The way a measure gets worse.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub(crate) enum Direction {
+    Higher,
+    Lower,
+}
+
+impl Direction {
+    /// The word a measure line ends with.
+    pub(crate) fn word(self) -> &'static str {
+        match self {
+            Self::Higher => "higher-is-worse",
+            Self::Lower => "lower-is-worse",
+        }
+    }
+
+    fn from_word(word: &str) -> Option<Self> {
+        match word {
+            "higher-is-worse" => Some(Self::Higher),
+            "lower-is-worse" => Some(Self::Lower),
+            _ => None,
+        }
+    }
+
+    /// Whether going from `before` to `after` goes this way.
+    fn worsened(self, before: f64, after: f64) -> bool {
+        match self {
+            Self::Higher => after > before,
+            Self::Lower => after < before,
+        }
+    }
+}
+
+/// One observed value of a measure, with its unit, which may be several words or none, and which way it is worse.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Observation {
+    value: Finite,
+    unit: String,
+    worse: Option<Direction>,
+}
+
+impl Observation {
+    pub(crate) fn worse(&self) -> Option<Direction> {
+        self.worse
+    }
+}
+
+/// The observation as the page shows it: value, unit and direction.
+impl fmt::Display for Observation {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}", self.value)?;
+        if !self.unit.is_empty() {
+            write!(formatter, " {}", self.unit)?;
+        }
+        if let Some(worse) = self.worse {
+            write!(formatter, " ({})", worse.word())?;
+        }
+        Ok(())
+    }
+}
+
+/// A side's measures: each name's distinct observations, in the order first seen.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct Measures(IndexMap<MeasureName, Vec<Observation>>);
+
+/// A measure line that cannot be read.
+#[derive(Debug, PartialEq, Eq, thiserror::Error)]
+#[error("line {line}: {why}")]
+pub(crate) struct LineError {
+    line: usize,
+    why: LineProblem,
+}
+
+/// Why a measure line cannot be read.
+#[derive(Debug, PartialEq, Eq, thiserror::Error)]
+pub(crate) enum LineProblem {
+    #[error("a measure line is `MEASURE: <name> <value> <unit>`")]
+    Shape,
+    #[error("{0:?} is not a finite number")]
+    Value(String),
+}
+
+/// A saved measures record that cannot be read.
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum SavedError {
+    #[error("it is not JSON")]
+    Json(#[source] serde_json::Error),
+    #[error("its format is {0:?}, not {FORMAT:?} or an earlier report's")]
+    Format(String),
+    #[error("{name}: {why}")]
+    Shape { name: String, why: &'static str },
+}
+
+/// The saved record, in the current format.
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Saved {
+    format: String,
+    measures: BTreeMap<String, Vec<SavedObservation>>,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedObservation {
+    value: f64,
+    unit: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    worse: Option<Direction>,
+}
+
+impl Measures {
+    /// Add an observation to `name`'s unless it is already there.
+    fn observe(&mut self, name: MeasureName, observation: Observation) {
+        let observations = self.0.entry(name).or_default();
+        if !observations.contains(&observation) {
+            observations.push(observation);
+        }
+    }
+
+    /// The `MEASURE:` lines of `text`, a step's measures file or a gate log. It ignores every other line.
+    ///
+    /// # Errors
+    /// [`LineError`] for the first measure line without a name and a finite value.
+    pub(crate) fn from_lines(text: &str) -> Result<Self, LineError> {
+        let mut measures = Self::default();
+        for (index, line) in text.lines().enumerate() {
+            let Some(rest) = line.trim_start().strip_prefix(PREFIX) else {
+                continue;
+            };
+            let refuse = |why| LineError {
+                line: index + 1,
+                why,
+            };
+            let mut words: Vec<&str> = rest.split_whitespace().collect();
+            let worse = words.last().and_then(|word| Direction::from_word(word));
+            if worse.is_some() {
+                words.pop();
+            }
+            let [name, value, unit @ ..] = &words[..] else {
+                return Err(refuse(LineProblem::Shape));
+            };
+            let name = MeasureName::new(name).ok_or_else(|| refuse(LineProblem::Shape))?;
+            let value = value
+                .parse()
+                .ok()
+                .and_then(Finite::new)
+                .ok_or_else(|| refuse(LineProblem::Value((*value).to_owned())))?;
+            measures.observe(
+                name,
+                Observation {
+                    value,
+                    unit: unit.join(" "),
+                    worse,
+                },
+            );
+        }
+        Ok(measures)
+    }
+
+    /// A record this tool saved, or an earlier report's: `{name: [[value, unit], ...]}`, or before that
+    /// `{name: [value, unit]}` and, for a conflict, `{name: [[values], unit]}`.
+    ///
+    /// # Errors
+    /// [`SavedError`] for text that is none of these.
+    pub(crate) fn from_saved(text: &str) -> Result<Self, SavedError> {
+        let value: serde_json::Value = serde_json::from_str(text).map_err(SavedError::Json)?;
+        if let Some(format) = value.get("format") {
+            if format.as_str() != Some(FORMAT) {
+                return Err(SavedError::Format(format.to_string()));
+            }
+            let saved: Saved = serde_json::from_value(value).map_err(SavedError::Json)?;
+            let mut measures = Self::default();
+            for (name, observations) in saved.measures {
+                let checked = MeasureName::new(&name).ok_or(SavedError::Shape {
+                    name: name.clone(),
+                    why: "is not a measure's name",
+                })?;
+                for saved in observations {
+                    let value = Finite::new(saved.value).ok_or(SavedError::Shape {
+                        name: name.clone(),
+                        why: "holds a value that is not finite",
+                    })?;
+                    measures.observe(
+                        checked.clone(),
+                        Observation {
+                            value,
+                            unit: saved.unit,
+                            worse: saved.worse,
+                        },
+                    );
+                }
+            }
+            return Ok(measures);
+        }
+        let serde_json::Value::Object(entries) = value else {
+            return Err(SavedError::Format("not an object".to_owned()));
+        };
+        let mut measures = Self::default();
+        for (name, entry) in entries {
+            let shape = |why| SavedError::Shape {
+                name: name.clone(),
+                why,
+            };
+            let checked =
+                MeasureName::new(&name).ok_or_else(|| shape("is not a measure's name"))?;
+            for (value, unit) in earlier_observations(&entry)
+                .ok_or_else(|| shape("is not a list of observations"))?
+            {
+                let value =
+                    Finite::new(value).ok_or_else(|| shape("holds a value that is not finite"))?;
+                measures.observe(
+                    checked.clone(),
+                    Observation {
+                        value,
+                        unit: unit.to_owned(),
+                        worse: None,
+                    },
+                );
+            }
+        }
+        Ok(measures)
+    }
+
+    /// The record `measures.json` holds.
+    pub(crate) fn saved(&self) -> String {
+        let measures = self
+            .0
+            .iter()
+            .map(|(name, observations)| {
+                let saved = observations
+                    .iter()
+                    .map(|observation| SavedObservation {
+                        value: observation.value.get(),
+                        unit: observation.unit.clone(),
+                        worse: observation.worse,
+                    })
+                    .collect();
+                (name.to_string(), saved)
+            })
+            .collect();
+        let saved = Saved {
+            format: FORMAT.to_owned(),
+            measures,
+        };
+        // A record of strings and finite numbers always serialises.
+        serde_json::to_string_pretty(&saved).unwrap_or_default() + "\n"
+    }
+
+    /// These measures with `own`'s names replaced by `own`'s observations: a revision's own step measures stand for
+    /// their names, whatever a gate log or earlier report says.
+    pub(crate) fn replaced_by(mut self, own: Self) -> Self {
+        for (name, observations) in own.0 {
+            self.0.insert(name, observations);
+        }
+        self
+    }
+
+    /// These measures with every observation of `other` added.
+    pub(crate) fn merged(mut self, other: Self) -> Self {
+        for (name, observations) in other.0 {
+            for observation in observations {
+                self.observe(name.clone(), observation);
+            }
+        }
+        self
+    }
+}
+
+/// An earlier report's observations of one name, or none for any other shape.
+fn earlier_observations(entry: &serde_json::Value) -> Option<Vec<(f64, &str)>> {
+    let items = entry.as_array()?;
+    if let [value, serde_json::Value::String(unit)] = &items[..] {
+        let values = match value {
+            serde_json::Value::Array(values) => values
+                .iter()
+                .map(serde_json::Value::as_f64)
+                .collect::<Option<Vec<_>>>()?,
+            single => vec![single.as_f64()?],
+        };
+        return Some(
+            values
+                .into_iter()
+                .map(|value| (value, unit.as_str()))
+                .collect(),
+        );
+    }
+    items
+        .iter()
+        .map(|item| match item.as_array().map(Vec::as_slice) {
+            Some([value, serde_json::Value::String(unit)]) => {
+                Some((value.as_f64()?, unit.as_str()))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+/// How a measure compares between the two sides.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum Verdict {
+    Same,
+    /// A different value in the same unit: the difference and the change relative to the before value, each none
+    /// where it cannot be represented, and the direction it got worse in, if it did.
+    Moved {
+        change: Option<Finite>,
+        relative: Option<Finite>,
+        worse: Option<Direction>,
+    },
+    New,
+    Gone,
+    UnitChanged,
+    Conflict,
+}
+
+/// One measure's observations on both sides and how they compare.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct MeasureRow {
+    name: MeasureName,
+    sides: PerSide<Vec<Observation>>,
+    verdict: Verdict,
+}
+
+impl MeasureRow {
+    pub(crate) fn name(&self) -> &MeasureName {
+        &self.name
+    }
+
+    pub(crate) fn sides(&self) -> &PerSide<Vec<Observation>> {
+        &self.sides
+    }
+
+    /// Whether the row is listed first: anything but the same value or a change within the movement marker.
+    pub(crate) fn flagged(&self) -> bool {
+        match self.verdict {
+            Verdict::Same => false,
+            Verdict::Moved { relative, .. } => {
+                relative.is_none_or(|relative| relative.get() > MOVED)
+            }
+            Verdict::New | Verdict::Gone | Verdict::UnitChanged | Verdict::Conflict => true,
+        }
+    }
+
+    /// Whether both sides give a direction and they differ, so neither is used.
+    pub(crate) fn directions_disagree(&self) -> bool {
+        let first =
+            |observations: &[Observation]| observations.first().and_then(Observation::worse);
+        matches!(
+            (first(&self.sides.before), first(&self.sides.after)),
+            (Some(before), Some(after)) if before != after
+        )
+    }
+
+    /// The change column's text.
+    pub(crate) fn change(&self) -> String {
+        match self.verdict {
+            Verdict::Same => String::new(),
+            Verdict::New => "new".to_owned(),
+            Verdict::Gone => "gone".to_owned(),
+            Verdict::UnitChanged => "unit changed".to_owned(),
+            Verdict::Conflict => "conflict".to_owned(),
+            Verdict::Moved {
+                change,
+                relative,
+                worse,
+            } => {
+                let mut parts = vec![change.map_or_else(
+                    || "difference too large to represent".to_owned(),
+                    |change| Signed(change).to_string(),
+                )];
+                parts.push(relative.map_or_else(
+                    || "relative change not representable".to_owned(),
+                    |relative| format!("{:.1}%", relative.get() * 100.0),
+                ));
+                if self.flagged() {
+                    parts.push("moved".to_owned());
+                }
+                if let Some(worse) = worse {
+                    parts.push(format!("worse ({})", worse.word()));
+                }
+                if self.directions_disagree() {
+                    parts.push("directions disagree".to_owned());
+                }
+                parts.join(", ")
+            }
+        }
+    }
+}
+
+/// A number with its sign always written.
+struct Signed(Finite);
+
+impl fmt::Display for Signed {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if self.0.get() >= 0.0 {
+            formatter.write_str("+")?;
+        }
+        write!(formatter, "{}", self.0)
+    }
+}
+
+/// Every name either side has, compared, flagged rows first and each group by name.
+pub(crate) fn compare(sides: &PerSide<Measures>) -> Vec<MeasureRow> {
+    let mut names: Vec<&MeasureName> = sides.before.0.keys().chain(sides.after.0.keys()).collect();
+    names.sort();
+    names.dedup();
+    let mut rows: Vec<MeasureRow> = names
+        .into_iter()
+        .map(|name| {
+            let observed = |measures: &Measures| measures.0.get(name).cloned().unwrap_or_default();
+            let observations = PerSide {
+                before: observed(&sides.before),
+                after: observed(&sides.after),
+            };
+            let verdict = verdict(&observations);
+            MeasureRow {
+                name: name.clone(),
+                sides: observations,
+                verdict,
+            }
+        })
+        .collect();
+    rows.sort_by_key(|row| !row.flagged());
+    rows
+}
+
+fn verdict(sides: &PerSide<Vec<Observation>>) -> Verdict {
+    match (&sides.before[..], &sides.after[..]) {
+        ([_, _, ..], _) | (_, [_, _, ..]) => Verdict::Conflict,
+        ([], _) => Verdict::New,
+        (_, []) => Verdict::Gone,
+        ([before], [after]) if before.unit != after.unit => Verdict::UnitChanged,
+        ([before], [after]) => {
+            let (old, new) = (before.value.get(), after.value.get());
+            #[expect(
+                clippy::float_cmp,
+                reason = "a measure is the same only when its value is exactly the same"
+            )]
+            let same = old == new;
+            if same {
+                return Verdict::Same;
+            }
+            let change = Finite::new(new - old);
+            let relative = change
+                .filter(|_| old != 0.0)
+                .and_then(|change| Finite::new(change.get().abs() / old.abs()));
+            let direction = match (before.worse, after.worse) {
+                (Some(old_way), Some(new_way)) if old_way != new_way => None,
+                (old_way, new_way) => new_way.or(old_way),
+            };
+            Verdict::Moved {
+                change,
+                relative,
+                worse: direction.filter(|way| way.worsened(old, new)),
+            }
+        }
+    }
+}
+
+/// The rows that moved in their worse direction, the largest relative change first, an unrepresentable one first of
+/// all.
+pub(crate) fn worse(rows: &[MeasureRow]) -> Vec<&MeasureRow> {
+    let mut found: Vec<(Option<Finite>, &MeasureRow)> = rows
+        .iter()
+        .filter_map(|row| match row.verdict {
+            Verdict::Moved {
+                relative,
+                worse: Some(_),
+                ..
+            } => Some((relative, row)),
+            Verdict::Moved { worse: None, .. }
+            | Verdict::Same
+            | Verdict::New
+            | Verdict::Gone
+            | Verdict::UnitChanged
+            | Verdict::Conflict => None,
+        })
+        .collect();
+    found.sort_by(|(left, _), (right, _)| match (left, right) {
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => Ordering::Less,
+        (Some(_), None) => Ordering::Greater,
+        (Some(left), Some(right)) => right.get().total_cmp(&left.get()),
+    });
+    found.into_iter().map(|(_, row)| row).collect()
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/tools/rust/crates/dandegate/src/compare/measure/tests.rs b/tools/rust/crates/dandegate/src/compare/measure/tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..108d8db73b414d585d0896ad02027829fbe0cce0
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/compare/measure/tests.rs
@@ -0,0 +1,322 @@
+use super::*;
+
+fn observed(value: f64, unit: &str, worse: Option<Direction>) -> Observation {
+    Observation {
+        value: Finite::new(value).expect("a finite value"),
+        unit: unit.to_owned(),
+        worse,
+    }
+}
+
+fn single(text: &str) -> (String, Vec<Observation>) {
+    let measures = Measures::from_lines(text).expect("measures");
+    let (name, observations) = measures.0.into_iter().next().expect("one measure");
+    (name.to_string(), observations)
+}
+
+#[test]
+fn a_line_gives_a_name_a_value_a_unit_of_any_words_and_an_optional_direction() {
+    assert_eq!(
+        single("MEASURE: clips.walk.twitch 0.012 m higher-is-worse"),
+        (
+            "clips.walk.twitch".to_owned(),
+            vec![observed(0.012, "m", Some(Direction::Higher))]
+        )
+    );
+    assert_eq!(
+        single("  MEASURE: a 2 mm before closure lower-is-worse").1,
+        [observed(2.0, "mm before closure", Some(Direction::Lower))]
+    );
+    assert_eq!(
+        single("MEASURE: a 15.03 deg").1,
+        [observed(15.03, "deg", None)]
+    );
+    assert_eq!(single("MEASURE: a 3").1, [observed(3.0, "", None)]);
+    assert_eq!(
+        single("MEASURE: a 3 higher-is-worse").1,
+        [observed(3.0, "", Some(Direction::Higher))]
+    );
+    // A direction word anywhere but last is part of the unit.
+    assert_eq!(
+        single("MEASURE: a 3 higher-is-worse m").1,
+        [observed(3.0, "higher-is-worse m", None)]
+    );
+}
+
+#[test]
+fn other_lines_are_not_read_and_a_bad_measure_line_is_refused_with_its_number() {
+    assert_eq!(
+        Measures::from_lines("gate: ok\nMEASURES: a 1 m\n"),
+        Ok(Measures::default())
+    );
+    for (text, why) in [
+        ("ok\nMEASURE: a", LineProblem::Shape),
+        ("ok\nMEASURE: a one m", LineProblem::Value("one".to_owned())),
+        ("ok\nMEASURE: a nan m", LineProblem::Value("nan".to_owned())),
+        ("ok\nMEASURE: a inf m", LineProblem::Value("inf".to_owned())),
+        (
+            "ok\nMEASURE: a 1e999 m",
+            LineProblem::Value("1e999".to_owned()),
+        ),
+    ] {
+        assert_eq!(
+            Measures::from_lines(text),
+            Err(LineError { line: 2, why }),
+            "{text}"
+        );
+    }
+}
+
+#[test]
+fn a_name_keeps_each_distinct_observation_once() {
+    let (_, observations) =
+        single("MEASURE: a 1 m\nMEASURE: a 1 m\nMEASURE: a 2 m\nMEASURE: a 1 mm\n");
+    assert_eq!(
+        observations,
+        [
+            observed(1.0, "m", None),
+            observed(2.0, "m", None),
+            observed(1.0, "mm", None)
+        ]
+    );
+}
+
+fn row(before: &str, after: &str) -> MeasureRow {
+    let sides = PerSide {
+        before: Measures::from_lines(before).expect("measures"),
+        after: Measures::from_lines(after).expect("measures"),
+    };
+    compare(&sides).into_iter().next().expect("a row")
+}
+
+#[test]
+fn each_comparison_has_its_verdict() {
+    assert_eq!(
+        row("MEASURE: a 1 m", "MEASURE: a 1 m").verdict,
+        Verdict::Same
+    );
+    assert_eq!(row("", "MEASURE: a 1 m").verdict, Verdict::New);
+    assert_eq!(row("MEASURE: a 1 m", "").verdict, Verdict::Gone);
+    assert_eq!(
+        row("MEASURE: a 1 m", "MEASURE: a 1 mm").verdict,
+        Verdict::UnitChanged
+    );
+    assert_eq!(
+        row("MEASURE: a 1 m\nMEASURE: a 2 m", "MEASURE: a 1 m").verdict,
+        Verdict::Conflict
+    );
+    assert_eq!(
+        row("MEASURE: a 4 m", "MEASURE: a 5 m").verdict,
+        Verdict::Moved {
+            change: Finite::new(1.0),
+            relative: Finite::new(0.25),
+            worse: None,
+        }
+    );
+}
+
+#[test]
+fn a_difference_that_cannot_be_represented_is_none_and_both_values_stay() {
+    // A zero before value has no relative change.
+    assert_eq!(
+        row("MEASURE: a 0 m", "MEASURE: a 2 m").verdict,
+        Verdict::Moved {
+            change: Finite::new(2.0),
+            relative: None,
+            worse: None,
+        }
+    );
+    // The difference of opposite extremes overflows.
+    let extreme = row(
+        "MEASURE: a -1.7e308 m higher-is-worse",
+        "MEASURE: a 1.7e308 m higher-is-worse",
+    );
+    assert_eq!(
+        extreme.verdict,
+        Verdict::Moved {
+            change: None,
+            relative: None,
+            worse: Some(Direction::Higher),
+        }
+    );
+    assert_eq!(
+        extreme.sides.before,
+        [observed(-1.7e308, "m", Some(Direction::Higher))]
+    );
+    // A tiny before value overflows the ratio.
+    assert_eq!(
+        row("MEASURE: a 1e-308 m", "MEASURE: a 1e308 m").verdict,
+        Verdict::Moved {
+            change: Finite::new(1e308),
+            relative: None,
+            worse: None,
+        }
+    );
+}
+
+#[test]
+fn a_measure_is_worse_only_the_way_its_line_says_and_a_side_without_a_direction_borrows_the_others()
+{
+    let worse = |before: &str, after: &str| match row(before, after).verdict {
+        Verdict::Moved { worse, .. } => worse,
+        other => panic!("not moved: {other:?}"),
+    };
+    assert_eq!(
+        worse(
+            "MEASURE: a 1 m higher-is-worse",
+            "MEASURE: a 2 m higher-is-worse"
+        ),
+        Some(Direction::Higher)
+    );
+    assert_eq!(
+        worse(
+            "MEASURE: a 2 m higher-is-worse",
+            "MEASURE: a 1 m higher-is-worse"
+        ),
+        None
+    );
+    assert_eq!(
+        worse(
+            "MEASURE: a 2 m lower-is-worse",
+            "MEASURE: a 1 m lower-is-worse"
+        ),
+        Some(Direction::Lower)
+    );
+    assert_eq!(worse("MEASURE: a 1 m", "MEASURE: a 2 m"), None);
+    assert_eq!(
+        worse("MEASURE: a 1 m", "MEASURE: a 2 m higher-is-worse"),
+        Some(Direction::Higher)
+    );
+    assert_eq!(
+        worse("MEASURE: a 1 m higher-is-worse", "MEASURE: a 2 m"),
+        Some(Direction::Higher)
+    );
+    let disagree = row(
+        "MEASURE: a 1 m higher-is-worse",
+        "MEASURE: a 2 m lower-is-worse",
+    );
+    assert!(disagree.directions_disagree());
+    // Either side's direction alone would call these worse. Together they disagree, so neither does.
+    assert_eq!(
+        worse(
+            "MEASURE: a 1 m lower-is-worse",
+            "MEASURE: a 2 m higher-is-worse"
+        ),
+        None
+    );
+    assert_eq!(
+        worse(
+            "MEASURE: a 2 m higher-is-worse",
+            "MEASURE: a 1 m lower-is-worse"
+        ),
+        None
+    );
+    assert_eq!(
+        worse(
+            "MEASURE: a 1 m higher-is-worse",
+            "MEASURE: a 2 m lower-is-worse"
+        ),
+        None
+    );
+}
+
+#[test]
+fn the_movement_marker_is_past_five_percent() {
+    assert!(!row("MEASURE: a 100 m", "MEASURE: a 105 m").flagged());
+    assert!(row("MEASURE: a 100 m", "MEASURE: a 105.5 m").flagged());
+    assert!(row("MEASURE: a 0 m", "MEASURE: a 0.001 m").flagged());
+    assert_eq!(
+        row("MEASURE: a 100 m", "MEASURE: a 99 m").change(),
+        "-1, 1.0%"
+    );
+}
+
+#[test]
+fn worse_measures_come_largest_relative_change_first_and_unrepresentable_ones_before_all() {
+    let sides = PerSide {
+        before: Measures::from_lines(
+            "MEASURE: small 100 m higher-is-worse\nMEASURE: big 1 m higher-is-worse\nMEASURE: zero 0 m higher-is-worse\n\
+             MEASURE: better 2 m higher-is-worse\n",
+        )
+        .expect("measures"),
+        after: Measures::from_lines(
+            "MEASURE: small 101 m higher-is-worse\nMEASURE: big 3 m higher-is-worse\nMEASURE: zero 1 m higher-is-worse\n\
+             MEASURE: better 1 m higher-is-worse\n",
+        )
+        .expect("measures"),
+    };
+    let rows = compare(&sides);
+    let names: Vec<&str> = worse(&rows).iter().map(|row| row.name().as_str()).collect();
+    assert_eq!(names, ["zero", "big", "small"]);
+}
+
+#[test]
+fn a_saved_record_round_trips_values_units_and_directions() {
+    let measures = Measures::from_lines(
+        "MEASURE: a 1.5 mm before closure lower-is-worse\nMEASURE: b 2 deg\nMEASURE: b 3 deg\n",
+    )
+    .expect("measures");
+    let saved = measures.saved();
+    let read = Measures::from_saved(&saved).expect("a record");
+    assert_eq!(read, measures);
+}
+
+#[test]
+fn earlier_reports_records_are_read_in_each_shape() {
+    let read = Measures::from_saved(
+        r#"{"a": [[1, "m"], [2.5, "m"]], "b": [3, "s"], "c": [[4, 5], "kg"]}"#,
+    )
+    .expect("a record");
+    let expected = Measures::from_lines(
+        "MEASURE: a 1 m\nMEASURE: a 2.5 m\nMEASURE: b 3 s\nMEASURE: c 4 kg\nMEASURE: c 5 kg\n",
+    )
+    .expect("measures");
+    assert_eq!(read, expected);
+    for text in [
+        r#"{"a": "1 m"}"#,
+        r#"{"a": [[1, 2]]}"#,
+        r#"{"format": "dandegate-measures-v9", "measures": {}}"#,
+        "[1]",
+        "{",
+    ] {
+        assert!(Measures::from_saved(text).is_err(), "{text}");
+    }
+}
+
+#[test]
+fn own_measures_replace_imported_names_and_merged_ones_add_to_them() {
+    let imported = Measures::from_lines("MEASURE: a 1 m\nMEASURE: b 1 m\n").expect("measures");
+    let own = Measures::from_lines("MEASURE: a 2 m\n").expect("measures");
+    let replaced = imported.clone().replaced_by(own.clone());
+    assert_eq!(
+        replaced.0[&MeasureName::new("a").expect("a name")],
+        [observed(2.0, "m", None)]
+    );
+    assert_eq!(
+        replaced.0[&MeasureName::new("b").expect("a name")],
+        [observed(1.0, "m", None)]
+    );
+    let merged = imported.merged(own);
+    assert_eq!(
+        merged.0[&MeasureName::new("a").expect("a name")],
+        [observed(1.0, "m", None), observed(2.0, "m", None)]
+    );
+}
+
+#[test]
+fn a_number_is_written_shortest_with_an_exponent_only_at_the_extremes() {
+    for (value, text) in [
+        (0.0, "0"),
+        (0.012, "0.012"),
+        (15.03, "15.03"),
+        (1e15, "1e15"),
+        (-1.7e308, "-1.7e308"),
+        (2e-6, "2e-6"),
+    ] {
+        assert_eq!(
+            Finite::new(value).expect("finite").to_string(),
+            text,
+            "{value}"
+        );
+    }
+}
