new file mode 100644
index 0000000000000000000000000000000000000000..ec1e6c618996f29007bbde6fcc54fe4d78e5d598
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/main.rs
@@ -0,0 +1,326 @@
+//! dandegate compares two revisions of a project and writes an HTML report of what changed.
+//!
+//! It resolves both revisions to commits and checks each one out. It runs the steps in the project's `dandegate.toml`
+//! in each checkout's own development shell, compares the images, measures and sections the steps write, and writes one
+//! page. A difference never fails the command. When a step fails or leaves partial evidence, the top of the page says
+//! that the report is incomplete.
+//!
+//! dandegate exits with 0 whenever it writes the page. It exits with 1 when it cannot write one, because the steps file
+//! cannot run, a revision names no commit, the command line names an input or step that the steps file does not
+//! declare, `--out` exists or is inside the repository, or dandegate cannot read the `--measures` or `--previous` file.
+//!
+//! dandegate knows revisions, steps, measures, images, sections, kept results and the page. It knows nothing about a
+//! project's domain. A project's own scripts, its adapters in the after revision's `dandegate/` folder, do that work.
+//! For a Rust workspace, dandegate adds the Rust reports as built-in steps ([`rust`]).
+//!
+//! dandegate runs steps on threads, not on an async runtime. It runs up to four steps at once, and runs exclusive steps
+//! last, one at a time. It runs every git operation with the `git` command and every step under `nix develop`.
+//!
+//! - [`plan`] reads the steps file once into checked types. No later code checks them again.
+//! - [`revision`] resolves the two revisions, with [`revision::git`].
+//! - [`report`] does one report's work, from the checkouts to the page.
+//! - [`compare`] compares the two sides' measures and images.
+//! - [`page`] writes the HTML.
+//! - [`rust`] runs the built-in Rust reports.
+
+mod compare;
+mod page;
+mod plan;
+mod report;
+mod revision;
+mod rust;
+
+use std::error::Error;
+use std::fs;
+use std::io::{self, Write as _};
+use std::process::ExitCode;
+
+use camino::{Utf8Path, Utf8PathBuf};
+use clap::Parser;
+
+use crate::compare::measure::{LineError, Measures, SavedError};
+use crate::plan::{Plan, PlanError};
+use crate::report::Request;
+use crate::revision::PerSide;
+use crate::revision::git::{Repository, ResolveError};
+
+/// The command line.
+#[derive(Debug, Parser)]
+#[command(
+    name = "dandegate",
+    version,
+    about = "Compares two revisions of a project and writes an HTML report of what changed. It fails nothing.",
+    long_about = LONG_ABOUT
+)]
+struct Arguments {
+    /// The revision the report starts from.
+    #[arg(long, value_name = "REVISION")]
+    before: String,
+    /// The revision the report ends at.
+    #[arg(long, value_name = "REVISION", default_value = "HEAD")]
+    after: String,
+    /// A new folder outside the repository for the page and everything it links.
+    #[arg(long, value_name = "FOLDER")]
+    out: Utf8PathBuf,
+    /// Optional steps to run, with everything they need.
+    #[arg(long, value_name = "STEP,...", value_delimiter = ',')]
+    with: Vec<String>,
+    /// A value for an input that dandegate.toml declares. Repeat it for each input.
+    #[arg(long = "input", value_name = "NAME=VALUE")]
+    inputs: Vec<String>,
+    /// Run every step afresh, replacing what is kept.
+    #[arg(long)]
+    no_reuse: bool,
+    /// A gate log or file of MEASURE lines for the after side. Steps find it in `DANDEGATE_MEASURES`.
+    #[arg(long, value_name = "FILE")]
+    measures: Option<Utf8PathBuf>,
+    /// An earlier report folder, its measures.json, or a gate log, for the before side's measures.
+    #[arg(long, value_name = "REPORT|FILE")]
+    previous: Option<Utf8PathBuf>,
+}
+
+const LONG_ABOUT: &str = "\
+Compares two revisions of a project and writes an HTML report of what changed.
+
+dandegate resolves both revisions to commits and checks each one out under the repository's .cache/dandegate/scratch/. \
+It reads dandegate.toml from the after revision and runs its steps in each checkout's `nix develop` shell. It \
+compares the images, measures and sections the steps write, and writes <out>/index.html, with every file it links \
+inside <out>. dandegate keeps each step's complete success in .cache/dandegate/ and reuses it while its identity \
+holds.
+
+It prints DANDEGATE-INCOMPLETE, DANDEGATE-MEASURE-CODE, DANDEGATE-WORSE, DANDEGATE-REUSED and DANDEGATE-STEP-FAILED \
+lines, then a DANDEGATE line naming the page. It exits with 0 whenever it writes the page, complete or not, with 1 \
+when it cannot write one, and with 2 for a malformed argument.";
+
+/// Why no page can be written.
+#[derive(Debug, thiserror::Error)]
+enum DandegateError {
+    #[error(transparent)]
+    Plan(PlanError),
+    #[error(transparent)]
+    Resolve(ResolveError),
+    #[error(transparent)]
+    Out(OutError),
+    #[error(transparent)]
+    Imported(ImportError),
+}
+
+/// Why `--out` cannot hold the report.
+#[derive(Debug, thiserror::Error)]
+enum OutError {
+    #[error("--out {0} exists; give a new folder")]
+    Exists(Utf8PathBuf),
+    #[error("--out {0} is inside the repository; give a folder outside it")]
+    Inside(Utf8PathBuf),
+    #[error("--out {0} cannot be made")]
+    Make(Utf8PathBuf, #[source] io::Error),
+    #[error("the current folder cannot be read or is not UTF-8")]
+    Current,
+}
+
+/// Why `--measures` or `--previous` cannot be read.
+#[derive(Debug, thiserror::Error)]
+enum ImportError {
+    #[error("{option} {file} cannot be read")]
+    Read {
+        option: &'static str,
+        file: Utf8PathBuf,
+        #[source]
+        source: io::Error,
+    },
+    #[error("{option} {file}")]
+    Line {
+        option: &'static str,
+        file: Utf8PathBuf,
+        #[source]
+        source: LineError,
+    },
+    #[error("--previous {file} is not a saved measures record")]
+    Saved {
+        file: Utf8PathBuf,
+        #[source]
+        source: SavedError,
+    },
+}
+
+fn main() -> ExitCode {
+    let arguments = Arguments::parse();
+    let executable = executable_digest();
+    match accept(&arguments, executable) {
+        Ok(request) => {
+            let finished = report::report(&request);
+            let mut out = io::stdout().lock();
+            for line in &finished.lines {
+                // If standard output closed early, only these lines are lost. The page exists.
+                let _ = writeln!(out, "{line}");
+            }
+            if finished.written {
+                ExitCode::SUCCESS
+            } else {
+                ExitCode::FAILURE
+            }
+        }
+        Err(error) => {
+            render(&error);
+            ExitCode::FAILURE
+        }
+    }
+}
+
+/// The digest of the running executable, which every kept result's identity holds.
+fn executable_digest() -> Result<String, String> {
+    let path = std::env::current_exe().map_err(|error| error.to_string())?;
+    let path = Utf8PathBuf::try_from(path).map_err(|error| error.to_string())?;
+    report::store::file_sha256(&path)
+        .map_err(|error| format!("dandegate's own executable cannot be read: {error}"))
+}
+
+/// The command line accepted, the revisions resolved, the plan read and the output folder made: everything that can
+/// stop a page, before any step runs.
+fn accept(
+    arguments: &Arguments,
+    executable: Result<String, String>,
+) -> Result<Request, DandegateError> {
+    let current = std::env::current_dir()
+        .ok()
+        .and_then(|folder| Utf8PathBuf::try_from(folder).ok())
+        .ok_or(DandegateError::Out(OutError::Current))?;
+    let repository = Repository::discover(&current).map_err(DandegateError::Resolve)?;
+    let revisions = PerSide {
+        before: repository
+            .resolve(&arguments.before)
+            .map_err(DandegateError::Resolve)?,
+        after: repository
+            .resolve(&arguments.after)
+            .map_err(DandegateError::Resolve)?,
+    };
+    let out = new_folder(&current.join(&arguments.out), repository.root())
+        .map_err(DandegateError::Out)?;
+    let measures_file = arguments
+        .measures
+        .as_ref()
+        .map(|file| current.join(file))
+        .map(|file| {
+            file.canonicalize_utf8()
+                .map_err(|source| read_error("--measures", &file, source))
+        })
+        .transpose()
+        .map_err(DandegateError::Imported)?;
+    let after = match &measures_file {
+        None => Measures::default(),
+        Some(file) => gate_log("--measures", file).map_err(DandegateError::Imported)?,
+    };
+    let before = match &arguments.previous {
+        None => Measures::default(),
+        Some(previous) => {
+            previous_measures(&current.join(previous)).map_err(DandegateError::Imported)?
+        }
+    };
+    let file = Utf8Path::new("dandegate.toml");
+    let text = repository
+        .file_at(revisions.after.commit(), file.as_str())
+        .map_err(|cause| {
+            DandegateError::Resolve(ResolveError::Unresolved {
+                requested: arguments.after.clone(),
+                cause,
+            })
+        })?
+        .unwrap_or_default();
+    let workspaces = rust::workspaces(&repository, revisions.after.commit()).map_err(|cause| {
+        DandegateError::Resolve(ResolveError::Unresolved {
+            requested: arguments.after.clone(),
+            cause,
+        })
+    })?;
+    let plan = Plan::read(&text, file, &arguments.with, &arguments.inputs, &workspaces)
+        .map_err(DandegateError::Plan)?;
+    fs::create_dir_all(&out)
+        .map_err(|source| DandegateError::Out(OutError::Make(out.clone(), source)))?;
+    Ok(Request {
+        repository,
+        revisions,
+        plan,
+        out,
+        no_reuse: arguments.no_reuse,
+        measures_file,
+        imported: PerSide { before, after },
+        executable,
+    })
+}
+
+fn read_error(option: &'static str, file: &Utf8Path, source: io::Error) -> ImportError {
+    ImportError::Read {
+        option,
+        file: file.to_owned(),
+        source,
+    }
+}
+
+/// The `MEASURE:` lines of a gate log.
+fn gate_log(option: &'static str, file: &Utf8Path) -> Result<Measures, ImportError> {
+    let text = fs::read_to_string(file).map_err(|source| read_error(option, file, source))?;
+    Measures::from_lines(&text).map_err(|source| ImportError::Line {
+        option,
+        file: file.to_owned(),
+        source,
+    })
+}
+
+/// The before side's measures from an earlier report's folder, its saved record, or a gate log.
+fn previous_measures(previous: &Utf8Path) -> Result<Measures, ImportError> {
+    let saved = if previous.is_dir() {
+        previous.join("measures.json")
+    } else if previous.extension() == Some("json") {
+        previous.to_owned()
+    } else {
+        return gate_log("--previous", previous);
+    };
+    let text =
+        fs::read_to_string(&saved).map_err(|source| read_error("--previous", &saved, source))?;
+    Measures::from_saved(&text).map_err(|source| ImportError::Saved {
+        file: saved,
+        source,
+    })
+}
+
+/// `folder`, absolute, when it does not exist and is outside the repository.
+fn new_folder(folder: &Utf8Path, repository: &Utf8Path) -> Result<Utf8PathBuf, OutError> {
+    if folder.symlink_metadata().is_ok() {
+        return Err(OutError::Exists(folder.to_owned()));
+    }
+    let mut existing = folder.to_owned();
+    let mut rest = Vec::new();
+    while !existing.exists() {
+        let (Some(parent), Some(name)) = (existing.parent(), existing.file_name()) else {
+            break;
+        };
+        rest.push(name.to_owned());
+        existing = parent.to_owned();
+    }
+    let mut resolved = existing
+        .canonicalize_utf8()
+        .unwrap_or_else(|_| existing.clone());
+    for part in rest.iter().rev() {
+        resolved.push(part);
+    }
+    let repository = repository
+        .canonicalize_utf8()
+        .unwrap_or_else(|_| repository.to_owned());
+    if resolved.starts_with(&repository) {
+        return Err(OutError::Inside(folder.to_owned()));
+    }
+    Ok(resolved)
+}
+
+/// The error and each of its causes, once, on standard error.
+fn render(error: &DandegateError) {
+    let mut errors = io::stderr().lock();
+    let mut cause: Option<&dyn Error> = Some(error);
+    let mut lead = "dandegate: ";
+    while let Some(found) = cause {
+        // Standard error is where a failure to write is reported, so a failure to write there has nowhere to go.
+        let _ = writeln!(errors, "{lead}{found}");
+        lead = "  caused by: ";
+        cause = found.source();
+    }
+}
diff --git a/tools/rust/crates/dandegate/src/page.rs b/tools/rust/crates/dandegate/src/page.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4f4ba03c77f21a24ab461f025ee9e5d0615140ee
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/page.rs
@@ -0,0 +1,365 @@
+//! Writes the report's page, `index.html`. The page is plain HTML with its style inline. It loads nothing from outside,
+//! reads in light and dark themes, and links only to files inside the output folder.
+//!
+//! The page's sections, in order, are what makes the report incomplete, the measuring-code warning, the measures that
+//! got worse, every step's outcome, what dandegate reused or kept, the steps' sections, every measure, and the images.
+
+use std::fmt::Write as _;
+
+use crate::compare::image::{Cell, ImageState};
+use crate::compare::measure::MeasureRow;
+use crate::revision::{PerSide, Revision, Side};
+
+/// One step instance's row.
+#[derive(Debug)]
+pub(crate) struct Shown {
+    pub(crate) place: String,
+    pub(crate) step: String,
+    pub(crate) outcome: String,
+    pub(crate) failed: bool,
+    /// Its log, relative to the output folder, when it has one.
+    pub(crate) log: Option<String>,
+    /// What happened about reuse, for a reusable step.
+    pub(crate) reuse: Option<String>,
+}
+
+/// One linked section.
+#[derive(Debug)]
+pub(crate) struct Section {
+    pub(crate) title: String,
+    /// The file, relative to the output folder.
+    pub(crate) link: String,
+    pub(crate) text: Option<String>,
+    pub(crate) problem: Option<String>,
+}
+
+/// One step's images: each side's folder, relative to the output folder, and the cells.
+#[derive(Debug)]
+pub(crate) struct Images {
+    pub(crate) step: String,
+    pub(crate) folders: PerSide<String>,
+    pub(crate) cells: Vec<Cell>,
+}
+
+/// Everything the page shows.
+#[derive(Debug)]
+pub(crate) struct Page<'a> {
+    pub(crate) revisions: &'a PerSide<Revision>,
+    pub(crate) incomplete: &'a [String],
+    pub(crate) measure_code: Option<&'a [String]>,
+    pub(crate) measure_code_error: Option<&'a str>,
+    pub(crate) affected: &'a [&'a MeasureRow],
+    pub(crate) worse: &'a [&'a MeasureRow],
+    pub(crate) steps: &'a [Shown],
+    pub(crate) sections: &'a [Section],
+    pub(crate) measures: &'a [MeasureRow],
+    pub(crate) images: &'a [Images],
+}
+
+const STYLE: &str = "<style>
+:root { color-scheme: light dark; --text: #1d1d1f; --muted: #5f5f66; --background: #fbfbfa; --line: #d4d4d8;
+  --warn: #b42318; --warn-background: #fdecea; }
+@media (prefers-color-scheme: dark) {
+  :root { --text: #ececee; --muted: #a1a1aa; --background: #18181b; --line: #3f3f46; --warn: #f97066;
+    --warn-background: #3a1714; }
+}
+body { font: 15px/1.5 system-ui, sans-serif; margin: 0 auto; padding: 16px; max-width: 72rem; color: var(--text);
+  background: var(--background); }
+h1 { font-size: 1.4rem; } h2 { font-size: 1.15rem; margin-top: 2rem; }
+table { border-collapse: collapse; display: block; overflow-x: auto; }
+td, th { border: 1px solid var(--line); padding: 3px 8px; text-align: left; vertical-align: top; }
+pre { overflow-x: auto; border: 1px solid var(--line); padding: 8px; }
+code, pre { font: 13px/1.4 ui-monospace, monospace; }
+.incomplete, .warning { border: 2px solid var(--warn); background: var(--warn-background); padding: 6px 12px; }
+.failed td { color: var(--warn); }
+.muted { color: var(--muted); }
+figure { margin: 16px 0; } figcaption { margin-bottom: 4px; }
+.pair { display: flex; gap: 8px; flex-wrap: wrap; } .pair > * { flex: 1 1 18rem; min-width: 0; }
+img { max-width: 100%; border: 1px solid var(--line); }
+</style>";
+
+/// Text made safe inside HTML.
+fn escape(text: &str) -> String {
+    let mut escaped = String::with_capacity(text.len());
+    for character in text.chars() {
+        match character {
+            '&' => escaped.push_str("&amp;"),
+            '<' => escaped.push_str("&lt;"),
+            '>' => escaped.push_str("&gt;"),
+            '"' => escaped.push_str("&quot;"),
+            '\'' => escaped.push_str("&#39;"),
+            other => escaped.push(other),
+        }
+    }
+    escaped
+}
+
+fn table(html: &mut String, header: &[&str], rows: impl IntoIterator<Item = (bool, Vec<String>)>) {
+    html.push_str("<table><tr>");
+    for cell in header {
+        let _ = write!(html, "<th>{}</th>", escape(cell));
+    }
+    html.push_str("</tr>\n");
+    for (failed, cells) in rows {
+        html.push_str(if failed {
+            "<tr class=\"failed\">"
+        } else {
+            "<tr>"
+        });
+        for cell in cells {
+            let _ = write!(html, "<td>{cell}</td>");
+        }
+        html.push_str("</tr>\n");
+    }
+    html.push_str("</table>\n");
+}
+
+fn observations(row: &MeasureRow, side: Side) -> String {
+    escape(
+        &row.sides()[side]
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join(" | "),
+    )
+}
+
+fn measure_rows<'a>(rows: impl IntoIterator<Item = &'a MeasureRow>) -> Vec<(bool, Vec<String>)> {
+    rows.into_iter()
+        .map(|row| {
+            (
+                false,
+                vec![
+                    format!("<code>{}</code>", escape(row.name().as_str())),
+                    observations(row, Side::Before),
+                    observations(row, Side::After),
+                    escape(&row.change()),
+                ],
+            )
+        })
+        .collect()
+}
+
+/// The page's HTML.
+pub(crate) fn render(page: &Page<'_>) -> String {
+    let title = format!(
+        "Changes from {} to {}",
+        page.revisions.before, page.revisions.after
+    );
+    let mut html = format!(
+        "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\
+         <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{0}</title>\n{STYLE}</head>\n\
+         <body>\n<h1>{0}</h1>\n",
+        escape(&title)
+    );
+    incomplete(&mut html, page.incomplete);
+    measure_code(&mut html, page);
+    worse(&mut html, page.worse);
+    steps(&mut html, page.steps);
+    sections(&mut html, page.sections);
+    measures(&mut html, page.measures);
+    for images in page.images {
+        let _ = writeln!(
+            html,
+            "<h2 id=\"images-{0}\">Images: {0}</h2>\n<p>Each number is the mean absolute \
+             difference of the two images' RGBA samples, from 0 to 255, and 255 when their sizes differ. Missing, \
+             unexpected and unreadable images come first, then the largest differences.</p>",
+            escape(&images.step)
+        );
+        for cell in &images.cells {
+            figure(&mut html, &images.folders, cell);
+        }
+    }
+    html.push_str("</body></html>\n");
+    html
+}
+
+fn incomplete(html: &mut String, reasons: &[String]) {
+    if reasons.is_empty() {
+        return;
+    }
+    html.push_str(
+        "<div class=\"incomplete\" id=\"incomplete\"><p><strong>Incomplete.</strong> Read what follows as partial \
+         evidence, not as \"nothing changed\":</p><ul>\n",
+    );
+    for reason in reasons {
+        let _ = writeln!(html, "<li>{}</li>", escape(reason));
+    }
+    html.push_str("</ul></div>\n");
+}
+
+fn measure_code(html: &mut String, page: &Page<'_>) {
+    if let Some(error) = page.measure_code_error {
+        let _ = writeln!(
+            html,
+            "<div class=\"warning\" id=\"measure-code\"><p>dandegate could not tell whether the \
+             measuring code differs: {}</p></div>",
+            escape(error)
+        );
+    }
+    let Some(files) = page.measure_code.filter(|files| !files.is_empty()) else {
+        return;
+    };
+    let listed: Vec<String> = files
+        .iter()
+        .map(|file| format!("<code>{}</code>", escape(file)))
+        .collect();
+    let _ = write!(
+        html,
+        "<div class=\"warning\" id=\"measure-code\"><p>The measuring code differs between the revisions, so a \
+         measure can move with the code rather than with what it measures: {}.</p>",
+        listed.join(", ")
+    );
+    if page.affected.is_empty() {
+        html.push_str("<p>No measure it takes moved.</p>");
+    } else {
+        let names: Vec<String> = page
+            .affected
+            .iter()
+            .map(|row| format!("<code>{}</code>", escape(row.name().as_str())))
+            .collect();
+        let _ = write!(
+            html,
+            "<p>Measures it takes that moved: {}.</p>",
+            names.join(", ")
+        );
+    }
+    html.push_str("</div>\n");
+}
+
+fn worse(html: &mut String, rows: &[&MeasureRow]) {
+    html.push_str("<h2 id=\"worse\">Got worse</h2>\n");
+    if rows.is_empty() {
+        html.push_str("<p>No measure moved the way its line says is worse.</p>\n");
+    } else {
+        html.push_str("<p>Measures that moved the way their line says is worse, largest relative change first.</p>\n");
+        table(
+            html,
+            &["Measure", "Before", "After", "Change"],
+            measure_rows(rows.iter().copied()),
+        );
+    }
+}
+
+fn steps(html: &mut String, shown: &[Shown]) {
+    html.push_str("<h2 id=\"steps\">Steps</h2>\n");
+    table(
+        html,
+        &["Side", "Step", "Outcome", "Log"],
+        shown.iter().map(|shown| {
+            let log = shown.log.as_ref().map_or_else(String::new, |log| {
+                format!("<a href=\"{0}\">{0}</a>", escape(log))
+            });
+            (
+                shown.failed,
+                vec![
+                    escape(&shown.place),
+                    escape(&shown.step),
+                    escape(&shown.outcome),
+                    log,
+                ],
+            )
+        }),
+    );
+    let reused: Vec<&Shown> = shown.iter().filter(|shown| shown.reuse.is_some()).collect();
+    if reused.is_empty() {
+        return;
+    }
+    html.push_str(
+        "<h2 id=\"reuse\">Reuse</h2>\n<p>dandegate keeps each reusable step's complete success in the \
+         repository's <code>.cache/dandegate/</code>, under the identity of everything the result depends on. \
+         <code>--no-reuse</code> runs every step afresh.</p>\n",
+    );
+    table(
+        html,
+        &["Side", "Step", "Reuse"],
+        reused.iter().map(|shown| {
+            (
+                false,
+                vec![
+                    escape(&shown.place),
+                    escape(&shown.step),
+                    escape(shown.reuse.as_deref().unwrap_or_default()),
+                ],
+            )
+        }),
+    );
+}
+
+fn sections(html: &mut String, sections: &[Section]) {
+    if sections.is_empty() {
+        return;
+    }
+    html.push_str("<h2 id=\"sections\">Sections</h2>\n");
+    for section in sections {
+        let _ = write!(
+            html,
+            "<h3>{}</h3>\n<p><a href=\"{1}\">{1}</a>",
+            escape(&section.title),
+            escape(&section.link)
+        );
+        if let Some(problem) = &section.problem {
+            let _ = write!(
+                html,
+                " <strong class=\"failed\">{}</strong>",
+                escape(problem)
+            );
+        }
+        html.push_str("</p>\n");
+        if let Some(text) = &section.text {
+            let _ = writeln!(html, "<pre>{}</pre>", escape(text));
+        }
+    }
+}
+
+fn measures(html: &mut String, rows: &[MeasureRow]) {
+    html.push_str("<h2 id=\"measures\">Measures</h2>\n");
+    if rows.is_empty() {
+        html.push_str("<p>No measures on either side.</p>\n");
+    } else {
+        html.push_str(
+            "<p>Moved means more than 5% from the before value. It marks movement, not significance. A side with no \
+             direction borrows the other side's direction.</p>\n",
+        );
+        table(
+            html,
+            &["Measure", "Before", "After", "Change"],
+            measure_rows(rows),
+        );
+    }
+}
+
+fn figure(html: &mut String, folders: &PerSide<String>, cell: &Cell) {
+    let mut notes: Vec<String> = cell.problems().iter().map(ToString::to_string).collect();
+    if let Some(difference) = cell.difference() {
+        notes.push(format!("{:.2}", difference.get()));
+    }
+    let _ = write!(
+        html,
+        "<figure><figcaption><code>{}</code>: {}</figcaption><div class=\"pair\">",
+        escape(cell.name()),
+        escape(&notes.join("; "))
+    );
+    for side in Side::BOTH {
+        match &cell.image()[side] {
+            ImageState::Absent => {
+                let _ = write!(
+                    html,
+                    "<span class=\"muted\">no {} image</span>",
+                    side.as_str()
+                );
+            }
+            ImageState::Unreadable(_) | ImageState::Readable { .. } => {
+                let _ = write!(
+                    html,
+                    "<img src=\"{}/{}\" alt=\"{} {}\">",
+                    escape(&folders[side]),
+                    escape(cell.name()),
+                    side.as_str(),
+                    escape(cell.name())
+                );
+            }
+        }
+    }
+    html.push_str("</div></figure>\n");
+}
diff --git a/tools/rust/crates/dandegate/src/plan.rs b/tools/rust/crates/dandegate/src/plan.rs
new file mode 100644
index 0000000000000000000000000000000000000000..16ecfa1c32f6d3a54c3c7f07d4c1b01c86b26bca
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/plan.rs
@@ -0,0 +1,532 @@
+//! Reads `dandegate.toml` from the after revision into a checked plan, once, and applies the command line's `--with`
+//! and `--input`. Every refusal names the file and line, or the option, and the field.
+//!
+//! A plan guarantees these facts to the code that reads it:
+//!
+//! - Every step name is unique, and none is reserved.
+//! - Every placeholder is one that the step's kind has, and every input it names is declared.
+//! - Every output is a plain path under `{out}`, of a kind that the step can write.
+//! - Every need names a step of a kind that the needing step can wait for. The needs have no cycle, and no ordinary
+//!   step needs an exclusive one, since exclusive steps run after every other step.
+//! - The enabled steps are the ordinary steps, the steps that `--with` names, and every step they need.
+//!
+//! A per-revision step can need per-revision steps, on its own side. An after step can need per-revision steps, on the
+//! after side, or after steps. A once step can need any step, on every side that step runs.
+//!
+//! When the after revision has a Cargo workspace, the plan adds the Rust reports as built-in steps under reserved names
+//! ([`Report`]). `[rust]` gives them their arguments.
+//!
+//! This module holds the types that the rest of dandegate reads. [`read`] builds them from the file's TOML shapes in
+//! [`raw`]. [`template`] parses each command word's placeholders, and [`error`] holds every refusal.
+
+mod error;
+mod raw;
+mod read;
+mod template;
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+use std::time::Duration;
+
+use camino::{Utf8Component, Utf8Path, Utf8PathBuf};
+use indexmap::IndexMap;
+
+pub(crate) use crate::plan::error::PlanError;
+pub(crate) use crate::plan::template::{
+    Arg, Expansion, PairArg, PairValues, Template, TreeArg, TreeValues,
+};
+
+/// How long a step may run when it does not say.
+pub(crate) const DEFAULT_TIMEOUT: Duration = Duration::from_mins(15);
+/// How long the mutation report may run: a campaign's length grows with the change, well past an ordinary step's.
+const MUTANTS_TIMEOUT: Duration = Duration::from_hours(2);
+/// The environment variables every reusable step's identity holds, before its own.
+const IDENTITY_ENV: [&str; 3] = ["CARGO*", "RUST*", "LD_LIBRARY_PATH"];
+
+/// A step's name: lowercase letters, digits and hyphens.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) struct StepName(Box<str>);
+
+/// An input's name, as `{input.<name>}` and `--input <name>=` write it: lowercase letters, digits and hyphens.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) struct InputName(Box<str>);
+
+/// A name that is not lowercase letters, digits and hyphens.
+#[derive(Debug, thiserror::Error)]
+#[error("{0:?} is not lowercase letters, digits and hyphens")]
+pub(crate) struct BadName(String);
+
+fn checked_name(text: &str) -> Result<Box<str>, BadName> {
+    let allowed = |character: char| {
+        character.is_ascii_lowercase() || character.is_ascii_digit() || character == '-'
+    };
+    if !text.is_empty() && text.chars().all(allowed) {
+        Ok(text.into())
+    } else {
+        Err(BadName(text.to_owned()))
+    }
+}
+
+impl StepName {
+    /// # Errors
+    /// [`BadName`] for an empty name or one with another character.
+    pub(crate) fn new(text: &str) -> Result<Self, BadName> {
+        checked_name(text).map(Self)
+    }
+
+    pub(crate) fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl InputName {
+    /// # Errors
+    /// [`BadName`] for an empty name or one with another character.
+    pub(crate) fn new(text: &str) -> Result<Self, BadName> {
+        checked_name(text).map(Self)
+    }
+}
+
+impl fmt::Display for StepName {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.0)
+    }
+}
+
+impl fmt::Display for InputName {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.0)
+    }
+}
+
+/// A declared input: its value for this run, the default unless `--input` set it, and its help.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Input {
+    value: String,
+    help: String,
+}
+
+impl Input {
+    pub(crate) fn new(value: String, help: String) -> Self {
+        Self { value, help }
+    }
+
+    pub(crate) fn value(&self) -> &str {
+        &self.value
+    }
+}
+
+/// An environment variable's name.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) struct EnvName(Box<str>);
+
+impl EnvName {
+    fn new(text: &str) -> Option<Self> {
+        let mut characters = text.chars();
+        let first = characters.next()?;
+        let valid = (first.is_ascii_alphabetic() || first == '_')
+            && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
+            && !text.starts_with("DANDEGATE_");
+        valid.then(|| Self(text.into()))
+    }
+
+    pub(crate) fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+/// Environment variables a step's identity holds: a name, or a prefix ending in `*`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct EnvPattern {
+    prefix: Box<str>,
+    whole: bool,
+}
+
+impl EnvPattern {
+    fn new(text: &str) -> Option<Self> {
+        let (name, whole) = match text.strip_suffix('*') {
+            Some(prefix) => (prefix, false),
+            None => (text, true),
+        };
+        let valid = !name.is_empty()
+            && name
+                .chars()
+                .all(|character| character.is_ascii_alphanumeric() || character == '_');
+        valid.then(|| Self {
+            prefix: name.into(),
+            whole,
+        })
+    }
+
+    pub(crate) fn matches(&self, name: &str) -> bool {
+        if self.whole {
+            name == &*self.prefix
+        } else {
+            name.starts_with(&*self.prefix)
+        }
+    }
+
+    pub(crate) fn written(&self) -> String {
+        if self.whole {
+            self.prefix.to_string()
+        } else {
+            format!("{}*", self.prefix)
+        }
+    }
+}
+
+/// A path inside a step's output folder: relative, with only ordinary parts.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct OutPath(Utf8PathBuf);
+
+impl OutPath {
+    fn new(text: &str) -> Option<Self> {
+        let path = Utf8Path::new(text);
+        let plain = path
+            .components()
+            .all(|part| matches!(part, Utf8Component::Normal(_)));
+        (plain && path.components().next().is_some()).then(|| Self(path.to_owned()))
+    }
+
+    pub(crate) fn as_path(&self) -> &Utf8Path {
+        &self.0
+    }
+}
+
+/// What a step leaves in its output folder for the page.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Output {
+    /// PNGs in `folder`, compared by name with the other side's. `expected` lists the names the step says must
+    /// exist, one a line.
+    Images { folder: OutPath, expected: OutPath },
+    /// `MEASURE: <name> <value> <unit> [higher-is-worse|lower-is-worse]` lines.
+    Measures { from: OutPath },
+    /// A Markdown file linked from the page, with its status beside it in `<file>.status`.
+    Section { file: OutPath },
+}
+
+/// The measuring code the page warns about when it differs between the two commits.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct MeasureRules {
+    pub(crate) code: Vec<String>,
+    pub(crate) exclude: Vec<String>,
+    pub(crate) code_measures: Vec<String>,
+}
+
+/// The Rust reports' settings.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct RustSettings {
+    /// The workspace folder under the repository, `.` at its root.
+    pub(crate) workspace: Utf8PathBuf,
+    /// rust-scans' arguments besides `--workspace`.
+    pub(crate) scans: Vec<String>,
+    /// cargo-mutants' arguments, after `--`.
+    pub(crate) mutation: Vec<String>,
+}
+
+/// A Rust report, run as a step under its reserved name.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Report {
+    /// Both revisions' rust-scans findings and counts, side by side. It fails nothing.
+    Scans,
+    /// Each crate's production and test lines at both revisions.
+    Lines,
+    /// The mutation report of the Rust changed since the before commit, in the after checkout.
+    Mutants,
+    /// One revision's public API listing of each library crate, which the API diff reads.
+    ApiListings,
+    /// The public API diff of each library crate between the revisions.
+    Api,
+}
+
+impl Report {
+    const ALL: [Self; 5] = [
+        Self::Scans,
+        Self::Lines,
+        Self::Mutants,
+        Self::ApiListings,
+        Self::Api,
+    ];
+
+    /// The report's step.
+    pub(crate) fn step(self) -> StepName {
+        StepName(self.name().into())
+    }
+
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            Self::Scans => "scans",
+            Self::Lines => "lines",
+            Self::Mutants => "mutants",
+            Self::ApiListings => "api-listings",
+            Self::Api => "api",
+        }
+    }
+}
+
+/// What a step does when it runs.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Work<A> {
+    /// The project's command, run in the measured checkout's development shell.
+    Command(Vec<Template<A>>),
+    /// A built-in Rust report.
+    Rust(Report),
+}
+
+/// A step's command and the values it fills in, typed by the placeholders its kind has.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Recipe<A> {
+    work: Work<A>,
+    env: BTreeMap<EnvName, Template<A>>,
+    collect: Option<Vec<Template<A>>>,
+}
+
+impl<A: Arg> Recipe<A> {
+    pub(crate) fn work(&self) -> &Work<A> {
+        &self.work
+    }
+
+    pub(crate) fn env(&self) -> &BTreeMap<EnvName, Template<A>> {
+        &self.env
+    }
+
+    fn report(&self) -> Option<Report> {
+        match &self.work {
+            Work::Rust(report) => Some(*report),
+            Work::Command(_) => None,
+        }
+    }
+
+    /// The identity collector's command, if the step names one.
+    pub(crate) fn collect(&self) -> Option<&[Template<A>]> {
+        self.collect.as_deref()
+    }
+
+    fn templates(&self) -> impl Iterator<Item = &Template<A>> {
+        let run = match &self.work {
+            Work::Command(run) => &run[..],
+            Work::Rust(_) => &[],
+        };
+        run.iter()
+            .chain(self.env.values())
+            .chain(self.collect.iter().flatten())
+    }
+}
+
+/// How many times a step runs and what it is given.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Runs {
+    /// Once for each revision, in its own checkout.
+    PerRevision(Recipe<TreeArg>),
+    /// Only for the after revision.
+    After(Recipe<TreeArg>),
+    /// Once, given both checkouts, in the after one.
+    Once(Recipe<PairArg>),
+}
+
+/// The kind of a step, without its recipe.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Kind {
+    PerRevision,
+    After,
+    Once,
+}
+
+impl Kind {
+    /// The kind with its article, as a sentence names it.
+    fn with_article(self) -> &'static str {
+        match self {
+            Self::PerRevision => "a per-revision",
+            Self::After => "an after",
+            Self::Once => "a once",
+        }
+    }
+
+    /// Whether a step of this kind can wait for one of `need`'s kind.
+    fn can_need(self, need: Self) -> bool {
+        match self {
+            Self::PerRevision => need == Self::PerRevision,
+            Self::After => need != Self::Once,
+            Self::Once => true,
+        }
+    }
+}
+
+impl Runs {
+    pub(crate) fn kind(&self) -> Kind {
+        match self {
+            Self::PerRevision(_) => Kind::PerRevision,
+            Self::After(_) => Kind::After,
+            Self::Once(_) => Kind::Once,
+        }
+    }
+
+    fn inputs(&self) -> BTreeSet<&InputName> {
+        match self {
+            Self::PerRevision(recipe) | Self::After(recipe) => {
+                recipe.templates().flat_map(Template::inputs).collect()
+            }
+            Self::Once(recipe) => recipe.templates().flat_map(Template::inputs).collect(),
+        }
+    }
+}
+
+/// One step of the plan.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[expect(
+    clippy::struct_excessive_bools,
+    reason = "live, enabled, reuse and exclusive are independent switches; every combination is a valid step"
+)]
+pub(crate) struct Step {
+    runs: Runs,
+    needs: Vec<StepName>,
+    live: bool,
+    enabled: bool,
+    reuse: bool,
+    exclusive: bool,
+    timeout: Duration,
+    identity_env: Vec<EnvPattern>,
+    outputs: Vec<Output>,
+}
+
+impl Step {
+    pub(crate) fn runs(&self) -> &Runs {
+        &self.runs
+    }
+
+    pub(crate) fn kind(&self) -> Kind {
+        self.runs.kind()
+    }
+
+    pub(crate) fn needs(&self) -> &[StepName] {
+        &self.needs
+    }
+
+    /// Whether the step needs its needs' real checkouts from this run, so they run fresh for the sides it uses.
+    pub(crate) fn live(&self) -> bool {
+        self.live
+    }
+
+    /// Whether the step runs at all: an ordinary step, one `--with` names, or one an enabled step needs.
+    pub(crate) fn enabled(&self) -> bool {
+        self.enabled
+    }
+
+    pub(crate) fn reuse(&self) -> bool {
+        self.reuse
+    }
+
+    pub(crate) fn exclusive(&self) -> bool {
+        self.exclusive
+    }
+
+    pub(crate) fn timeout(&self) -> Duration {
+        self.timeout
+    }
+
+    /// The environment variables, by name or prefix, the step's identity holds.
+    pub(crate) fn identity_env(&self) -> &[EnvPattern] {
+        &self.identity_env
+    }
+
+    pub(crate) fn outputs(&self) -> &[Output] {
+        &self.outputs
+    }
+
+    /// The inputs the step's templates use.
+    pub(crate) fn inputs(&self) -> BTreeSet<&InputName> {
+        self.runs.inputs()
+    }
+
+    /// The built-in Rust report the step runs, if it is one.
+    pub(crate) fn report(&self) -> Option<Report> {
+        match &self.runs {
+            Runs::PerRevision(recipe) | Runs::After(recipe) => recipe.report(),
+            Runs::Once(recipe) => recipe.report(),
+        }
+    }
+
+    /// The environment variables the step sets.
+    pub(crate) fn env_names(&self) -> BTreeSet<&str> {
+        match &self.runs {
+            Runs::PerRevision(recipe) | Runs::After(recipe) => {
+                recipe.env.keys().map(EnvName::as_str).collect()
+            }
+            Runs::Once(recipe) => recipe.env.keys().map(EnvName::as_str).collect(),
+        }
+    }
+
+    /// The step as written, placeholders by name, as a value its kept results' identity holds. The name, whether it
+    /// is optional or reusable and its timeout are left out, since none changes what a successful run produces.
+    pub(crate) fn written(&self) -> serde_json::Value {
+        fn recipe<A: Arg>(recipe: &Recipe<A>) -> serde_json::Value {
+            let work = match recipe.work() {
+                Work::Command(run) => {
+                    serde_json::json!({ "run": run.iter().map(Template::written).collect::<Vec<_>>() })
+                }
+                Work::Rust(report) => serde_json::json!({ "rust": report.name() }),
+            };
+            let env: BTreeMap<&str, String> = recipe
+                .env()
+                .iter()
+                .map(|(name, value)| (name.as_str(), value.written()))
+                .collect();
+            let collect = recipe
+                .collect()
+                .map(|collect| collect.iter().map(Template::written).collect::<Vec<_>>());
+            serde_json::json!({ "work": work, "env": env, "collect": collect })
+        }
+        let recipe = match &self.runs {
+            Runs::PerRevision(written) | Runs::After(written) => recipe(written),
+            Runs::Once(written) => recipe(written),
+        };
+        let outputs: Vec<serde_json::Value> = self
+            .outputs
+            .iter()
+            .map(|output| match output {
+                Output::Images { folder, expected } => {
+                    serde_json::json!({ "images": folder.as_path().as_str(), "expected": expected.as_path().as_str() })
+                }
+                Output::Measures { from } => serde_json::json!({ "measures": from.as_path().as_str() }),
+                Output::Section { file } => serde_json::json!({ "section": file.as_path().as_str() }),
+            })
+            .collect();
+        serde_json::json!({
+            "recipe": recipe,
+            "needs": self.needs.iter().map(StepName::as_str).collect::<Vec<_>>(),
+            "live": self.live,
+            "exclusive": self.exclusive,
+            "identity-env": self.identity_env.iter().map(EnvPattern::written).collect::<Vec<_>>(),
+            "outputs": outputs,
+        })
+    }
+}
+
+/// The steps file read into checked values, with the command line applied.
+#[derive(Clone, Debug)]
+pub(crate) struct Plan {
+    inputs: IndexMap<InputName, Input>,
+    steps: IndexMap<StepName, Step>,
+    measures: MeasureRules,
+    rust: Option<RustSettings>,
+}
+
+impl Plan {
+    pub(crate) fn inputs(&self) -> &IndexMap<InputName, Input> {
+        &self.inputs
+    }
+
+    pub(crate) fn steps(&self) -> &IndexMap<StepName, Step> {
+        &self.steps
+    }
+
+    pub(crate) fn measures(&self) -> &MeasureRules {
+        &self.measures
+    }
+
+    pub(crate) fn rust(&self) -> Option<&RustSettings> {
+        self.rust.as_ref()
+    }
+}
+#[cfg(test)]
+mod tests;
