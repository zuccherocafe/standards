+++ b/tools/rust/crates/dandegate/tests/scenarios/invocation.rs
@@ -0,0 +1,284 @@
+//! The command's most common use, a report between two committed revisions, and every refusal that stops it before
+//! any step runs.
+
+use std::fs;
+
+use crate::support::{Fixture, files_under, png};
+
+/// A per-revision step with images and measures, and a once step with a section, each running the generic step.
+pub(crate) const PROJECT: &str = r#"
+[[step]]
+name = "visual"
+run = ["sh", "{adapters}/step.sh", "visual", "{tree}", "{commit}", "{out}"]
+output = [
+    { kind = "images", folder = "{out}/images", expected = "{out}/expected.txt" },
+    { kind = "measures", from = "{out}/clips.log" },
+]
+
+[[step]]
+name = "notes"
+runs = "once"
+run = ["sh", "{adapters}/step.sh", "notes", "{after}", "{after-commit}", "{out}"]
+output = [{ kind = "section", file = "{out}/notes.md" }]
+"#;
+
+#[test]
+fn a_report_compares_two_committed_revisions_with_after_defaulting_to_head() {
+    let fixture = Fixture::new("report");
+    fixture.write("dandegate.toml", PROJECT);
+    fixture.write("fixture/visual/expected.txt", "cell.png\n");
+    fixture.write_bytes(
+        "fixture/visual/images/cell.png",
+        &png(1, 1, &[10, 20, 30, 255]),
+    );
+    fixture.write(
+        "fixture/visual/clips.log",
+        "MEASURE: clips.walk.twitch 0.5 m higher-is-worse\n",
+    );
+    fixture.write("fixture/notes/notes.md", "# Notes\n\nNothing to see.\n");
+    fixture.write("fixture/notes/notes.md.status", "complete\n");
+    let before = fixture.commit("before");
+    fixture.git(&["branch", "base"]);
+    fixture.write_bytes(
+        "fixture/visual/images/cell.png",
+        &png(1, 1, &[13, 20, 27, 255]),
+    );
+    fixture.write(
+        "fixture/visual/clips.log",
+        "MEASURE: clips.walk.twitch 0.75 m higher-is-worse\n",
+    );
+    let after = fixture.commit("after");
+
+    let run = fixture.run("out", &["--before", "base"]);
+    let page = run.page();
+
+    assert!(
+        page.contains(&format!(
+            "<title>Changes from base ({before}) to HEAD ({after})</title>"
+        )),
+        "{page}"
+    );
+    assert!(run.file("report.log").starts_with(&format!(
+        "dandegate: before base ({before}), after HEAD ({after})\n"
+    )));
+    assert_eq!(run.printed("DANDEGATE-INCOMPLETE"), Vec::<String>::new());
+    // |10 - 13| + |20 - 20| + |30 - 27| + |255 - 255| = 6, over four samples.
+    assert!(page.contains("<code>cell.png</code>: 1.50"), "{page}");
+    assert_eq!(
+        run.printed("DANDEGATE-WORSE"),
+        [
+            "clips.walk.twitch 0.5 m (higher-is-worse) -> 0.75 m (higher-is-worse) (+0.25, 50.0%, moved, worse (higher-is-worse))"
+        ]
+    );
+    assert!(
+        page.contains("<pre># Notes\n\nNothing to see.\n</pre>"),
+        "{page}"
+    );
+    // Each side's step was given its own commit, and ran in a checkout of it. The once step was given the after one.
+    let events = fixture.events();
+    for expected in [
+        format!("start visual {before} {before}"),
+        format!("start visual {after} {after}"),
+        format!("start notes {after} {after}"),
+    ] {
+        assert!(events.contains(&expected), "{expected} in {events:?}");
+    }
+    // The checkouts are gone, and the repository has only its own worktree.
+    assert_eq!(fixture.git(&["worktree", "list"]).lines().count(), 1);
+    // What dandegate keeps is ignored, so the repository's status is clean.
+    assert_eq!(
+        fs::read_to_string(fixture.repo().join(".cache/dandegate/.gitignore"))
+            .expect("an ignore file"),
+        "*\n"
+    );
+    assert_eq!(fixture.git(&["status", "--porcelain"]), "");
+    assert_eq!(
+        files_under(&fixture.repo().join(".cache/dandegate/scratch")),
+        Vec::<String>::new()
+    );
+}
+
+#[test]
+fn every_refusal_comes_before_any_step_runs() {
+    let fixture = Fixture::new("refusals");
+    fixture.write(
+        "dandegate.toml",
+        &format!(
+            "[inputs]\nrenders = {{ default = \"0\", help = \"frames to render\" }}\n{PROJECT}"
+        ),
+    );
+    let valid = fixture.commit("valid");
+    fixture.write("dandegate.toml", "[[step]\nname = \"visual\"\n");
+    let syntax = fixture.commit("syntax");
+    fixture.write(
+        "dandegate.toml",
+        "\n[[step]]\nname = \"visual\"\nrun = [\"sh\", \"{before}\"]\n",
+    );
+    let placeholder = fixture.commit("placeholder");
+    fs::create_dir(fixture.outside("existing")).expect("a folder");
+
+    let cases: [(&[&str], &str, &str); 7] = [
+        (
+            &["--before", &valid, "--after", &syntax],
+            "syntax",
+            "dandegate: dandegate.toml:1: ",
+        ),
+        (
+            &["--before", &valid, "--after", &placeholder],
+            "placeholder",
+            "dandegate: dandegate.toml:4: step \"visual\": run: {before} is not a placeholder this kind of step has; \
+             it has {tree}, {commit}, {out}, {adapters} and {input.<name>}",
+        ),
+        (
+            &["--before", &valid, "--after", &valid, "--with", "nope"],
+            "selection",
+            "dandegate: --with: \"nope\" names no step; the steps are visual, notes",
+        ),
+        (
+            &["--before", &valid, "--after", &valid, "--input", "nope=1"],
+            "input",
+            "dandegate: --input: \"nope\" is not an input dandegate.toml declares; it declares renders (frames to render)",
+        ),
+        (
+            &["--before", &valid, "--after", &valid, "--input", "renders"],
+            "input-syntax",
+            "dandegate: --input: \"renders\" is not <name>=<value>",
+        ),
+        (
+            &["--before", "nope"],
+            "revision",
+            "dandegate: \"nope\" names no commit",
+        ),
+        (
+            &["--before", &valid],
+            "existing",
+            "exists; give a new folder",
+        ),
+    ];
+    for (arguments, out, expected) in cases {
+        let run = fixture.run(out, arguments);
+        assert_eq!(run.status(), 1, "{out}: {}", run.stdout());
+        assert!(run.stderr().contains(expected), "{out}: {}", run.stderr());
+        assert_eq!(run.stdout(), "", "{out}");
+        assert_eq!(fixture.events(), Vec::<String>::new(), "{out}");
+        if out == "existing" {
+            assert_eq!(files_under(&run.out), Vec::<String>::new());
+        } else {
+            assert!(!run.out.exists(), "{out}");
+        }
+    }
+}
+
+#[test]
+fn an_output_folder_inside_the_repository_is_refused() {
+    let fixture = Fixture::new("inside");
+    fixture.write("dandegate.toml", PROJECT);
+    let only = fixture.commit("only");
+    let report = fixture.repo().join("report");
+    let run = fixture
+        .command(&["--before", &only, "--out", report.to_str().expect("UTF-8")])
+        .output()
+        .expect("the binary starts");
+    assert_eq!(run.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&run.stderr).contains("is inside the repository"));
+    assert!(!report.exists());
+
+    // A path that reaches the repository through a link outside it is inside it too.
+    let link = fixture.outside("link");
+    std::os::unix::fs::symlink(fixture.repo(), &link).expect("a link");
+    let through = link.join("report");
+    let run = fixture
+        .command(&["--before", &only, "--out", through.to_str().expect("UTF-8")])
+        .output()
+        .expect("the binary starts");
+    assert_eq!(run.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&run.stderr).contains("is inside the repository"));
+    assert!(!fixture.repo().join("report").exists());
+}
+
+#[test]
+fn revisions_are_frozen_when_the_report_starts_while_a_branch_moves() {
+    let fixture = Fixture::new("frozen");
+    // The mover moves main to a new commit while the report runs. The late step starts only after it.
+    let plan = r#"
+[[step]]
+name = "mover"
+runs = "once"
+run = ["sh", "-c", "git -C \"$DANDEGATE_REPOSITORY\" commit --quiet --allow-empty --message moved"]
+
+[[step]]
+name = "late"
+runs = "once"
+needs = ["mover"]
+run = ["sh", "{adapters}/step.sh", "late", "{after}", "{after-commit}", "{out}"]
+"#;
+    fixture.write("dandegate.toml", plan);
+    let before = fixture.commit("before");
+    let after = fixture.commit("after");
+
+    let run = fixture.run("out", &["--before", &before, "--after", "main"]);
+    let page = run.page();
+    let moved = fixture.git(&["rev-parse", "main"]).trim().to_owned();
+    assert_ne!(moved, after, "the branch moved during the report");
+    assert!(
+        fixture
+            .events()
+            .contains(&format!("start late {after} {after}")),
+        "{:?}",
+        fixture.events()
+    );
+    assert!(
+        page.contains(&format!("to main ({after})</title>")),
+        "{page}"
+    );
+}
+
+#[test]
+fn every_step_gets_the_repository_its_inputs_verbatim_and_the_measures_file_only_when_given() {
+    let fixture = Fixture::new("step-environment");
+    let plan = r#"
+[inputs]
+source-checkout = { default = ".", help = "where untracked sources are read" }
+
+[[step]]
+name = "environment"
+runs = "once"
+run = ["sh", "{adapters}/environment.sh", "{input.source-checkout}"]
+env = { STEP_MODE = "{input.source-checkout}-mode" }
+"#;
+    fixture.write("dandegate.toml", plan);
+    fixture.write(
+        "dandegate/environment.sh",
+        "printf '%s|%s|%s|%s\\n' \"$DANDEGATE_REPOSITORY\" \"${DANDEGATE_MEASURES-absent}\" \"$1\" \"$STEP_MODE\" \
+         >> \"$EVENTS/environment\"\n",
+    );
+    let only = fixture.commit("only");
+    fs::write(fixture.outside("gate.log"), "MEASURE: a 1 m\n").expect("a log");
+
+    fixture.run("plain", &["--before", &only]).page();
+    fixture
+        .run(
+            "given",
+            &[
+                "--before",
+                &only,
+                "--measures",
+                "../gate.log",
+                "--input",
+                "source-checkout=../elsewhere",
+            ],
+        )
+        .page();
+    let repository = fixture.repo().canonicalize().expect("the repository");
+    let gate_log = fixture.outside("gate.log").canonicalize().expect("the log");
+    let recorded = fs::read_to_string(fixture.events_folder().join("environment"))
+        .expect("the steps' records");
+    assert_eq!(
+        recorded,
+        format!(
+            "{0}|absent|.|.-mode\n{0}|{1}|../elsewhere|../elsewhere-mode\n",
+            repository.display(),
+            gate_log.display()
+        )
+    );
+}
diff --git a/tools/rust/crates/dandegate/tests/scenarios/receipts.rs b/tools/rust/crates/dandegate/tests/scenarios/receipts.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8eb39057c9552cf4f07e7c5537db6b0c732a9ec9
--- /dev/null
+++ b/tools/rust/crates/dandegate/tests/scenarios/receipts.rs
@@ -0,0 +1,252 @@
+//! dandegate uses a kept entry only when it is whole, keeps only complete successes, and loses only reuse when it
+//! cannot write the store.
+
+use std::fs;
+use std::path::PathBuf;
+
+use crate::selection::started;
+use crate::support::{Fixture, png};
+
+const VISUAL: &str = r#"
+[[step]]
+name = "visual"
+reuse = true
+run = ["sh", "{adapters}/step.sh", "visual", "{tree}", "{commit}", "{out}"]
+output = [{ kind = "measures", from = "{out}/clips.log" }]
+"#;
+
+/// A change to a kept entry's folder.
+type Damage = fn(&PathBuf);
+
+/// Every kept entry's folder, staging folders aside.
+fn entries(fixture: &Fixture) -> Vec<PathBuf> {
+    let mut found: Vec<PathBuf> = fs::read_dir(fixture.results())
+        .into_iter()
+        .flatten()
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| {
+            !path
+                .file_name()
+                .is_some_and(|name| name.to_string_lossy().starts_with('.'))
+        })
+        .collect();
+    found.sort();
+    found
+}
+
+#[test]
+fn a_missing_changed_extra_malformed_or_old_format_entry_is_a_miss() {
+    let fixture = Fixture::new("damaged");
+    fixture.write("dandegate.toml", VISUAL);
+    fixture.write(
+        "fixture/visual/clips.log",
+        "MEASURE: clips.walk.twitch 0.5 m\n",
+    );
+    let only = fixture.commit("before");
+    fixture.commit("after");
+    fixture.run("first", &["--before", &only]).page();
+    assert_eq!(entries(&fixture).len(), 2);
+
+    let damages: [(&str, Damage, &str); 5] = [
+        (
+            "missing",
+            |entry| fs::remove_file(entry.join("files/log.txt")).expect("a kept file"),
+            "its files are not the ones its receipt lists",
+        ),
+        (
+            "changed",
+            |entry| {
+                fs::write(
+                    entry.join("files/out/clips.log"),
+                    "MEASURE: clips.walk.twitch 9 m\n",
+                )
+                .expect("a kept file");
+            },
+            "its files are not the ones its receipt lists",
+        ),
+        (
+            "extra",
+            |entry| fs::write(entry.join("files/out/extra.txt"), "more").expect("a new file"),
+            "its files are not the ones its receipt lists",
+        ),
+        (
+            "malformed",
+            |entry| fs::write(entry.join("receipt.json"), "{").expect("the receipt"),
+            "its receipt is not one",
+        ),
+        (
+            "old",
+            |entry| {
+                let receipt = fs::read_to_string(entry.join("receipt.json")).expect("the receipt");
+                fs::write(
+                    entry.join("receipt.json"),
+                    receipt.replace("\"format\": 1,", "\"format\": 0,"),
+                )
+                .expect("the receipt");
+            },
+            "its receipt is in format 0, not 1",
+        ),
+    ];
+    for (name, damage, why) in damages {
+        for entry in entries(&fixture) {
+            damage(&entry);
+        }
+        fixture.clear_events();
+        let run = fixture.run(name, &["--before", &only]);
+        let page = run.page();
+        assert_eq!(started(&fixture).len(), 2, "{name}");
+        assert!(
+            page.contains(&format!(
+                "<td>after</td><td>visual</td><td>runs fresh: {why}"
+            )),
+            "{name}: {page}"
+        );
+        assert_eq!(
+            run.file("steps/after/visual/out/clips.log"),
+            "MEASURE: clips.walk.twitch 0.5 m\n"
+        );
+    }
+}
+
+#[test]
+fn only_complete_successes_are_kept() {
+    let fixture = Fixture::new("complete");
+    let plan = r#"
+[[step]]
+name = "good"
+reuse = true
+run = ["sh", "{adapters}/step.sh", "good", "{tree}", "{commit}", "{out}"]
+output = [{ kind = "measures", from = "{out}/clips.log" }]
+
+[[step]]
+name = "failing"
+reuse = true
+run = ["sh", "{adapters}/step.sh", "failing", "{tree}", "{commit}", "{out}"]
+output = [{ kind = "measures", from = "{out}/clips.log" }]
+
+[[step]]
+name = "partial"
+reuse = true
+run = ["sh", "{adapters}/step.sh", "partial", "{tree}", "{commit}", "{out}"]
+output = [{ kind = "section", file = "{out}/report.md" }]
+
+[[step]]
+name = "malformed"
+reuse = true
+run = ["sh", "{adapters}/step.sh", "malformed", "{tree}", "{commit}", "{out}"]
+output = [{ kind = "measures", from = "{out}/clips.log" }]
+
+[[step]]
+name = "unrendered"
+reuse = true
+run = ["sh", "{adapters}/step.sh", "unrendered", "{tree}", "{commit}", "{out}"]
+output = [{ kind = "images", folder = "{out}/images", expected = "{out}/expected.txt" }]
+"#;
+    fixture.write("dandegate.toml", plan);
+    fixture.write("fixture/good/clips.log", "MEASURE: good 1 m\n");
+    fixture.write("fixture/failing/clips.log", "MEASURE: failing 1 m\n");
+    fixture.write("fixture/failing.fail", "");
+    fixture.write("fixture/partial/report.md", "# Partial\n");
+    fixture.write(
+        "fixture/partial/report.md.status",
+        "incomplete: one of two parts\n",
+    );
+    fixture.write("fixture/malformed/clips.log", "MEASURE: malformed one m\n");
+    fixture.write("fixture/unrendered/expected.txt", "a.png\nb.png\n");
+    fixture.write_bytes(
+        "fixture/unrendered/images/a.png",
+        &png(1, 1, &[0, 0, 0, 255]),
+    );
+    let only = fixture.commit("before");
+    fixture.commit("after");
+
+    let run = fixture.run("out", &["--before", &only]);
+    let page = run.page();
+    assert_eq!(entries(&fixture).len(), 2, "only good's two sides are kept");
+    for name in ["failing", "partial", "malformed", "unrendered"] {
+        assert!(
+            page.contains(&format!(
+                "<td>after</td><td>{name}</td><td>runs fresh: nothing is kept for it; not kept: only a complete success \
+                 is kept</td>"
+            )),
+            "{name}: {page}"
+        );
+    }
+    fixture.clear_events();
+    fixture.run("again", &["--before", &only]).page();
+    let mut ran: Vec<String> = started(&fixture)
+        .into_iter()
+        .map(|event| event.split(' ').next().unwrap_or_default().to_owned())
+        .collect();
+    ran.sort();
+    ran.dedup();
+    assert_eq!(ran, ["failing", "malformed", "partial", "unrendered"]);
+}
+
+#[test]
+fn a_store_that_cannot_be_written_costs_only_its_reuse() {
+    let fixture = Fixture::new("unwritable");
+    fixture.write("dandegate.toml", VISUAL);
+    fixture.write(
+        "fixture/visual/clips.log",
+        "MEASURE: clips.walk.twitch 0.5 m\n",
+    );
+    let only = fixture.commit("only");
+    fs::create_dir_all(fixture.repo().join(".cache/dandegate")).expect("a folder");
+    fs::write(fixture.results(), "a file where the store's folder goes").expect("a file");
+
+    let run = fixture.run("out", &["--before", &only]);
+    let page = run.page();
+    assert!(page.contains("<td>after</td><td>visual</td><td>runs fresh: nothing is kept for it; not kept: could not keep"), "{page}");
+    assert!(
+        page.contains("(os error"),
+        "the page gives the store's own error: {page}"
+    );
+    assert_eq!(run.printed("DANDEGATE-INCOMPLETE"), Vec::<String>::new());
+    assert!(page.contains("<td>0.5 m</td><td>0.5 m</td>"), "{page}");
+}
+
+#[test]
+fn a_staging_folder_is_never_read_and_none_is_left_behind() {
+    let fixture = Fixture::new("staging");
+    fixture.write("dandegate.toml", VISUAL);
+    fixture.write(
+        "fixture/visual/clips.log",
+        "MEASURE: clips.walk.twitch 0.5 m\n",
+    );
+    let only = fixture.commit("before");
+    fixture.commit("after");
+    fixture.run("first", &["--before", &only]).page();
+    let mut staged = Vec::new();
+    for entry in entries(&fixture) {
+        let name = entry
+            .file_name()
+            .expect("a name")
+            .to_string_lossy()
+            .into_owned();
+        let staging = fixture.results().join(format!(".{name}-interrupted"));
+        fs::rename(&entry, &staging).expect("a rename");
+        staged.push(staging);
+    }
+
+    fixture.clear_events();
+    fixture.run("second", &["--before", &only]).page();
+    assert_eq!(
+        started(&fixture).len(),
+        2,
+        "a staging folder is not an entry"
+    );
+    let mut dotted: Vec<PathBuf> = fs::read_dir(fixture.results())
+        .expect("the store")
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| {
+            path.file_name()
+                .is_some_and(|name| name.to_string_lossy().starts_with('.'))
+        })
+        .collect();
+    dotted.sort();
+    staged.sort();
+    assert_eq!(dotted, staged, "the run left no staging folder of its own");
+}
diff --git a/tools/rust/crates/dandegate/tests/scenarios/reuse.rs b/tools/rust/crates/dandegate/tests/scenarios/reuse.rs
