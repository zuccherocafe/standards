index 0000000000000000000000000000000000000000..2eaa5a600f278cdecee39272d0d8bb36efd96c95
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/report.rs
@@ -0,0 +1,562 @@
+//! Runs one report, from the checkouts to the page, after dandegate has accepted the command line, the revisions and
+//! the plan. Nothing in this module stops the page. A step that fails, a checkout that dandegate cannot make, and a
+//! store that it cannot write each become an outcome or a note on the page.
+//!
+//! A report runs in this order:
+//!
+//! 1. Check out both commits as detached worktrees under `.cache/dandegate/scratch/`.
+//! 2. For each reusable step, work out its identity, running its collector, and look for a kept result.
+//! 3. Decide which steps run. A step that only other steps need runs only when one of them runs fresh.
+//! 4. Run the steps, and keep each complete success.
+//! 5. Remove the checkouts.
+//! 6. Compare the two sides, and write the page, `measures.json` and the printed lines.
+//!
+//! [`schedule`] orders the steps and runs up to four at once. [`step`] runs one command and records what happened to a
+//! step. [`store`] keeps complete successes. [`identity`] lists what a kept result depends on. [`summary`] compares the
+//! two sides and writes the page.
+
+mod identity;
+mod schedule;
+pub(crate) mod step;
+pub(crate) mod store;
+mod summary;
+
+use std::collections::BTreeMap;
+use std::fs::{self, File, OpenOptions};
+use std::io::Write as _;
+use std::sync::Mutex;
+use std::time::Instant;
+
+use camino::{Utf8Path, Utf8PathBuf};
+
+use crate::compare::measure::Measures;
+use crate::plan::{
+    Arg, Expansion, PairArg, PairValues, Plan, Recipe, Report, Runs, Step, Template, TreeArg,
+    TreeValues, Work,
+};
+use crate::report::schedule::{Graph, Instance, Place, Start, run_all};
+use crate::report::step::{Launch, LaunchError, Outcome, Skip, check_outputs, launch, shown};
+use crate::report::store::{Identity, Lookup, Store};
+use crate::revision::git::Repository;
+use crate::revision::{PerSide, Revision, Side};
+use crate::rust;
+
+/// Everything a report needs, accepted and resolved.
+#[derive(Debug)]
+pub(crate) struct Request {
+    pub(crate) repository: Repository,
+    pub(crate) revisions: PerSide<Revision>,
+    pub(crate) plan: Plan,
+    /// The new output folder, already made.
+    pub(crate) out: Utf8PathBuf,
+    pub(crate) no_reuse: bool,
+    /// `--measures`' file, absolute.
+    pub(crate) measures_file: Option<Utf8PathBuf>,
+    /// The measures `--previous` and `--measures` give each side.
+    pub(crate) imported: PerSide<Measures>,
+    /// dandegate's own executable's digest, or why it cannot be read.
+    pub(crate) executable: Result<String, String>,
+}
+
+/// The report's log, written by every step's thread in turn.
+#[derive(Debug)]
+struct Log(Mutex<Option<File>>);
+
+impl Log {
+    fn write(&self, text: &str) {
+        if let Ok(mut file) = self.0.lock()
+            && let Some(file) = file.as_mut()
+        {
+            // The log is evidence beside the page. If a write to it fails, the page is still written.
+            let _ = file.write_all(text.as_bytes());
+        }
+    }
+}
+
+/// What the run shares between its steps' threads.
+struct Session<'a> {
+    request: &'a Request,
+    graph: Graph,
+    checkouts: PerSide<Result<Utf8PathBuf, String>>,
+    scratch: Utf8PathBuf,
+    adapters: Utf8PathBuf,
+    adapter_files: Result<BTreeMap<String, String>, String>,
+    env: Vec<(String, String)>,
+    log: Log,
+    store: Store,
+    identities: Vec<Option<Result<Identity, String>>>,
+    notes: Mutex<BTreeMap<usize, Vec<String>>>,
+}
+
+/// What a report printed, and whether its page was written.
+#[derive(Debug)]
+pub(crate) struct Finished {
+    pub(crate) lines: Vec<String>,
+    pub(crate) written: bool,
+}
+
+/// Write the report into `request.out`, and give the lines to print.
+pub(crate) fn report(request: &Request) -> Finished {
+    let root = request.repository.root();
+    let cache = root.join(".cache/dandegate");
+    let scratch = cache.join("scratch").join(std::process::id().to_string());
+    let log = Log(Mutex::new(
+        File::create(request.out.join("report.log")).ok(),
+    ));
+    log.write(&format!(
+        "dandegate: before {}, after {}\nrepository {root}\n",
+        request.revisions.before, request.revisions.after
+    ));
+    let prepared = prepare_cache(&cache, &scratch);
+    let checkouts = PerSide::from_fn(|side| {
+        let folder = scratch.join(side.as_str());
+        prepared
+            .clone()
+            .and_then(|()| {
+                request
+                    .repository
+                    .add_worktree(&folder, request.revisions[side].commit())
+                    .map_err(|error| error.to_string())
+            })
+            .map(|()| folder)
+    });
+    let adapters = checkouts
+        .after
+        .as_ref()
+        .map_or_else(|_| scratch.join("after"), Clone::clone)
+        .join("dandegate");
+    let mut env = vec![("DANDEGATE_REPOSITORY".to_owned(), root.to_string())];
+    if let Some(file) = &request.measures_file {
+        env.push(("DANDEGATE_MEASURES".to_owned(), file.to_string()));
+    }
+    let mut session = Session {
+        request,
+        graph: Graph::new(&request.plan),
+        checkouts,
+        adapter_files: request
+            .repository
+            .blobs(request.revisions.after.commit(), "dandegate")
+            .map_err(|error| error.to_string()),
+        scratch,
+        adapters,
+        env,
+        log,
+        store: Store::new(cache.join("results")),
+        identities: Vec::new(),
+        notes: Mutex::new(BTreeMap::new()),
+    };
+    let starts = session.starts();
+    let outcomes = run_all(&session.graph, starts, &|at| session.execute(at));
+    session.remove_checkouts();
+    session.page(&outcomes)
+}
+
+/// Make the cache folder, ignored by git whatever the project ignores, and an empty scratch folder for this run.
+fn prepare_cache(cache: &Utf8Path, scratch: &Utf8Path) -> Result<(), String> {
+    let made = (|| -> std::io::Result<()> {
+        fs::create_dir_all(cache)?;
+        let ignore = cache.join(".gitignore");
+        if !ignore.exists() {
+            fs::write(ignore, "*\n")?;
+        }
+        if scratch.exists() {
+            fs::remove_dir_all(scratch)?;
+        }
+        fs::create_dir_all(scratch)
+    })();
+    made.map_err(|error| format!("the scratch folder {scratch} could not be made: {error}"))
+}
+
+/// What an instance runs: a per-revision or after step's recipe on one side, or a once step's on both.
+enum Target<'a> {
+    Tree(&'a Recipe<TreeArg>, Side),
+    Pair(&'a Recipe<PairArg>),
+}
+
+/// A command with its placeholders filled in, and the environment it runs with.
+struct Prepared {
+    command: Vec<String>,
+    env: Vec<(String, String)>,
+}
+
+/// Expand every template.
+fn expanded<A: Arg>(templates: &[Template<A>], expansion: &Expansion<'_, '_, A>) -> Vec<String> {
+    templates
+        .iter()
+        .map(|template| template.expand(expansion))
+        .collect()
+}
+
+impl Session<'_> {
+    fn plan(&self) -> &Plan {
+        &self.request.plan
+    }
+
+    fn step(&self, at: usize) -> &Step {
+        &self.plan().steps()[&self.graph.instances()[at].step]
+    }
+
+    /// What an instance runs, with the side it runs on.
+    fn target(&self, at: usize) -> Target<'_> {
+        let place = self.graph.instances()[at].place;
+        match self.step(at).runs() {
+            Runs::PerRevision(recipe) | Runs::After(recipe) => Target::Tree(
+                recipe,
+                place
+                    .side()
+                    .expect("a per-revision or after step's instances each run on a revision"),
+            ),
+            Runs::Once(recipe) => Target::Pair(recipe),
+        }
+    }
+
+    /// An instance's folder in the output: its log and its output folder, `out/`.
+    fn folder(&self, instance: &Instance) -> Utf8PathBuf {
+        self.request
+            .out
+            .join("steps")
+            .join(instance.place.as_str())
+            .join(instance.step.as_str())
+    }
+
+    /// An instance's own scratch folder.
+    fn work(&self, instance: &Instance) -> Utf8PathBuf {
+        self.scratch.join("work").join(format!(
+            "{}-{}",
+            instance.place.as_str(),
+            instance.step.as_str()
+        ))
+    }
+
+    fn note(&self, at: usize, text: String) {
+        let instance = &self.graph.instances()[at];
+        self.log.write(&format!(
+            "=== {} {}: {text}\n",
+            instance.place, instance.step
+        ));
+        if let Ok(mut notes) = self.notes.lock() {
+            notes.entry(at).or_default().push(text);
+        }
+    }
+
+    fn checkout(&self, side: Side) -> Result<&Utf8Path, String> {
+        self.checkouts[side]
+            .as_deref()
+            .map_err(|why| format!("the {} checkout could not be made: {why}", side.as_str()))
+    }
+
+    fn tree(&self, side: Side) -> Result<TreeValues<'_>, String> {
+        Ok(TreeValues {
+            tree: self.checkout(side)?,
+            commit: self.request.revisions[side].commit(),
+        })
+    }
+
+    fn pair(&self) -> Result<PairValues<'_>, String> {
+        Ok(PairValues {
+            before: self.tree(Side::Before)?,
+            after: self.tree(Side::After)?,
+        })
+    }
+
+    /// How each instance starts: decided, reused, or run.
+    fn starts(&mut self) -> Vec<Start> {
+        let count = self.graph.instances().len();
+        let mut forced = vec![false; count];
+        for at in 0..count {
+            let step = self.step(at);
+            if step.enabled() && step.live() {
+                for &need in self.graph.needs(at) {
+                    forced[need] = true;
+                }
+            }
+        }
+        self.identities = (0..count)
+            .map(|at| {
+                let step = self.step(at);
+                (step.enabled() && step.reuse()).then(|| self.identity(at))
+            })
+            .collect();
+        let mut found: Vec<Option<Utf8PathBuf>> = vec![None; count];
+        for at in 0..count {
+            let Some(identity) = &self.identities[at] else {
+                continue;
+            };
+            let why = match identity {
+                Err(why) => format!("runs fresh and is not kept: {why}"),
+                Ok(_) if self.request.no_reuse => "runs fresh: --no-reuse".to_owned(),
+                Ok(_) if forced[at] => {
+                    "runs fresh: a live step needs its checkout from this run".to_owned()
+                }
+                Ok(identity) => match self.store.find(identity) {
+                    Lookup::Hit(entry) => {
+                        found[at] = Some(entry);
+                        continue;
+                    }
+                    Lookup::Miss(why) => format!("runs fresh: {why}"),
+                },
+            };
+            self.note(at, why);
+        }
+
+        let mut needed_by = vec![Vec::new(); count];
+        for at in 0..count {
+            if self.step(at).enabled() {
+                for &need in self.graph.needs(at) {
+                    needed_by[need].push(at);
+                }
+            }
+        }
+        let mut wanted = vec![false; count];
+        for &at in self.graph.order().iter().rev() {
+            wanted[at] = self.step(at).enabled()
+                && (needed_by[at].is_empty()
+                    || needed_by[at]
+                        .iter()
+                        .any(|&by| wanted[by] && found[by].is_none()));
+        }
+
+        let rust_changed = self.plan().rust().map(|settings| {
+            rust::rust_changed(&self.request.repository, settings, &self.request.revisions)
+                .unwrap_or(true)
+        });
+        (0..count)
+            .map(|at| {
+                let step = self.step(at);
+                if !step.enabled() {
+                    return Start::Decided(Outcome::Disabled);
+                }
+                if !wanted[at] {
+                    return Start::Decided(Outcome::Skipped(Skip::Unneeded));
+                }
+                if step.report() == Some(Report::Mutants) && rust_changed == Some(false) {
+                    return Start::Decided(Outcome::Skipped(Skip::NoRustChanged));
+                }
+                if let Some(entry) = &found[at] {
+                    let instance = &self.graph.instances()[at];
+                    let folder = self.folder(instance);
+                    match Store::restore(entry, &folder) {
+                        Ok(()) => {
+                            self.note(at, format!("reused {entry}"));
+                            let outputs = check_outputs(step.outputs(), &folder.join("out"));
+                            return Start::Decided(Outcome::Reused {
+                                entry: entry.clone(),
+                                outputs,
+                            });
+                        }
+                        Err(error) => {
+                            let why =
+                                format!("runs fresh: the kept result could not be copied: {error}");
+                            self.note(at, why);
+                        }
+                    }
+                }
+                Start::Run {
+                    exclusive: step.exclusive(),
+                }
+            })
+            .collect()
+    }
+
+    /// `command` with its placeholders filled in, and the recipe's environment.
+    fn prepared<A: Arg>(
+        &self,
+        recipe: &Recipe<A>,
+        values: &A::Values<'_>,
+        out: &Utf8Path,
+        command: &[Template<A>],
+    ) -> Prepared {
+        let expansion = Expansion {
+            values,
+            inputs: self.plan().inputs(),
+            out,
+            adapters: &self.adapters,
+        };
+        let command = expanded(command, &expansion);
+        let mut env = self.env.clone();
+        env.extend(
+            recipe
+                .env()
+                .iter()
+                .map(|(name, value)| (name.as_str().to_owned(), value.expand(&expansion))),
+        );
+        Prepared { command, env }
+    }
+
+    /// Run one instance and keep its result when it is a complete success.
+    fn execute(&self, at: usize) -> Outcome {
+        let instance = &self.graph.instances()[at];
+        self.log.write(&format!(
+            "=== {} {}: started\n",
+            instance.place, instance.step
+        ));
+        let folder = self.folder(instance);
+        let out = folder.join("out");
+        let log_path = folder.join("log.txt");
+        let outcome = match fs::create_dir_all(&out).and_then(|()| File::create(&log_path)) {
+            Err(error) => {
+                Outcome::LaunchFailed(format!("its folder {folder} could not be made: {error}"))
+            }
+            Ok(_) => match self.target(at) {
+                Target::Tree(recipe, side) => match self.tree(side) {
+                    Err(why) => Outcome::LaunchFailed(why),
+                    Ok(values) => self.perform(at, recipe, &values, Some(side), &out, &log_path),
+                },
+                Target::Pair(recipe) => match self.pair() {
+                    Err(why) => Outcome::LaunchFailed(why),
+                    Ok(values) => self.perform(at, recipe, &values, None, &out, &log_path),
+                },
+            },
+        };
+        if let Ok(mut log) = OpenOptions::new().append(true).open(&log_path) {
+            let _ = writeln!(log, "--- {outcome}");
+        }
+        self.log.write(&format!(
+            "=== {} {}: {outcome}\n{}",
+            instance.place,
+            instance.step,
+            fs::read_to_string(&log_path).unwrap_or_default()
+        ));
+        if let Some(Ok(identity)) = &self.identities[at]
+            && outcome.complete()
+        {
+            match self.store.keep(identity, &folder) {
+                Ok(()) => self.note(at, "kept for reuse".to_owned()),
+                Err(error) => self.note(at, format!("not kept: {error}: {}", error_chain(&error))),
+            }
+        } else if let Some(Ok(_)) = &self.identities[at] {
+            self.note(at, "not kept: only a complete success is kept".to_owned());
+        }
+        outcome
+    }
+
+    /// Run an instance's command or report.
+    fn perform<A: Arg>(
+        &self,
+        at: usize,
+        recipe: &Recipe<A>,
+        values: &A::Values<'_>,
+        side: Option<Side>,
+        out: &Utf8Path,
+        log_path: &Utf8Path,
+    ) -> Outcome {
+        let instance = &self.graph.instances()[at];
+        let step = self.step(at);
+        let deadline = Instant::now() + step.timeout();
+        let checkout_side = side.unwrap_or(Side::After);
+        let checkout = match self.checkout(checkout_side) {
+            Ok(checkout) => checkout,
+            Err(why) => return Outcome::LaunchFailed(why),
+        };
+        match recipe.work() {
+            Work::Command(run) => {
+                let Prepared { command, env } = self.prepared(recipe, values, out, run);
+                let opened = OpenOptions::new()
+                    .append(true)
+                    .open(log_path)
+                    .and_then(|mut log| {
+                        writeln!(log, "$ {}", shown(&command))?;
+                        for (name, value) in env.iter().skip(self.env.len()) {
+                            writeln!(log, "  {name}={value}")?;
+                        }
+                        let stderr = log.try_clone()?;
+                        Ok((log, stderr))
+                    });
+                let (stdout, stderr) = match opened {
+                    Ok(files) => files,
+                    Err(error) => {
+                        return Outcome::LaunchFailed(format!(
+                            "its log could not be written: {error}"
+                        ));
+                    }
+                };
+                let launched = launch(Launch {
+                    checkout,
+                    directory: checkout,
+                    command: &command,
+                    env: &env,
+                    stdout,
+                    stderr,
+                    deadline,
+                });
+                match launched {
+                    Ok(status) => Outcome::Exited {
+                        status,
+                        outputs: check_outputs(step.outputs(), out),
+                    },
+                    Err(LaunchError::TimedOut) => Outcome::TimedOut {
+                        after: step.timeout(),
+                    },
+                    Err(error @ LaunchError::Start(_)) => Outcome::LaunchFailed(error.to_string()),
+                }
+            }
+            Work::Rust(report) => {
+                let Some(settings) = self.plan().rust() else {
+                    return Outcome::LaunchFailed("the plan has no Rust workspace".to_owned());
+                };
+                let listings = PerSide::from_fn(|side| {
+                    self.folder(&Instance {
+                        step: Report::ApiListings.step(),
+                        place: Place::Revision(side),
+                    })
+                    .join("out")
+                });
+                let work = self.work(instance);
+                if let Err(error) = fs::create_dir_all(&work) {
+                    return Outcome::LaunchFailed(format!(
+                        "its scratch folder could not be made: {error}"
+                    ));
+                }
+                let context = rust::Context {
+                    settings,
+                    revisions: &self.request.revisions,
+                    checkouts: &self.checkouts,
+                    out,
+                    listings,
+                    scratch: &work,
+                    log: log_path,
+                    env: &self.env,
+                    deadline,
+                };
+                match rust::run(*report, side, &context) {
+                    Ok(()) => Outcome::Reported {
+                        outputs: check_outputs(step.outputs(), out),
+                    },
+                    Err(rust::Stop::TimedOut) => Outcome::TimedOut {
+                        after: step.timeout(),
+                    },
+                    Err(error @ rust::Stop::Write(_)) => {
+                        Outcome::LaunchFailed(format!("{error}: {}", error_chain(&error)))
+                    }
+                }
+            }
+        }
+    }
+
+    fn remove_checkouts(&self) {
+        for side in Side::BOTH {
+            if let Ok(folder) = &self.checkouts[side]
+                && let Err(error) = self.request.repository.remove_worktree(folder)
+            {
+                self.log.write(&format!(
+                    "=== the {} checkout could not be removed: {error}\n",
+                    side.as_str()
+                ));
+                let _ = fs::remove_dir_all(folder);
+            }
+        }
+        let _ = self.request.repository.prune_worktrees();
+        let _ = fs::remove_dir_all(&self.scratch);
+    }
+}
+
+/// An error's causes, each once.
+fn error_chain(error: &dyn std::error::Error) -> String {
+    let mut causes = Vec::new();
+    let mut cause = error.source();
+    while let Some(found) = cause {
+        causes.push(found.to_string());
+        cause = found.source();
+    }
+    causes.join(": ")
+}
diff --git a/tools/rust/crates/dandegate/src/report/identity.rs b/tools/rust/crates/dandegate/src/report/identity.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f329ce1942ce76d1d73b0ce29082f6a03917962f
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/report/identity.rs
@@ -0,0 +1,154 @@
+//! Works out a reusable step's identity, the list of everything its kept result depends on, including its collector's
+//! lines.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{self, File};
+use std::time::Instant;
+
+use camino::Utf8Path;
+
+use crate::report::schedule::Place;
+use crate::report::step::{Launch, launch, shown};
+use crate::report::store::{Commits, Identity, InputIdentity, file_sha256};
+use crate::report::{Prepared, Session, Target};
+use crate::revision::Side;
+
+impl Session<'_> {
+    /// Everything the instance's result follows from, or why it cannot be named.
+    pub(super) fn identity(&self, at: usize) -> Result<Identity, String> {
+        let instance = &self.graph.instances()[at];
+        let step = self.step(at);
+        let dandegate = self.request.executable.clone()?;
+        let adapters = self
+            .adapter_files
+            .clone()
+            .map_err(|why| format!("the adapters cannot be listed: {why}"))?;
+        let commits = match instance.place {
+            Place::Revision(side) => Commits::revision(self.request.revisions[side].commit()),
+            Place::Pair => Commits::pair(
+                self.request.revisions.before.commit(),
+                self.request.revisions.after.commit(),
+            ),
+        };
+        let mut needs = BTreeMap::new();
+        let mut used: BTreeSet<_> = step.inputs();
+        for need in self.graph.all_needs(at) {
+            let name = &self.graph.instances()[need].step;
+            let needed = &self.plan().steps()[name];
+            used.extend(needed.inputs());
+            needs.insert(name.to_string(), needed.written());
+        }
+        let root = self.request.repository.root();
+        let inputs = used
+            .into_iter()
+            .map(|name| {
+                let value = self.plan().inputs()[name].value().to_owned();
+                let path = root.join(&value);
+                let file = path
+                    .is_file()
+                    .then(|| file_sha256(&path).map_err(|error| format!("{path}: {error}")));
+                Ok((
+                    name.to_string(),
+                    InputIdentity {
+                        value,
+                        file: file.transpose()?,
+                    },
+                ))
+            })
+            .collect::<Result<_, String>>()?;
+        let overridden = step.env_names();
+        let mut environment = BTreeMap::new();
+        let inherited = std::env::vars().chain(self.env.iter().cloned());
+        for (name, value) in inherited {
+            if overridden.contains(name.as_str())
+                || !step
+                    .identity_env()
+                    .iter()
+                    .any(|pattern| pattern.matches(&name))
+            {
+                continue;
+            }
+            let value = if name == "DANDEGATE_MEASURES" {
+                file_sha256(Utf8Path::new(&value)).map_err(|error| format!("{value}: {error}"))?
+            } else {
+                value
+            };
+            environment.insert(name, value);
+        }
+        let collected = self.collect(at)?;
+        Ok(Identity {
+            dandegate,
+            commits,
+            step: step.written(),
+            needs,
+            inputs,
+            adapters,
+            environment,
+            collected,
+        })
+    }
+
+    /// The `name=value` lines the instance's collector prints in the step's own environment, or none when the step
+    /// has no collector.
+    fn collect(&self, at: usize) -> Result<BTreeMap<String, String>, String> {
+        let instance = &self.graph.instances()[at];
+        let step = self.step(at);
+        let out = self.folder(instance).join("out");
+        let prepared = match self.target(at) {
+            Target::Tree(recipe, side) => match recipe.collect() {
+                None => None,
+                Some(collect) => Some(self.prepared(recipe, &self.tree(side)?, &out, collect)),
+            },
+            Target::Pair(recipe) => match recipe.collect() {
+                None => None,
+                Some(collect) => Some(self.prepared(recipe, &self.pair()?, &out, collect)),
+            },
+        };
+        let Some(Prepared { command, env }) = prepared else {
+            return Ok(BTreeMap::new());
+        };
+        let checkout = match instance.place {
+            Place::Revision(side) => self.checkout(side)?,
+            Place::Pair => self.checkout(Side::After)?,
+        };
+        let work = self.work(instance);
+        fs::create_dir_all(&work).map_err(|error| error.to_string())?;
+        let printed = work.join("collected.txt");
+        let errors = work.join("collector.log");
+        let files = File::create(&printed)
+            .and_then(|stdout| File::create(&errors).map(|stderr| (stdout, stderr)))
+            .map_err(|error| error.to_string())?;
+        let launched = launch(Launch {
+            checkout,
+            directory: checkout,
+            command: &command,
+            env: &env,
+            stdout: files.0,
+            stderr: files.1,
+            deadline: Instant::now() + step.timeout(),
+        });
+        self.log.write(&format!(
+            "=== {} {}: identity collector: {}\n{}",
+            instance.place,
+            instance.step,
+            shown(&command),
+            fs::read_to_string(&errors).unwrap_or_default()
+        ));
+        match launched {
+            Ok(status) if status.success() => {}
+            Ok(status) => return Err(format!("its identity collector failed: {status}")),
+            Err(error) => return Err(format!("its identity collector {error}")),
+        }
+        let text = fs::read_to_string(&printed).map_err(|error| error.to_string())?;
+        text.lines()
+            .filter(|line| !line.is_empty())
+            .map(|line| {
+                line.split_once('=')
+                    .map(|(name, value)| (name.to_owned(), value.to_owned()))
+                    .ok_or_else(|| {
+                        format!("its identity collector printed {line:?}, not name=value")
+                    })
+            })
+            .collect()
+    }
+}
diff --git a/tools/rust/crates/dandegate/src/report/schedule.rs b/tools/rust/crates/dandegate/src/report/schedule.rs
new file mode 100644
index 0000000000000000000000000000000000000000..88e0d6a4a2be334c5c684ea313062bb88c51632f
--- /dev/null
+++ b/tools/rust/crates/dandegate/src/report/schedule.rs
@@ -0,0 +1,268 @@
+//! Decides where each step runs, what each run waits for, and when each run starts.
+//!
+//! A step runs as one instance per place. A per-revision step runs on each side, an after step runs on the after side,
+//! and a once step runs once for both sides. An instance waits for the instances of the steps it needs, on the sides it
+//! uses. [`crate::plan`] says which needs each kind of step can have.
+//!
+//! The scheduler starts each instance whose needs have finished, up to four at once, each on its own thread. When a
+//! need did not succeed, the scheduler skips the instance and records which need failed. Exclusive instances wait until
+//! every other instance has finished, then run one at a time, so a step that measures time runs alone. An instance
+//! whose outcome dandegate knows beforehand, because it is disabled, unneeded or reused, takes no thread.
+
+use std::fmt;
+use std::sync::mpsc;
+use std::thread;
+
+use crate::plan::{Kind, Plan, StepName};
+use crate::report::step::{Outcome, Skip};
+use crate::revision::Side;
+
+/// How many instances run at once.
+const PARALLEL: usize = 4;
+
+/// Where an instance runs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) enum Place {
+    /// On one revision, in its checkout.
+    Revision(Side),
+    /// Once, given both checkouts.
+    Pair,
+}
+
+impl Place {
+    /// The side a revision's instance runs on, or none for a once step's instance.
+    pub(crate) fn side(self) -> Option<Side> {
+        match self {
+            Self::Revision(side) => Some(side),
+            Self::Pair => None,
+        }
+    }
+
+    /// The place as the output folder names it.
+    pub(crate) fn as_str(self) -> &'static str {
+        match self {
+            Self::Revision(side) => side.as_str(),
+            Self::Pair => "both",
+        }
+    }
+}
+
+impl fmt::Display for Place {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(self.as_str())
+    }
+}
+
+/// One run of a step at a place.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) struct Instance {
+    pub(crate) step: StepName,
+    pub(crate) place: Place,
+}
+
+/// The places a step of `kind` runs at.
+fn places(kind: Kind) -> &'static [Place] {
+    match kind {
+        Kind::PerRevision => &[Place::Revision(Side::Before), Place::Revision(Side::After)],
+        Kind::After => &[Place::Revision(Side::After)],
+        Kind::Once => &[Place::Pair],
+    }
+}
+
+/// Every step's instances, in the plan's order, and what each waits for, by index, needs before dependants.
+#[derive(Debug)]
+pub(crate) struct Graph {
+    instances: Vec<Instance>,
+    needs: Vec<Vec<usize>>,
+}
+
+impl Graph {
+    pub(crate) fn new(plan: &Plan) -> Self {
+        let mut instances = Vec::new();
+        for (name, step) in plan.steps() {
+            for &place in places(step.kind()) {
+                instances.push(Instance {
+                    step: name.clone(),
+                    place,
+                });
+            }
+        }
+        let index = |step: &StepName, place: Place| {
+            instances
+                .iter()
+                .position(|found| found.step == *step && found.place == place)
+        };
+        let needs = instances
+            .iter()
+            .map(|instance| {
+                let step = &plan.steps()[&instance.step];
+                step.needs()
+                    .iter()
+                    .flat_map(|need| {
+                        let needed = &plan.steps()[need];
+                        let at: Vec<Place> = match (needed.kind(), instance.place) {
+                            (Kind::PerRevision, Place::Revision(side)) => {
+                                vec![Place::Revision(side)]
+                            }
+                            (Kind::PerRevision, Place::Pair) => {
+                                vec![Place::Revision(Side::Before), Place::Revision(Side::After)]
+                            }
+                            (Kind::After, _) => vec![Place::Revision(Side::After)],
+                            (Kind::Once, _) => vec![Place::Pair],
+                        };
+                        at.into_iter()
+                            .filter_map(|place| index(need, place))
+                            .collect::<Vec<_>>()
+                    })
+                    .collect()
+            })
+            .collect();
+        Self { instances, needs }
+    }
+
+    pub(crate) fn instances(&self) -> &[Instance] {
+        &self.instances
+    }
+
+    /// The instances `instance` waits for.
+    pub(crate) fn needs(&self, instance: usize) -> &[usize] {
+        &self.needs[instance]
+    }
+
+    /// Every instance `instance` waits for, directly or through others.
+    pub(crate) fn all_needs(&self, instance: usize) -> Vec<usize> {
+        let mut found = Vec::new();
+        let mut pending = self.needs[instance].clone();
+        while let Some(need) = pending.pop() {
+            if !found.contains(&need) {
+                found.push(need);
+                pending.extend_from_slice(&self.needs[need]);
+            }
+        }
+        found.sort_unstable();
+        found
+    }
+
+    /// Indices with every instance after those it waits for.
+    pub(crate) fn order(&self) -> Vec<usize> {
+        fn visit(graph: &Graph, at: usize, done: &mut [bool], order: &mut Vec<usize>) {
+            if done[at] {
+                return;
+            }
+            done[at] = true;
+            for &need in &graph.needs[at] {
+                visit(graph, need, done, order);
+            }
+            order.push(at);
+        }
+        let mut done = vec![false; self.instances.len()];
+        let mut order = Vec::with_capacity(self.instances.len());
+        for at in 0..self.instances.len() {
+            visit(self, at, &mut done, &mut order);
+        }
+        order
+    }
+}
+
+/// How an instance starts.
+#[derive(Debug)]
+pub(crate) enum Start {
+    /// It runs once its needs succeed, or, when exclusive, after every other instance.
+    Run { exclusive: bool },
+    /// Its outcome is known already.
+    Decided(Outcome),
+}
+
+/// Where an instance is in the scheduler.
+#[derive(Debug)]
+enum State {
+    Waiting { exclusive: bool },
+    Running,
+    Done(Outcome),
+}
+
+/// Every instance's outcome, running those that run with `run`, given each instance's index.
+pub(crate) fn run_all<F>(graph: &Graph, starts: Vec<Start>, run: &F) -> Vec<Outcome>
+where
+    F: Fn(usize) -> Outcome + Sync,
+{
+    let mut states: Vec<State> = starts
+        .into_iter()
+        .map(|start| match start {
+            Start::Run { exclusive } => State::Waiting { exclusive },
+            Start::Decided(outcome) => State::Done(outcome),
+        })
+        .collect();
+    let succeeded = |state: &State| matches!(state, State::Done(outcome) if outcome.succeeded());
+    let done = |state: &State| matches!(state, State::Done(_));
+    thread::scope(|scope| {
+        let (sender, receiver) = mpsc::channel::<(usize, Outcome)>();
+        let mut running = 0;
+        loop {
+            // Skip what waits for a need that finished without succeeding, until nothing more is skipped.
+            loop {
+                let skipped: Vec<(usize, StepName)> = states
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, state)| matches!(state, State::Waiting { .. }))
+                    .filter_map(|(at, _)| {
+                        let failed = graph.needs[at]
+                            .iter()
+                            .find(|&&need| done(&states[need]) && !succeeded(&states[need]))?;
+                        Some((at, graph.instances[*failed].step.clone()))
+                    })
+                    .collect();
+                if skipped.is_empty() {
+                    break;
+                }
+                for (at, need) in skipped {
+                    states[at] = State::Done(Outcome::Skipped(Skip::NeedFailed(need)));
+                }
+            }
+            let ordinary_left = states
+                .iter()
+                .any(|state| matches!(state, State::Waiting { exclusive: false }));
+            let mut starting = Vec::new();
+            for (at, state) in states.iter().enumerate() {
+                let State::Waiting { exclusive } = *state else {
+                    continue;
+                };
+                let room = if exclusive {
+                    !ordinary_left && running == 0 && starting.is_empty()
+                } else {
+                    running + starting.len() < PARALLEL
+                };
+                if room && graph.needs[at].iter().all(|&need| done(&states[need])) {
+                    starting.push(at);
+                }
+            }
+            for at in starting {
+                states[at] = State::Running;
+                running += 1;
+                let sender = sender.clone();
+                scope.spawn(move || {
+                    // The receiver lives until every instance has reported, so the send cannot fail.
+                    let _ = sender.send((at, run(at)));
+                });
+            }
+            if running == 0 {
+                break;
+            }
+            match receiver.recv() {
+                Ok((at, outcome)) => {
+                    states[at] = State::Done(outcome);
+                    running -= 1;
+                }
+                Err(_) => break,
+            }
+        }
+    });
+    states
+        .into_iter()
+        .map(|state| match state {
+            State::Done(outcome) => outcome,
+            // Every waiting instance's needs finish, so the loop ends with none waiting or running.
+            State::Waiting { .. } | State::Running => Outcome::Skipped(Skip::Unneeded),
+        })
+        .collect()
+}
diff --git a/tools/rust/crates/dandegate/src/report/step.rs b/tools/rust/crates/dandegate/src/report/step.rs
