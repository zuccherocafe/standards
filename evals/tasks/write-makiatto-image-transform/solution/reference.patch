+//! Decodes bounded PNGs and computes image geometry without reading files or mutable state.
+
+use std::io::Cursor;
+
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+
+use crate::{
+    config::{Dimension, ImageConfig, Quality},
+    query::{FitMode, ImageParams, OutputFormat},
+};
+
+const MAX_RASTER_BYTES: usize = 256 * 1024 * 1024;
+
+#[derive(Debug)]
+pub(crate) struct Raster {
+    width: Dimension,
+    height: Dimension,
+    rgba: Vec<u8>,
+}
+
+/// A PNG could not be decoded, transformed or encoded within the supported memory bound.
+#[derive(Debug, thiserror::Error)]
+pub enum TransformError {
+    /// The encoded source is not a supported PNG.
+    #[error("decode source png")]
+    Decode(#[source] png::DecodingError),
+    /// A decoded or requested raster needs more than 256 MiB.
+    #[error("image raster exceeds the 256 mib processing limit")]
+    RasterLimit,
+    /// A computed or requested dimension exceeds node policy.
+    #[error("image dimensions exceed configured limits")]
+    Dimensions,
+    /// A PNG could not be encoded.
+    #[error("encode output png")]
+    Encode(#[source] png::EncodingError),
+    /// A cache recipe could not be encoded.
+    #[error("encode image cache recipe")]
+    Recipe(#[source] serde_json::Error),
+}
+
+impl Raster {
+    pub(crate) fn decode(bytes: &[u8]) -> Result<Self, TransformError> {
+        let mut decoder = png::Decoder::new(Cursor::new(bytes));
+        decoder.set_transformations(png::Transformations::EXPAND | png::Transformations::STRIP_16);
+        decoder.set_limits(png::Limits {
+            bytes: MAX_RASTER_BYTES,
+        });
+        let mut reader = decoder.read_info().map_err(TransformError::Decode)?;
+        let width = Dimension::new(reader.info().width).map_err(|_| TransformError::RasterLimit)?;
+        let height =
+            Dimension::new(reader.info().height).map_err(|_| TransformError::RasterLimit)?;
+        let size = raster_size(width.get(), height.get())?;
+        let mut buffer = vec![
+            0;
+            reader
+                .output_buffer_size()
+                .ok_or(TransformError::RasterLimit)?
+        ];
+        let info = reader
+            .next_frame(&mut buffer)
+            .map_err(TransformError::Decode)?;
+        let mut rgba = Vec::with_capacity(size);
+        let channels = info.color_type.samples();
+        for pixel in buffer[..info.buffer_size()].chunks_exact(channels) {
+            match info.color_type {
+                png::ColorType::Rgba => rgba.extend_from_slice(pixel),
+                png::ColorType::Rgb => rgba.extend_from_slice(&[pixel[0], pixel[1], pixel[2], 255]),
+                png::ColorType::Grayscale => {
+                    rgba.extend_from_slice(&[pixel[0], pixel[0], pixel[0], 255]);
+                }
+                png::ColorType::GrayscaleAlpha => {
+                    rgba.extend_from_slice(&[pixel[0], pixel[0], pixel[0], pixel[1]]);
+                }
+                png::ColorType::Indexed => return Err(TransformError::RasterLimit),
+            }
+        }
+        Ok(Self {
+            width,
+            height,
+            rgba,
+        })
+    }
+
+    pub(crate) fn plan(
+        &self,
+        params: &ImageParams,
+        config: &ImageConfig,
+    ) -> Result<Recipe, TransformError> {
+        let source_width = u64::from(self.width.get());
+        let source_height = u64::from(self.height.get());
+        let width = params
+            .width
+            .map_or(source_width, |value| u64::from(value.get()));
+        let height = params
+            .height
+            .map_or(source_height, |value| u64::from(value.get()));
+        let (width, height) = match (params.width, params.height) {
+            (Some(_), None) => (
+                width,
+                ((width * source_height + source_width / 2) / source_width).max(1),
+            ),
+            (None, Some(_)) => (
+                ((height * source_width + source_height / 2) / source_height).max(1),
+                height,
+            ),
+            (Some(_), Some(_)) | (None, None) => (width, height),
+        };
+        if width > u64::from(config.max_width.get()) || height > u64::from(config.max_height.get())
+        {
+            return Err(TransformError::Dimensions);
+        }
+        Ok(Recipe {
+            width: Dimension::new(u32::try_from(width).map_err(|_| TransformError::Dimensions)?)
+                .map_err(|_| TransformError::Dimensions)?,
+            height: Dimension::new(u32::try_from(height).map_err(|_| TransformError::Dimensions)?)
+                .map_err(|_| TransformError::Dimensions)?,
+            fit: params.fit,
+            format: params.format,
+            quality: params.quality.unwrap_or(config.default_quality),
+        })
+    }
+
+    pub(crate) fn transform(&self, recipe: &Recipe) -> Result<Vec<u8>, TransformError> {
+        let source_width = u64::from(self.width.get());
+        let source_height = u64::from(self.height.get());
+        let target_width = u64::from(recipe.width.get());
+        let target_height = u64::from(recipe.height.get());
+        let fitted = || {
+            if target_width * source_height <= target_height * source_width {
+                (
+                    target_width,
+                    ((target_width * source_height + source_width / 2) / source_width).max(1),
+                )
+            } else {
+                (
+                    ((target_height * source_width + source_height / 2) / source_height).max(1),
+                    target_height,
+                )
+            }
+        };
+        let (scaled_width, scaled_height, width, height) = match recipe.fit {
+            FitMode::Fill => (target_width, target_height, target_width, target_height),
+            FitMode::Contain => {
+                let (width, height) = fitted();
+                (width, height, width, height)
+            }
+            FitMode::ScaleDown => {
+                let (width, height) =
+                    if source_width <= target_width && source_height <= target_height {
+                        (source_width, source_height)
+                    } else {
+                        fitted()
+                    };
+                (width, height, width, height)
+            }
+            FitMode::Cover => {
+                let (scaled_width, scaled_height) =
+                    if target_width * source_height >= target_height * source_width {
+                        (
+                            target_width,
+                            (target_width * source_height).div_ceil(source_width),
+                        )
+                    } else {
+                        (
+                            (target_height * source_width).div_ceil(source_height),
+                            target_height,
+                        )
+                    };
+                (scaled_width, scaled_height, target_width, target_height)
+            }
+        };
+        let width = u32::try_from(width).map_err(|_| TransformError::RasterLimit)?;
+        let height = u32::try_from(height).map_err(|_| TransformError::RasterLimit)?;
+        let size = raster_size(width, height)?;
+        let offset_x = (scaled_width - u64::from(width)) / 2;
+        let offset_y = (scaled_height - u64::from(height)) / 2;
+        let mut rgba = Vec::with_capacity(size);
+        for y in 0..u64::from(height) {
+            let source_y =
+                u128::from(y + offset_y) * u128::from(source_height) / u128::from(scaled_height);
+            for x in 0..u64::from(width) {
+                let source_x =
+                    u128::from(x + offset_x) * u128::from(source_width) / u128::from(scaled_width);
+                let index = usize::try_from((source_y * u128::from(source_width) + source_x) * 4)
+                    .map_err(|_| TransformError::RasterLimit)?;
+                rgba.extend_from_slice(&self.rgba[index..index + 4]);
+            }
+        }
+        match recipe.format {
+            OutputFormat::RawRgba => Ok(rgba),
+            OutputFormat::Png => {
+                let mut output = Vec::new();
+                {
+                    let mut encoder = png::Encoder::new(&mut output, width, height);
+                    encoder.set_color(png::ColorType::Rgba);
+                    encoder.set_depth(png::BitDepth::Eight);
+                    encoder.set_compression(if recipe.quality.get() < 50 {
+                        png::Compression::Fastest
+                    } else {
+                        png::Compression::Balanced
+                    });
+                    let mut writer = encoder.write_header().map_err(TransformError::Encode)?;
+                    writer
+                        .write_image_data(&rgba)
+                        .map_err(TransformError::Encode)?;
+                }
+                Ok(output)
+            }
+        }
+    }
+}
+
+fn raster_size(width: u32, height: u32) -> Result<usize, TransformError> {
+    usize::try_from(u64::from(width) * u64::from(height))
+        .ok()
+        .and_then(|area| area.checked_mul(4))
+        .filter(|size| *size <= MAX_RASTER_BYTES)
+        .ok_or(TransformError::RasterLimit)
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub(crate) struct Recipe {
+    width: Dimension,
+    height: Dimension,
+    fit: FitMode,
+    format: OutputFormat,
+    quality: Quality,
+}
+
+impl Recipe {
+    pub(crate) fn key(&self, source: &[u8]) -> Result<String, TransformError> {
+        let mut hash = Sha256::new();
+        hash.update(b"makiatto-image-v1\0");
+        hash.update(Sha256::digest(source));
+        hash.update(serde_json::to_vec(self).map_err(TransformError::Recipe)?);
+        let alphabet = b"0123456789abcdef";
+        Ok(hash
+            .finalize()
+            .iter()
+            .flat_map(|byte| {
+                [
+                    char::from(alphabet[usize::from(byte >> 4)]),
+                    char::from(alphabet[usize::from(byte & 15)]),
+                ]
+            })
+            .collect())
+    }
+
+    pub(crate) const fn content_type(&self) -> &'static str {
+        self.format.content_type()
+    }
+}
