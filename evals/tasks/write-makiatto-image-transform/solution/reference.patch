+//! Parses URL query syntax once into closed image options and checked quantities.
+
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+
+use crate::config::{Dimension, Quality};
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub(crate) enum FitMode {
+    #[default]
+    Contain,
+    Cover,
+    Fill,
+    ScaleDown,
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum OutputFormat {
+    #[default]
+    Png,
+    RawRgba,
+}
+
+impl OutputFormat {
+    pub(crate) const fn content_type(self) -> &'static str {
+        match self {
+            Self::Png => "image/png",
+            Self::RawRgba => "application/octet-stream",
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub(crate) struct ImageParams {
+    #[serde(alias = "w")]
+    pub(crate) width: Option<Dimension>,
+    #[serde(alias = "h")]
+    pub(crate) height: Option<Dimension>,
+    pub(crate) fit: FitMode,
+    pub(crate) format: OutputFormat,
+    #[serde(alias = "q")]
+    pub(crate) quality: Option<Quality>,
+}
+
+impl ImageParams {
+    pub(crate) fn parse(query: &str) -> Result<Option<Self>, ParseQueryError> {
+        let mut fields = Map::new();
+        for pair in query.split('&').filter(|pair| !pair.is_empty()) {
+            let (key, value) = pair.split_once('=').unwrap_or((pair, ""));
+            let key = decode(key)?;
+            let typed = match key.as_str() {
+                "w" | "width" | "h" | "height" | "q" | "quality" => Value::from(
+                    decode(value)?
+                        .parse::<u64>()
+                        .map_err(|_| ParseQueryError::Number { field: key.clone() })?,
+                ),
+                "fit" | "format" => Value::String(decode(value)?),
+                _ => continue,
+            };
+            if fields.insert(key.clone(), typed).is_some() {
+                return Err(ParseQueryError::Duplicate { field: key });
+            }
+        }
+        if fields.is_empty() {
+            return Ok(None);
+        }
+        serde_json::from_value(Value::Object(fields))
+            .map(Some)
+            .map_err(ParseQueryError::Options)
+    }
+}
+
+fn decode(value: &str) -> Result<String, ParseQueryError> {
+    let mut decoded = Vec::new();
+    let mut bytes = value.bytes();
+    while let Some(byte) = bytes.next() {
+        match byte {
+            b'+' => decoded.push(b' '),
+            b'%' => {
+                let high = bytes.next().and_then(hex).ok_or(ParseQueryError::Escape)?;
+                let low = bytes.next().and_then(hex).ok_or(ParseQueryError::Escape)?;
+                decoded.push(high * 16 + low);
+            }
+            other => decoded.push(other),
+        }
+    }
+    String::from_utf8(decoded).map_err(|_| ParseQueryError::Escape)
+}
+
+const fn hex(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        b'A'..=b'F' => Some(byte - b'A' + 10),
+        _ => None,
+    }
+}
+
+/// Authored query options could not be parsed into a transformation request.
+#[derive(Debug, thiserror::Error)]
+pub enum ParseQueryError {
+    /// A query escape or UTF-8 sequence is malformed.
+    #[error("decode query percent escape or text")]
+    Escape,
+    /// A numeric option is not a positive integer.
+    #[error("parse positive integer query field {field}")]
+    Number {
+        /// The authored query key.
+        field: String,
+    },
+    /// The same recognised option appears more than once.
+    #[error("duplicate query field {field}")]
+    Duplicate {
+        /// The authored query key.
+        field: String,
+    },
+    /// An option is outside its supported set or range.
+    #[error("parse image query fields")]
+    Options(#[source] serde_json::Error),
+}
