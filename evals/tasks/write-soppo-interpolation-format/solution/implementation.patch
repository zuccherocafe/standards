@@ -0,0 +1,107 @@
+//! Uses, most common first:
+//! - Compile interpolated messages to Go without invoking external tools.
+//! - Format source while preserving interpolation directives.
+//! - Refuse directives that cannot format an expression's type.
+
+use soppo::{compile_source, format_source};
+
+#[test]
+fn compile_interpolated_messages() {
+    let source = r#"package main
+func main() {
+    n := 42
+    price := 19.99
+    name := "Ada"
+    flag := true
+    println("{n:04x} {price:.2f} {name:s} {flag:t} 100% {n}")
+}
+"#;
+    let go = compile_source(source).unwrap();
+    assert!(
+        go.contains(r#"fmt.Sprintf("%04x %.2f %s %t 100%% %v", n, price, name, flag, n)"#),
+        "{go}"
+    );
+}
+
+#[test]
+fn format_and_compile_interpolation_with_slices() {
+    let source = r#"package main
+func main() {
+    arr := []int{1, 2, 3}
+    println("val: {arr[1:3]} {arr[0:2]:v} {arr[0]:04x}")
+}
+"#;
+    let formatted = format_source(source).unwrap();
+    assert!(formatted.contains("{arr[0:2]:v}"), "{formatted}");
+    assert!(formatted.contains("{arr[0]:04x}"), "{formatted}");
+    assert_eq!(format_source(&formatted).unwrap(), formatted);
+    let go = compile_source(&formatted).unwrap();
+    assert!(go.contains("val: %v %v %04x"), "{go}");
+}
+
+#[test]
+fn refuse_type_incompatible_directives() {
+    for (declaration, expression, directive, type_name) in [
+        ("n := 42", "n", ".2f", "int"),
+        ("name := \"Ada\"", "name", "d", "string"),
+        ("flag := true", "flag", "s", "bool"),
+    ] {
+        let source = format!(
+            "package main\nfunc main() {{\n{declaration}\nprintln(\"{{{expression}:{directive}}}\")\n}}\n"
+        );
+        let error = compile_source(&source).unwrap_err().to_string();
+        assert!(
+            error.contains(directive) && error.contains(type_name),
+            "{source}: {error}"
+        );
+    }
+}
+
+#[test]
+fn refuse_malformed_directives_before_codegen() {
+    for spec in [
+        "", "z", "++d", "004x", "4-d", ".f", ".2.3f", "0d", "#f", ".2d",
+    ] {
+        let source =
+            format!("package main\nfunc main() {{\nn := 42\nprintln(\"{{n:{spec}}}\")\n}}\n");
+        assert!(compile_source(&source).is_err(), "{spec}");
+        assert!(format_source(&source).is_err(), "{spec}");
+    }
+}
+
+#[test]
+fn preserve_literal_braces_and_quoted_expression_colons() {
+    let source = r#"package main
+func main() {
+    println("{{literal}} {`a:b`:s} {\"hello\":q}")
+}
+"#;
+    let formatted = format_source(source).unwrap();
+    assert!(formatted.contains("{{literal}}"), "{formatted}");
+    assert_eq!(format_source(&formatted).unwrap(), formatted);
+    let go = compile_source(&formatted).unwrap();
+    assert!(go.contains("{literal} %s %q"), "{go}");
+}
