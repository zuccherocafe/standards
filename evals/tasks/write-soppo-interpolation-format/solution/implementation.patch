new file mode 100644
index 0000000..ae5f3c6
--- /dev/null
+++ b/src/syntax/format_spec.rs
@@ -0,0 +1,326 @@
+//! Parses interpolation directives once and renders their checked components.
+
+use std::fmt;
+use std::num::NonZeroU32;
+use std::str::FromStr;
+
+/// A syntactically valid directive, without its leading `%`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FormatSpec {
+    sign: Option<Sign>,
+    alternate: bool,
+    zero: bool,
+    width: Option<NonZeroU32>,
+    precision: Option<u32>,
+    verb: Verb,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Sign {
+    Plus,
+    Space,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Verb {
+    Decimal,
+    Binary,
+    Octal,
+    Hex,
+    UpperHex,
+    Character,
+    Unicode,
+    Fixed,
+    UpperFixed,
+    Exponent,
+    UpperExponent,
+    GeneralFloat,
+    UpperGeneralFloat,
+    String,
+    Quoted,
+    Boolean,
+    General,
+}
+
+impl Verb {
+    fn from_char(value: char) -> Result<Self, FormatSpecError> {
+        match value {
+            'd' => Ok(Self::Decimal),
+            'b' => Ok(Self::Binary),
+            'o' => Ok(Self::Octal),
+            'x' => Ok(Self::Hex),
+            'X' => Ok(Self::UpperHex),
+            'c' => Ok(Self::Character),
+            'U' => Ok(Self::Unicode),
+            'f' => Ok(Self::Fixed),
+            'F' => Ok(Self::UpperFixed),
+            'e' => Ok(Self::Exponent),
+            'E' => Ok(Self::UpperExponent),
+            'g' => Ok(Self::GeneralFloat),
+            'G' => Ok(Self::UpperGeneralFloat),
+            's' => Ok(Self::String),
+            'q' => Ok(Self::Quoted),
+            't' => Ok(Self::Boolean),
+            'v' => Ok(Self::General),
+            other => Err(FormatSpecError::UnknownVerb(other)),
+        }
+    }
+
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Decimal => "d",
+            Self::Binary => "b",
+            Self::Octal => "o",
+            Self::Hex => "x",
+            Self::UpperHex => "X",
+            Self::Character => "c",
+            Self::Unicode => "U",
+            Self::Fixed => "f",
+            Self::UpperFixed => "F",
+            Self::Exponent => "e",
+            Self::UpperExponent => "E",
+            Self::GeneralFloat => "g",
+            Self::UpperGeneralFloat => "G",
+            Self::String => "s",
+            Self::Quoted => "q",
+            Self::Boolean => "t",
+            Self::General => "v",
+        }
+    }
+}
+
+/// A directive the author must correct before compilation.
+#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum FormatSpecError {
+    #[error("empty format specifier")]
+    Empty,
+    #[error("unknown format verb `{0}`")]
+    UnknownVerb(char),
+    #[error("duplicate or conflicting format flags")]
+    Flags,
+    #[error("malformed format width or precision")]
+    Number,
+    #[error("unsupported format flags or precision for this verb")]
+    Modifiers,
+}
+
+impl FormatSpec {
+    /// Parse the complete directive, rejecting duplicate flags and incomplete numbers.
+    ///
+    /// # Errors
+    /// Returns [`FormatSpecError`] when the directive cannot be rendered safely.
+    ///
+    /// ```
+    /// use soppo::syntax::FormatSpec;
+    /// let spec = FormatSpec::new("04x")?;
+    /// assert_eq!(spec.to_string(), "04x");
+    /// # Ok::<(), soppo::syntax::FormatSpecError>(())
+    /// ```
+    pub fn new(raw: &str) -> Result<Self, FormatSpecError> {
+        let mut chars = raw.chars();
+        let verb = Verb::from_char(chars.next_back().ok_or(FormatSpecError::Empty)?)?;
+        let mut remaining = chars.as_str();
+        let mut sign = None;
+        let mut alternate = false;
+        let mut zero = false;
+        while let Some(flag) = remaining.chars().next() {
+            match flag {
+                '+' | ' ' => {
+                    if sign.is_some() {
+                        return Err(FormatSpecError::Flags);
+                    }
+                    sign = Some(if flag == '+' { Sign::Plus } else { Sign::Space });
+                }
+                '#' => {
+                    if alternate {
+                        return Err(FormatSpecError::Flags);
+                    }
+                    alternate = true;
+                }
+                '0' => {
+                    if zero {
+                        return Err(FormatSpecError::Flags);
+                    }
+                    zero = true;
+                }
+                _ => break,
+            }
+            remaining = &remaining[flag.len_utf8()..];
+        }
+        let width_end = remaining
+            .find(|c: char| !c.is_ascii_digit())
+            .unwrap_or(remaining.len());
+        let width = if width_end == 0 {
+            None
+        } else {
+            Some(
+                remaining[..width_end]
+                    .parse()
+                    .map_err(|_| FormatSpecError::Number)?,
+            )
+        };
+        remaining = &remaining[width_end..];
+        let precision = if let Some(number) = remaining.strip_prefix('.') {
+            if number.is_empty() || !number.chars().all(|c| c.is_ascii_digit()) {
+                return Err(FormatSpecError::Number);
+            }
+            Some(number.parse().map_err(|_| FormatSpecError::Number)?)
+        } else if remaining.is_empty() {
+            None
+        } else {
+            return Err(FormatSpecError::Number);
+        };
+        let modifiers_valid = match verb {
+            Verb::Decimal
+            | Verb::Binary
+            | Verb::Octal
+            | Verb::Hex
+            | Verb::UpperHex
+            | Verb::Character
+            | Verb::Unicode => precision.is_none(),
+            Verb::Fixed
+            | Verb::UpperFixed
+            | Verb::Exponent
+            | Verb::UpperExponent
+            | Verb::GeneralFloat
+            | Verb::UpperGeneralFloat => !alternate && !zero,
+            Verb::String | Verb::Quoted | Verb::Boolean => {
+                sign.is_none() && !alternate && !zero && precision.is_none()
+            }
+            Verb::General => precision.is_none() && !zero,
+        };
+        if !modifiers_valid || (zero && width.is_none()) {
+            return Err(FormatSpecError::Modifiers);
+        }
+        Ok(Self {
+            sign,
+            alternate,
+            zero,
+            width,
+            precision,
+            verb,
+        })
+    }
+
+    pub(crate) fn accepts_type_name(&self, type_name: Option<&str>) -> bool {
+        let integer = matches!(
+            type_name,
+            Some(
+                "int"
+                    | "int8"
+                    | "int16"
+                    | "int32"
+                    | "int64"
+                    | "uint"
+                    | "uint8"
+                    | "uint16"
+                    | "uint32"
+                    | "uint64"
+                    | "uintptr"
+                    | "byte"
+                    | "rune"
+            )
+        );
+        match self.verb {
+            Verb::Decimal | Verb::Binary | Verb::Octal | Verb::Character | Verb::Unicode => integer,
+            Verb::Hex | Verb::UpperHex => integer || type_name == Some("string"),
+            Verb::Fixed
+            | Verb::UpperFixed
+            | Verb::Exponent
+            | Verb::UpperExponent
+            | Verb::GeneralFloat
+            | Verb::UpperGeneralFloat => matches!(type_name, Some("float32" | "float64")),
+            Verb::String | Verb::Quoted => type_name == Some("string"),
+            Verb::Boolean => type_name == Some("bool"),
+            Verb::General => true,
+        }
+    }
+}
+
+impl FromStr for FormatSpec {
+    type Err = FormatSpecError;
+
+    fn from_str(raw: &str) -> Result<Self, Self::Err> {
+        Self::new(raw)
+    }
+}
+
+impl fmt::Display for FormatSpec {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.sign {
+            Some(Sign::Plus) => f.write_str("+")?,
+            Some(Sign::Space) => f.write_str(" ")?,
+            None => {}
+        }
+        if self.alternate {
+            f.write_str("#")?;
+        }
+        if self.zero {
+            f.write_str("0")?;
+        }
+        if let Some(width) = self.width {
+            write!(f, "{width}")?;
+        }
+        if let Some(precision) = self.precision {
+            write!(f, ".{precision}")?;
+        }
+        f.write_str(self.verb.as_str())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{FormatSpec, FormatSpecError};
+
+    #[test]
+    fn directives_render_their_checked_components() {
+        for raw in [
+            "04x", "+#08X", " d", ".2f", "+8.0G", "s", "t", "v", "#v", "U",
+        ] {
+            assert_eq!(FormatSpec::new(raw).unwrap().to_string(), raw, "{raw}");
+        }
+    }
+
+    #[test]
+    fn malformed_directives_are_refused() {
+        assert_eq!(FormatSpec::new(""), Err(FormatSpecError::Empty));
+        assert_eq!(FormatSpec::new("z"), Err(FormatSpecError::UnknownVerb('z')));
+        for raw in [
+            "++d", "+ d", "##x", "004x", "4-d", ".f", "2.3.4f", "4dd", "0d", "#f", ".2d",
+        ] {
+            assert!(FormatSpec::new(raw).is_err(), "{raw}");
+        }
+    }
+
+    #[test]
+    fn numeric_fields_are_bounded() {
+        for raw in ["999999999999999999999d", ".999999999999999999999f"] {
+            assert_eq!(FormatSpec::new(raw), Err(FormatSpecError::Number), "{raw}");
+        }
+    }
+
+    #[test]
+    fn compatibility_is_owned_by_the_directive() {
+        assert!(
+            FormatSpec::new("x")
+                .unwrap()
+                .accepts_type_name(Some("string"))
+        );
+        assert!(
+            FormatSpec::new("U")
+                .unwrap()
+                .accepts_type_name(Some("rune"))
+        );
+        assert!(
+            !FormatSpec::new(".2f")
+                .unwrap()
+                .accepts_type_name(Some("int"))
+        );
+        assert!(
+            !FormatSpec::new("d")
+                .unwrap()
+                .accepts_type_name(Some("string"))
+        );
+        assert!(FormatSpec::new("v").unwrap().accepts_type_name(None));
+    }
+}
