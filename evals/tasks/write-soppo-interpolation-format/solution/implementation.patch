+#[test]
+fn accept_each_numeric_type_and_verb() {
+    for type_name in [
+        "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64",
+        "byte", "rune",
+    ] {
+        for spec in ["d", "b", "o", "x", "X", "c", "U", "+#08x", " 4d"] {
+            let source = format!(
+                "package main\nfunc main() {{\nvar n {type_name} = 42\nprintln(\"{{n:{spec}}}\")\n}}\n"
+            );
+            assert!(compile_source(&source).is_ok(), "{source}");
+        }
+    }
+    for type_name in ["float32", "float64"] {
+        for spec in ["f", "F", "e", "E", "g", "G", "+8.2f", " .0G"] {
+            let source = format!(
+                "package main\nfunc main() {{\nvar n {type_name} = 2.5\nprintln(\"{{n:{spec}}}\")\n}}\n"
+            );
+            assert!(compile_source(&source).is_ok(), "{source}");
+        }
+    }
+}
