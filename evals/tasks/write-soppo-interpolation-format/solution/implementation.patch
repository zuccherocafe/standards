+#[derive(Default)]
+struct QuotedContent {
+    delimiter: Option<char>,
+    escaped: bool,
+}
+
+impl QuotedContent {
+    fn observe(&mut self, ch: char) -> bool {
+        if let Some(delimiter) = self.delimiter {
+            if self.escaped {
+                self.escaped = false;
+            } else if ch == '\\' && delimiter != '`' {
+                self.escaped = true;
+            } else if ch == delimiter {
+                self.delimiter = None;
+            }
+            true
+        } else if matches!(ch, '"' | '\'' | '`') {
+            self.delimiter = Some(ch);
+            true
+        } else {
+            false
+        }
+    }
+}
+
+fn split_interpolation_content(content: &str) -> (&str, Option<&str>) {
+    let mut depth = 0_usize;
+    let mut quoted = QuotedContent::default();
+    for (index, ch) in content.char_indices() {
+        if quoted.observe(ch) {
+            continue;
+        }
+        match ch {
+            '(' | '[' | '{' => depth += 1,
+            ')' | ']' | '}' => depth = depth.saturating_sub(1),
+            ':' if depth == 0 => return (&content[..index], Some(&content[index + 1..])),
+            _ => {}
+        }
+    }
+    (content, None)
+}
