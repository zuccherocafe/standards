+//! Rigid surface following, adapted from tdoll-springs `follow` at 5e659004.
+//! A host skins support corners with its own binds after solvers; only the dedicated piece bone moves.
+
+use glam::{DAffine3, DMat3, DQuat, DVec3};
+
+const DEGENERATE: f64 = 1e-12;
+const SHARES: f64 = 1e-9;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Influence<B> {
+    pub bone: B,
+    pub bind: DAffine3,
+    pub weight: f64,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Corner<B> {
+    pub held: DVec3,
+    pub influences: Vec<Influence<B>>,
+    pub share: f64,
+}
+
+impl<B: Copy> Corner<B> {
+    fn skinned(&self, worlds: &impl Fn(B) -> DAffine3) -> DVec3 {
+        self.influences
+            .iter()
+            .map(|influence| {
+                (worlds(influence.bone) * influence.bind).transform_point3(self.held)
+                    * influence.weight
+            })
+            .sum()
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Placed {
+    pub position: DVec3,
+    pub share: f64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Rigid {
+    rotation: DQuat,
+    translation: DVec3,
+}
+
+impl Rigid {
+    pub fn new(rotation: DQuat, translation: DVec3) -> Option<Self> {
+        let length = rotation.length();
+        (length.is_finite() && length > 0.0 && translation.is_finite()).then(|| Self {
+            rotation: rotation / length,
+            translation,
+        })
+    }
+
+    pub fn affine(self) -> DAffine3 {
+        DAffine3::from_rotation_translation(self.rotation, self.translation)
+    }
+}
+
+/// X follows the first edge, Y is the winding normal and Z completes a right-handed orthonormal basis.
+pub fn frame(corners: [Placed; 3]) -> Option<Rigid> {
+    let [first, second, third] = corners;
+    let edge = second.position - first.position;
+    let normal = edge.cross(third.position - first.position);
+    if !normal.is_finite() || normal.length() <= DEGENERATE {
+        return None;
+    }
+    let along = edge.try_normalize()?;
+    let up = normal.try_normalize()?;
+    let basis = DMat3::from_cols(along, up, along.cross(up));
+    let origin = first.position * first.share
+        + second.position * second.share
+        + third.position * third.share;
+    Rigid::new(DQuat::from_mat3(&basis), origin)
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Follower<B> {
+    bone: B,
+    corners: [Corner<B>; 3],
+    offset: Rigid,
+}
+
+impl<B: Copy> Follower<B> {
+    pub fn new(bone: B, corners: [Corner<B>; 3], offset: Rigid) -> Option<Self> {
+        let total: f64 = corners.iter().map(|corner| corner.share).sum();
+        ((total - 1.0).abs() <= SHARES).then_some(Self {
+            bone,
+            corners,
+            offset,
+        })
+    }
+
+    pub const fn bone(&self) -> B {
+        self.bone
+    }
+
+    pub fn world(&self, worlds: impl Fn(B) -> DAffine3) -> Option<DAffine3> {
+        let placed = self.corners.each_ref().map(|corner| Placed {
+            position: corner.skinned(&worlds),
+            share: corner.share,
+        });
+        Some(frame(placed)?.affine() * self.offset.affine())
+    }
+}
