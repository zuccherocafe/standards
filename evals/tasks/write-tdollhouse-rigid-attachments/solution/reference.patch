+use std::collections::BTreeSet;
+
+use tdoll_attachments::{
+    Body, BoneName, Character, Coat, DAffine3, DQuat, DVec3, Error, Influence, MaterialName, Model,
+    RestNode, Seconds, Surface, input_digest,
+};
+
+fn bone(name: &str) -> BoneName {
+    BoneName::new(name).unwrap()
+}
+
+fn material(name: &str) -> MaterialName {
+    MaterialName::new(name).unwrap()
+}
+
+fn fixture() -> Model {
+    let surface = |name, joint, held| Surface {
+        material: material(name),
+        joints: vec![bone(joint)],
+        binds: vec![DAffine3::IDENTITY],
+        held,
+        weights: vec![
+            vec![Influence {
+                joint: 0,
+                weight: 1.0
+            }];
+            3
+        ],
+        triangles: vec![[0, 1, 2]],
+    };
+    Model {
+        nodes: ["Root", "Cloth", "Badge"]
+            .into_iter()
+            .map(|name| RestNode {
+                name: bone(name),
+                parent: (name != "Root").then_some(0),
+                local: DAffine3::IDENTITY,
+            })
+            .collect(),
+        surfaces: vec![
+            surface("Fabric", "Cloth", vec![DVec3::ZERO, DVec3::X, DVec3::Y]),
+            surface(
+                "Metal",
+                "Badge",
+                vec![
+                    DVec3::new(0.1, 0.1, 0.1),
+                    DVec3::new(0.3, 0.1, 0.1),
+                    DVec3::new(0.2, 0.4, 0.1),
+                ],
+            ),
+        ],
+        body_bones: BTreeSet::from([bone("Root"), bone("Cloth")]),
+        chains: Vec::new(),
+    }
+}
+
+fn character() -> Character {
+    Character::parse("attach \"Badge\" to=\"Fabric\"").unwrap()
+}
+
+#[test]
+fn a_badge_keeps_its_authored_rest_and_follows_a_turned_surface_as_one_rigid_piece() {
+    let model = fixture();
+    let body = Body::build(model.clone(), &character()).unwrap();
+    let mut coat = Coat::new(&model).unwrap();
+    let delta = Seconds::new(1.0 / 60.0).unwrap();
+    let rest = body.frame(&model.rest_locals(), &mut coat, delta).unwrap();
+    for (placed, held) in rest.surfaces[1].iter().zip(&model.surfaces[1].held) {
+        assert!(placed.abs_diff_eq(*held, 1e-12));
+    }
+    let moved = DAffine3::from_rotation_translation(
+        DQuat::from_rotation_y(0.6),
+        DVec3::new(1.0, 0.2, -0.4),
+    );
+    let mut locals = model.rest_locals();
+    locals[1] = moved;
+    let posed = body.frame(&locals, &mut coat, delta).unwrap();
+    for (placed, held) in posed.surfaces[1].iter().zip(&model.surfaces[1].held) {
+        assert!(placed.abs_diff_eq(moved.transform_point3(*held), 1e-12));
+    }
+    let distance = |vertices: &[DVec3]| vertices[0].distance(vertices[1]);
+    assert!((distance(&posed.surfaces[1]) - distance(&rest.surfaces[1])).abs() < 1e-6);
+}
+
+#[test]
+fn declarations_invalidate_the_geometry_cache_and_cannot_claim_body_bones() {
+    let mut model = fixture();
+    assert_ne!(
+        input_digest(&model, &Character::default()).unwrap(),
+        input_digest(&model, &character()).unwrap(),
+    );
+    model.body_bones.insert(bone("Badge"));
+    assert!(
+        matches!(Body::build(model, &character()), Err(Error::Ownership { piece, .. })
+        if piece == bone("Badge"))
+    );
+}
+
+#[test]
+fn a_collinear_support_is_refused_with_the_piece_and_material() {
+    let mut model = fixture();
+    model.surfaces[0].held[2] = DVec3::X * 2.0;
+    assert!(
+        matches!(Body::build(model, &character()), Err(Error::NoSupport { piece, surface })
+        if piece == bone("Badge") && surface == material("Fabric"))
+    );
+}
