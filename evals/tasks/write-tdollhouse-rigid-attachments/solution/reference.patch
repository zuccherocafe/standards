+/// Project onto the plane, or the nearest closed edge when the projection lies outside the triangle.
+fn closest([a, b, c]: [DVec3; 3], point: DVec3) -> [f64; 3] {
+    let ab = b - a;
+    let ac = c - a;
+    let normal = ab.cross(ac);
+    let denominator = normal.length_squared();
+    let v = (point - a).cross(ac).dot(normal) / denominator;
+    let w = ab.cross(point - a).dot(normal) / denominator;
+    let u = 1.0 - v - w;
+    if u >= 0.0 && v >= 0.0 && w >= 0.0 {
+        return [u, v, w];
+    }
+    let points = [a, b, c];
+    let mut best = (f64::INFINITY, [1.0, 0.0, 0.0]);
+    for (first, second) in [(0, 1), (1, 2), (2, 0)] {
+        let edge = points[second] - points[first];
+        let share = ((point - points[first]).dot(edge) / edge.length_squared()).clamp(0.0, 1.0);
+        let distance = point.distance_squared(points[first] + edge * share);
+        if distance < best.0 {
+            let mut shares = [0.0; 3];
+            shares[first] = 1.0 - share;
+            shares[second] = share;
+            best = (distance, shares);
+        }
+    }
+    best.1
 }
 
