+            let influences = surface.weights[vertex]
+                .iter()
+                .map(|weight| {
+                    let name = &surface.joints[weight.joint];
+                    let bone = model
+                        .nodes
+                        .iter()
+                        .position(|node| &node.name == name)
+                        .ok_or(Error::Model)?;
+                    Ok(Influence {
+                        bone,
+                        bind: surface.binds[weight.joint],
+                        weight: weight.weight,
+                    })
+                })
+                .collect::<Result<_, Error>>()?;
+            corners.push(Corner {
+                held: surface.held[vertex],
+                influences,
+                share,
+            });
+        }
