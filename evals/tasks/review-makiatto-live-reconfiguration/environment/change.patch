+
+#[derive(Default)]
+pub struct CompiledComponentCache {
+    entries: HashMap<ComponentKey, Arc<Module>>,
+}
+
+impl CompiledComponentCache {
+    fn get(
+        &mut self,
+        engine: &Engine,
+        config: &TransformConfig,
+        bytes: &[u8],
+    ) -> Result<Arc<Module>, TransformError> {
+        let key = ComponentKey {
+            wasm_path: config.wasm_path.clone(),
+            wasm_bytes_digest: input_digest(bytes),
+        };
+        if let Some(module) = self.entries.get(&key) {
+            return Ok(Arc::clone(module));
+        }
+        let module = Arc::new(Module::new(engine, bytes)?);
+        self.entries.insert(key, Arc::clone(&module));
+        Ok(module)
+    }
+}
+
+#[derive(Default)]
+pub struct TransformResultCache {
+    entries: HashMap<ResultKey, Vec<u8>>,
+}
+
 pub struct Transforms {
     engine: Engine,
+    components: CompiledComponentCache,
+    results: TransformResultCache,
 }
 
