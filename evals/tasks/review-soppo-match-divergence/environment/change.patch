diff --git a/tests/match_flow.rs b/tests/match_flow.rs
new file mode 100644
index 0000000..7e8271c
--- /dev/null
+++ b/tests/match_flow.rs
@@ -0,0 +1,30 @@
+//! Match-flow checks on parsed functions and generated return values.
+
+use proptest::prelude::*;
+use soppo::ast::{Expr, GateVariant, MatchArm, TypedStmtKind};
+use soppo::{infer, parser};
+
+#[test]
+fn guarded_match_flow_agrees_with_the_statement_classification() {
+    let function = parser::parse(
+        "fn choose(gate: Gate, flag: bool) -> int {
+            match gate { Open if flag => { return 1; }, Closed => { return 2; } }
+        }",
+    )
+    .unwrap();
+    let expected = infer::stmt_diverges(&function.body[0]);
+    assert_eq!(infer::check_function(&function).diverges, expected);
+}
+
+proptest! {
+    #[test]
+    fn returning_every_variant_is_independent_of_the_returned_integer(value in any::<i32>()) {
+        let arms = GateVariant::ALL.into_iter().map(|variant| MatchArm {
+            variant,
+            guard: None,
+            body: vec![TypedStmtKind::Return(Expr::Integer(i64::from(value)))],
+        }).collect();
+        let statement = TypedStmtKind::Match { scrutinee: "gate".into(), arms };
+        prop_assert!(infer::stmt_diverges(&statement));
+    }
+}
