+
+#[test]
+fn exhaustive_match_returns_from_the_function() {
+    let report = check_source(
+        "fn choose(gate: Gate) -> int {
+            match gate { Open => { return 1; }, Closed => { return 2; } }
+        }",
+    )
+    .unwrap();
+    assert!(report.diverges);
+    assert!(report.diagnostics.is_empty());
+}
+
+#[test]
+fn exhaustive_returning_match_narrows_the_nil_branch() {
+    let report = check_source(
+        "fn size(value: Text?, gate: Gate) -> int {
+            if value is nil { match gate { Open => { return 0; }, Closed => { return 0; } } }
+            return value.length;
+        }",
+    )
+    .unwrap();
+    assert!(report.diagnostics.is_empty());
+}
