-        printf "    ip6 daddr %s tcp dport 53 %s\n", ns, action
+# A recursive resolver forwards whatever name it is asked, so a query is itself
+# a way out. Every DNS packet is checked before any other rule, NAT included,
+# so Docker's embedded resolver at a local address, and the port Docker
+# rewrites its queries to, get no exemption. A query passes only when it goes
+# over UDP to a nameserver in resolv.conf and asks one A or AAAA question in
+# class IN for a name the allowlist holds exactly, matched without regard to
+# case, with only the RD and AD flags, no answer or authority records, and at
+# most a bare EDNS record; anything else to port 53, or to a nameserver on any
+# other port, is refused. The ID, letter case, those flags, A or AAAA and the
+# EDNS fields stay the caller's and are not normalised, so a few bits a query
+# still reach the resolver. A wildcard entry gets no name resolution.
+nameservers() {
+  awk '/^nameserver[[:space:]]+/ { ns = $2; sub(/%.*/, "", ns); print ns }' /etc/resolv.conf
+}
+
+address_family() {
+  case "$1" in
+    *:*) echo ip6 ;;
+    *) echo ip ;;
+  esac
+}
+
+# The name in wire form as masked matches, so that letters match in either
+# case: a letter's mask clears the bit that tells the cases apart. A raw
+# payload match takes at most 16 bytes, so the name is matched in pieces,
+# starting after the 8-byte UDP header and the 12-byte DNS header.
+qname_match() {
+  printf '%s.' "$1" | od -An -tu1 -v | awk '
+    { for (i = 1; i <= NF; i++) bytes[n++] = $i }
+    END {
+      count = 0
+      start = 0
+      for (i = 0; i < n; i++) {
+        if (bytes[i] != 46) continue
+        mask[count] = 255; value[count++] = i - start
+        for (k = start; k < i; k++) {
+          b = bytes[k]
+          letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
+          mask[count] = letter ? 223 : 255
+          value[count++] = (letter && b >= 97) ? b - 32 : b
+        }
+        start = i + 1
       }
-    }
-  ' /etc/resolv.conf
+      mask[count] = 255; value[count++] = 0
+      for (p = 0; p < count; p += 16) {
+        m = ""; v = ""
+        for (k = p; k < count && k < p + 16; k++) { m = m sprintf("%02x", mask[k]); v = v sprintf("%02x", value[k]) }
+        printf " @th,%d,%d & 0x%s == 0x%s", 160 + p * 8, (k - p) * 8, m, v
+      }
+    }'
+}
+
+nft_dns_rules() {
+  while IFS= read -r host; do
+    case "$host" in
+      ''|'*'*|*/*|*:*) continue ;;
+    esac
+    printf '%s' "$host" | grep -Eq '^[0-9.]+$' && continue
+    name=$(qname_match "$host")
+    # The question's type and class follow the name, whose wire form is two bytes
+    # longer than the host name.
+    after=$((160 + (${#host} + 2) * 8))
+    base=$((8 + 12 + ${#host} + 2 + 4))
+    header="@th,80,16 & 0xfedf == 0 @th,96,16 1 @th,112,16 0 @th,128,16 0"
+    for ns in $(nameservers); do
+      family=$(address_family "$ns")
+      for qtype in 1 28; do
+        question="$name @th,$after,16 $qtype @th,$((after + 16)),16 1"
+        printf '    %s daddr %s udp dport 53 udp length %s %s @th,144,16 0 %s accept\n' \
+          "$family" "$ns" "$base" "$header" "$question"
+        # A bare EDNS record: the root name, type OPT, and no option data.
+        opt="@th,$((after + 32)),8 0 @th,$((after + 40)),16 41 @th,$((after + 104)),16 0"
+        printf '    %s daddr %s udp dport 53 udp length %s %s @th,144,16 1 %s %s accept\n' \
+          "$family" "$ns" $((base + 11)) "$header" "$question" "$opt"
+      done
+    done
+  done < "$ALLOWLIST"
+}
+
+nft_resolver_rules() {
+  for ns in $(nameservers); do
+    printf '    %s daddr %s udp dport 53 accept\n' "$(address_family "$ns")" "$ns"
+  done
+}
+
+nft_resolver_refusals() {
+  for ns in $(nameservers); do
+    printf '    %s daddr %s reject\n' "$(address_family "$ns")" "$ns"
+  done
 }
 
